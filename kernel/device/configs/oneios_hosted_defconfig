# Kernel configuration of the OneiOS guest (arm64e, xnu-12377). CONFIG_XNU_<NAME> becomes XNU_<NAME> for the build.
# The fragments of the arm64e and iOS 27 profiles come first (board.toml [kernel] config_fragments).
CONFIG_XNU_BUILD_ARCHIVES=y
CONFIG_XNU_SOURCE_CORECRYPTO14=y
CONFIG_XNU_SOURCE_PTHREAD=y
CONFIG_XNU_ARM_DT_PLATFORM=y
CONFIG_XNU_ARMCPU=y
CONFIG_XNU_NATIVE_ARCH_TIMER=y
CONFIG_XNU_NATIVE_PAN=y
# As the DroidVM iPadOS 27 board: xnu-12377's OSKext starts the original corecrypto through the source provider's
# entry, which exists only in source mode.
CONFIG_XNU_CRYPTO_BOOTSTRAP="source"
CONFIG_XNU_NATIVE_CS_HASH_CACHE=y
# The kernel collection of 24A446 is an MH_FILESET; XnuPrelink's fileset emitter links this kernel into it.
CONFIG_XNU_KERNEL_CHAINED_FIXUPS=y
CONFIG_XNU_ARMVIRT_PLATFORM=n
CONFIG_XNU_NATIVE_UFS=n
CONFIG_XNU_NATIVE_ADRENO=n
CONFIG_XNU_BOOT_PROGRESS=n
# The board's archives (scripts/build-oneios-board.py), started by oneios_board_late_start.
CONFIG_XNU_EXTRA_LD_ARCHIVES="-Wl,-force_load,{tree}/build/oneios-drivers/liboneiosdrivers.a -Wl,-force_load,{tree}/build/oneios-board/liboneiosboard.a"
# The hosted machine layer: XNU as a process under xnuhost (kernel/patches/oneios-hosted, kernel/build-hosted.sh).
CONFIG_XNU_HOSTED=y
