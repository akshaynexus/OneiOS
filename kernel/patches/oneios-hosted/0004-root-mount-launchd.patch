+#if XNU_HOSTED
+/*
+ * OneiOS: mkdir, symlink and unlink by kernel paths, for the Data volume's first start, which unpacks the image
+ * set's seed in the kernel before launchd (bsd/kern/oneios_hosted_root.c).
+ */
+int oneios_kern_mkdir(const char *path, int mode, vfs_context_t ctx);
+int oneios_kern_symlink(const char *target, const char *path, vfs_context_t ctx);
+int oneios_kern_unlink(const char *path, vfs_context_t ctx);
+
+int
+oneios_kern_mkdir(const char *path, int mode, vfs_context_t ctx)
+{
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & ACCESSPERMS);
+	return mkdir1at(ctx, CAST_USER_ADDR_T(path), &va, AT_FDCWD, UIO_SYSSPACE);
+}
+
+int
+oneios_kern_symlink(const char *target, const char *path, vfs_context_t ctx)
+{
+	return symlinkat_internal(ctx, CAST_USER_ADDR_T(target), AT_FDCWD, CAST_USER_ADDR_T(path), UIO_SYSSPACE);
+}
+
+int
+oneios_kern_unlink(const char *path, vfs_context_t ctx)
+{
+	return unlink1(ctx, NULLVP, CAST_USER_ADDR_T(path), UIO_SYSSPACE, 0);
+}
+#endif /* XNU_HOSTED */
diff --git a/osfmk/arm64/hosted/hosted_blk.c b/osfmk/arm64/hosted/hosted_blk.c
new file mode 100644
index 0000000..519cdc0
--- /dev/null
+++ b/osfmk/arm64/hosted/hosted_blk.c
@@ -0,0 +1,31 @@
+/*
+ * OneiOS: a device register of xnuhost's board read or written through the mmio_read / mmio_write host calls,
+ * for a driver that would otherwise take a fault per access on a mapped device page (the disks:
+ * kernel/patches/oneios-hosted/storage/OneiOSHostedDisk.cpp). Host calls are made masked (hosted.h).
+ */
+#include <stdint.h>
+#include <arm64/hosted/hosted.h>
+
+#if XNU_HOSTED
+
+uint32_t oneios_hosted_mmio_read32(uint64_t physical);
+void oneios_hosted_mmio_write32(uint64_t physical, uint32_t value);
+
+uint32_t
+oneios_hosted_mmio_read32(uint64_t physical)
+{
+	uint32_t old = hosted_irq_mask();
+	uint32_t value = (uint32_t)hosted_hc(HOSTED_FN(mmio_read), hosted_cpu(), physical, 4, 0, 0, 0);
+	hosted_irq_restore(old);
+	return value;
+}
+
+void
+oneios_hosted_mmio_write32(uint64_t physical, uint32_t value)
+{
+	uint32_t old = hosted_irq_mask();
+	(void)hosted_hc(HOSTED_FN(mmio_write), hosted_cpu(), physical, 4, value, 0, 0);
+	hosted_irq_restore(old);
+}
+
+#endif /* XNU_HOSTED */
