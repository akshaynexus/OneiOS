diff --git a/bsd/kern/kern_exec.c b/bsd/kern/kern_exec.c
--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -8936,6 +8936,115 @@
 	}
 	if (changed) {
 		error = native_gpu_addon_write(path, (const uint8_t *)text, length, 0644, ctx);
+		if (error > 0) {
+			printf("oneios-jobs: %s not written (%d)\n", path, error);
+		}
+	}
+	kfree_data(text, cap);
+}
+#endif /* XNU_HOSTED */
+#if XNU_HOSTED
+/*
+ * OneiOS hosted (0053): launchd jobs disabled in the Data store's disabled.plist before launchd, for a Data store made
+ * from a seed whose daemon policy did not disable them yet (the roottweak's daemons.toml does, in new seeds); the
+ * counterpart of 0044. The list is oneios-disable-jobs=LABEL[,LABEL...] (default com.apple.accessibility.axassetsd;
+ * "-" for none). An entry <false/> becomes <true/>, a missing one is added after the top <dict>, a missing file is
+ * written with only these (root, 0644, as launchd wants it). One line per label:
+ *   oneios-jobs: com.apple.accessibility.axassetsd: disabled in disabled.plist (it was not)    or: disabled there already
+ * Why axassetsd: it enumerates the speech synthesis audio units (TextToSpeech's fetchExtensions for
+ * com.apple.AudioUnit-Speech) at load and on each com.apple.coreaudio.components.changed and
+ * LaunchServices.ApplicationsChanged. SiriAUSP, MacinTalkAUSP, MauiAUSP and KonaSynthesizer were started together and
+ * each was killed 3-4 s later while still in dyld (EXC_CRASH, SIGKILL, code 0x9000000), every 8-10 s for about 50 s
+ * (phone, 2026-11-12 14:12); the four corpses at a time filled the kernel's corpse limit, so a later crash had no report.
+ */
+static void
+oneios_jobs_disable(void)
+{
+	static const char path[] = "/private/var/db/com.apple.xpc.launchd/disabled.plist";
+	static const char empty[] = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
+	    "<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n"
+	    "<plist version=\"1.0\">\n<dict>\n</dict>\n</plist>\n";
+	char labels[256] = "com.apple.accessibility.axassetsd";
+	vfs_context_t ctx = vfs_context_current();
+	(void)PE_parse_boot_argn("oneios-disable-jobs", labels, sizeof(labels));
+	if (labels[0] == 0 || !strcmp(labels, "-")) {
+		return;
+	}
+	const size_t cap = 256 * 1024;
+	char *text = kalloc_data(cap, Z_WAITOK | Z_ZERO);
+	if (text == NULL) {
+		return;
+	}
+	size_t length = 0;
+	vnode_t vp = NULLVP;
+	if (vnode_open(path, FREAD | O_NOFOLLOW, 0, 0, &vp, ctx) == 0) {
+		off_t size = -1;
+		int resid = 0;
+		(void)vnode_size(vp, &size, ctx);
+		int error = size <= 0 || (size_t)size >= cap / 2 ? EFBIG : vn_rdwr(UIO_READ, vp, (caddr_t)text, (int)size, 0,
+		    UIO_SYSSPACE, IO_NOAUTH, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		vnode_close(vp, FREAD, ctx);
+		if (error || resid) {
+			printf("oneios-jobs: %s not read (%d): nothing disabled\n", path, error ? error : EIO);
+			kfree_data(text, cap);
+			return;
+		}
+		length = (size_t)size;
+	} else {
+		length = strlcpy(text, empty, cap);
+	}
+	if (length >= 6 && !strncmp(text, "bplist", 6)) {
+		printf("oneios-jobs: %s is a binary plist: nothing disabled\n", path);
+		kfree_data(text, cap);
+		return;
+	}
+	bool changed = false;
+	for (char *label = labels; *label;) {
+		char *end = label;
+		while (*end && *end != ',') {
+			end++;
+		}
+		char saved = *end;
+		*end = 0;
+		char key[160];
+		snprintf(key, sizeof(key), "<key>%s</key>", label);
+		size_t add = strlen(key) + 11;          /* "\n\t" key "\n\t<true/>" */
+		char *at = strnstr(text, key, length);
+		char *top = strnstr(text, "<plist", length);
+		top = top ? strnstr(top, "<dict>", length - (size_t)(top - text)) : NULL;
+		const char *said = "disabled there already";
+		if (at != NULL) {
+			char *value = at + strlen(key);
+			while (value < text + length && (*value == ' ' || *value == '\t' || *value == '\n' || *value == '\r')) {
+				value++;
+			}
+			if (value + 8 <= text + length && !strncmp(value, "<false/>", 8)) {
+				memcpy(value, "<true/>", 7);
+				memmove(value + 7, value + 8, (size_t)(text + length - (value + 8)));
+				length--;
+				changed = true;
+				said = "disabled in disabled.plist (it was enabled there)";
+			} else if (!(value + 7 <= text + length && !strncmp(value, "<true/>", 7))) {
+				said = "its entry there is not <true/> or <false/>: left alone";
+			}
+		} else if (top == NULL || length + add >= cap) {
+			said = "no top dictionary there: left alone";
+		} else {
+			char *in = top + strlen("<dict>");
+			memmove(in + add, in, (size_t)(text + length - in));
+			char first = in[add];                   /* snprintf's NUL lands on it */
+			snprintf(in, add + 1, "\n\t%s\n\t<true/>", key);
+			in[add] = first;
+			length += add;
+			changed = true;
+			said = "disabled in disabled.plist (it was not)";
+		}
+		printf("oneios-jobs: %s: %s\n", label, said);
+		*end = saved;
+		label = saved ? end + 1 : end;
+	}
+	if (changed) {
+		int error = native_gpu_addon_write(path, (const uint8_t *)text, length, 0644, ctx);
 		if (error > 0) {
 			printf("oneios-jobs: %s not written (%d)\n", path, error);
 		}
@@ -9279,6 +9388,7 @@
 	oneios_lsd_first_boot_done(p, scratch);       /* 0037 */
 	oneios_jobs_enable();                         /* 0044 */
 	oneios_feature_flags_off(p, scratch);         /* 0048 */
+	oneios_jobs_disable();                        /* 0053 */
 #endif
 }
 
