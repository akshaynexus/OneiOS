+/*
+ * 0045: a TLB lock per user pmap. The global lock above ordered every task's fills, flushes and copies against each
+ * other, held across task orders of about 30 us on the phone: on the first combined boot it was waited for up to
+ * 1.5 vCPUs' worth of time. What the lock orders is per address space: a fill of pmap P reads P's entry and maps it in
+ * P's task, a flush of P unmaps in P's task, a copy reads P's entry and touches the page; nothing of one task's host
+ * mapping depends on another's. So each user pmap has its own word (pmap->hosted_tlb_word), taken the same way (spin,
+ * interrupts masked). The kernel pmap keeps the global word. A flush of a nested pmap (the shared region) or of the
+ * commpage, which is part of every task that uses it, takes each user pmap's word in turn, under pmaps_lock, which
+ * keeps the list. Lock order: pmap_lock (shared) -> the pmap's TLB word; pmaps_lock -> a user pmap's TLB word.
+ */
+static struct {
+	uint64_t taken, contended, wait_ticks;
+} hosted_utlb_stats;                            /* atomically added: the words differ, the counters are shared */
+
+static inline uint32_t
+hosted_utlb_lock(pmap_t pmap)
+{
+	uint32_t old = hosted_irq_mask();
+	if (__improbable(!__sync_bool_compare_and_swap(&pmap->hosted_tlb_word, 0, 1))) {
+		uint64_t began = __builtin_arm_rsr64("CNTVCT_EL0");
+		while (!__sync_bool_compare_and_swap(&pmap->hosted_tlb_word, 0, 1)) {
+			__builtin_arm_yield();
+		}
+		os_atomic_inc(&hosted_utlb_stats.contended, relaxed);
+		os_atomic_add(&hosted_utlb_stats.wait_ticks, __builtin_arm_rsr64("CNTVCT_EL0") - began, relaxed);
+	}
+	os_atomic_inc(&hosted_utlb_stats.taken, relaxed);
+	return old;
+}
+
+static inline void
+hosted_utlb_unlock(pmap_t pmap, uint32_t old)
+{
+	__sync_lock_release(&pmap->hosted_tlb_word);
+	hosted_irq_restore(old);
+}
+
+/* 0045: the nested region's 32 MiB blocks a user pmap filled pages in (pmap->hosted_nested_seen). Its TLB word held. */
+#define HOSTED_NESTED_BLOCK_SHIFT 25
+#define HOSTED_NESTED_BITS        512
+static inline void
+hosted_nested_mark(pmap_t pmap, uint64_t va)
+{
+	pmap_t nested = pmap->nested_pmap;
+	if (nested == NULL || va < nested->nested_region_addr || va - nested->nested_region_addr >= nested->nested_region_size) {
+		return;
+	}
+	uint64_t bit = (va - nested->nested_region_addr) >> HOSTED_NESTED_BLOCK_SHIFT;
+	if (bit >= HOSTED_NESTED_BITS - 1) {
+		bit = HOSTED_NESTED_BITS - 1;
+	}
+	pmap->hosted_nested_seen[bit / 64] |= 1ULL << (bit % 64);
+}
+
+/* Whether the user pmap may have host mappings in [va, end) of its nested region. Its TLB word held. */
+static inline bool
+hosted_nested_seen(pmap_t pmap, pmap_t nested, uint64_t va, uint64_t end)
+{
+	const uint64_t *seen = pmap->hosted_nested_seen;
+	if (seen[(HOSTED_NESTED_BITS - 1) / 64] >> ((HOSTED_NESTED_BITS - 1) % 64) & 1) {
+		return true;
+	}
+	if (end <= nested->nested_region_addr || va >= nested->nested_region_addr + nested->nested_region_size) {
+		return true;            /* not in the region the bits describe: no claim */
+	}
+	uint64_t first = va > nested->nested_region_addr ? (va - nested->nested_region_addr) >> HOSTED_NESTED_BLOCK_SHIFT : 0;
+	uint64_t last = (end - 1 - nested->nested_region_addr) >> HOSTED_NESTED_BLOCK_SHIFT;
+	if (last >= HOSTED_NESTED_BITS - 1) {
+		last = HOSTED_NESTED_BITS - 2;
+	}
+	for (uint64_t bit = first; bit <= last; bit++) {
+		if (seen[bit / 64] >> (bit % 64) & 1) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* 0045: where the user unmaps come from: a flush of the task's own pmap, a flush of the shared region or commpage
+ * sent to it, and the tasks such a flush skipped because they never filled in that range. */
+static struct {
+	uint64_t own, fanned, nested_flushes, skipped;
+} hosted_unmap_stats;
