diff --git a/osfmk/arm64/hosted/hosted_machine.c b/osfmk/arm64/hosted/hosted_machine.c
--- a/osfmk/arm64/hosted/hosted_machine.c
+++ b/osfmk/arm64/hosted/hosted_machine.c
@@ -508,4 +508,17 @@
 	hosted_interrupt(state);
 }
 
+/*
+ * The calendar: seconds since 1970 from the host's clock (the wall_time host call). The hosted board has no RTC
+ * device; this is what IOPlatformExpert::getGMTTimeOfDay answers.
+ */
+uint64_t
+hosted_wall_time(void)
+{
+	uint32_t old = hosted_irq_mask();
+	uint64_t seconds = (uint64_t)HC(wall_time);
+	hosted_irq_restore(old);
+	return seconds;
+}
+
 #endif /* XNU_HOSTED */
