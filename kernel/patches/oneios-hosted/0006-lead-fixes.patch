diff --git a/iokit/Kernel/IOPlatformExpert.cpp b/iokit/Kernel/IOPlatformExpert.cpp
--- a/iokit/Kernel/IOPlatformExpert.cpp
+++ b/iokit/Kernel/IOPlatformExpert.cpp
@@ -390,9 +390,17 @@
 #endif
 }
 
+#if XNU_HOSTED
+extern "C" uint64_t hosted_wall_time(void);
+#endif
+
 long
 IOPlatformExpert::getGMTTimeOfDay(void)
 {
+#if XNU_HOSTED
+	/* OneiOS hosted: the host's clock is the board's real-time clock (the calendar started at 1970 without it). */
+	return (long)hosted_wall_time();
+#endif
 	return 0;
 }
 
diff --git a/iokit/Kernel/IOStartIOKit.cpp b/iokit/Kernel/IOStartIOKit.cpp
--- a/iokit/Kernel/IOStartIOKit.cpp
+++ b/iokit/Kernel/IOStartIOKit.cpp
@@ -77,8 +77,17 @@
 	t.tv_sec = 30;
 	t.tv_nsec = 0;
 
+#if XNU_HOSTED
+	/*
+	 * OneiOS hosted: no driver publishes IORTC (the clock is xnuhost's wall_time, read by
+	 * IOPlatformExpert::getGMTTimeOfDay, and is there from the start), so this wait only ever ran out: 30 s of
+	 * every boot with all CPUs idle.
+	 */
+	(void)t;
+#else
 	IOService::waitForService(
 		IOService::resourceMatching("IORTC"), &t );
+#endif
 #if defined(__i386__) || defined(__x86_64__)
 	IOService::waitForService(
 		IOService::resourceMatching("IONVRAM"), &t );
