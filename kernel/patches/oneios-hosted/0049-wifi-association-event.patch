diff --git a/bsd/kern/kern_event.c b/bsd/kern/kern_event.c
--- a/bsd/kern/kern_event.c
+++ b/bsd/kern/kern_event.c
@@ -8913,21 +8913,35 @@
 #endif /* SKYWALK && XNU_TARGET_OS_OSX */
 
 	/* Verify the message is small enough to fit in one mbuf w/o cluster */
+#if XNU_HOSTED
+	/*
+	 * OneiOS (0049): an IEEE 802.11 event of Apple's may fill an mbuf cluster. iOS 27's association event
+	 * (APPLE80211_M_ASSOC_DONE) carries a 540-byte record that wifid reads (ten access point records, the
+	 * join's result at 0x214, its validity at 0x218), and an mbuf alone holds MLEN bytes, fewer than that: the post
+	 * returned EMSGSIZE, wifid never learned that the join was done and Settings stayed at "connecting" (the
+	 * phone, 2026-11-12). On Apple's hardware this event goes through IO80211Family's user client, which this
+	 * kernel's Wi-Fi driver (kernel/patches/oneios-hosted/net) does not have: its events are these kernel
+	 * events. After UniXNU-sheng's sheng-wifi-association-event.patch. Every other event keeps the limit.
+	 */
+	const u_int32_t kev_maximum = event_msg->vendor_code == KEV_VENDOR_APPLE &&
+	    event_msg->kev_class == KEV_IEEE80211_CLASS ? MCLBYTES : MLEN;
+#else /* !XNU_HOSTED */
+	const u_int32_t kev_maximum = MLEN;
+#endif /* !XNU_HOSTED */
 	total_size = KEV_MSG_HEADER_SIZE;
 
 	for (i = 0; i < 5; i++) {
 		if (event_msg->dv[i].data_length == 0) {
 			break;
 		}
+		if (event_msg->dv[i].data_length > kev_maximum - total_size) {
+			os_atomic_inc(&kevtstat.kes_toobig, relaxed);
+			return EMSGSIZE;
+		}
 		total_size += event_msg->dv[i].data_length;
-	}
-
-	if (total_size > MLEN) {
-		os_atomic_inc(&kevtstat.kes_toobig, relaxed);
-		return EMSGSIZE;
 	}
 
-	m = m_get(wait, MT_DATA);
+	m = total_size > MLEN ? m_getcl(wait, MT_DATA, 0) : m_get(wait, MT_DATA);
 	if (m == 0) {
 		os_atomic_inc(&kevtstat.kes_nomem, relaxed);
 		return ENOMEM;
