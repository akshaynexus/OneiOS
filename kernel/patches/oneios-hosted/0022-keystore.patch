diff --git a/bsd/vfs/kpi_vfs.c b/bsd/vfs/kpi_vfs.c
index 0e222bf..b7d0b0e 100644
--- a/bsd/vfs/kpi_vfs.c
+++ b/bsd/vfs/kpi_vfs.c
@@ -3756,7 +3756,18 @@ native_dataprotect_emulated(vnode_t vp)
 	static int enabled = -1;
 	if (enabled < 0) {
 		uint32_t value = 0;
+#if XNU_HOSTED
+		/*
+		 * OneiOS hosted (0022-keystore.patch): on unless owner-dataprotect=0. The Data volume is always an
+		 * unencrypted APFS volume here (no Secure Enclave, the software key store of
+		 * kernel/patches/oneios-hosted/keystore), so a file's protection class is only ever this attribute.
+		 */
+		value = 1;
+		PE_parse_boot_argn("owner-dataprotect", &value, sizeof(value));
+		enabled = value == 1;
+#else
 		enabled = PE_parse_boot_argn("owner-dataprotect", &value, sizeof(value)) && value == 1;
+#endif /* XNU_HOSTED */
 	}
 	mount_t mp = vnode_mount(vp);
 	return enabled && mp != NULL && !(vfs_flags(mp) & MNT_CPROTECT) && !vfs_isrdonly(mp) &&
diff --git a/osfmk/arm64/oneios_host.c b/osfmk/arm64/oneios_host.c
index c0eabd8..bb0f002 100644
--- a/osfmk/arm64/oneios_host.c
+++ b/osfmk/arm64/oneios_host.c
@@ -55,6 +55,18 @@ __attribute__((weak)) void
 oneios_software_aes_start(void)
 {
 }
+
+/*
+ * The key store (0022-keystore.patch): the phone has no Secure Enclave and AppleSEPKeyStore is left out of the
+ * kernel collection, so launchd finds no AppleKeyStore service and MobileKeyBag cannot load a system keybag.
+ * UniXNU's AppleKeyStoreState with OneiOS's class keys and key wrap in software
+ * (kernel/patches/oneios-hosted/keystore: OneiOSKeyStore.cpp and build-oneios-keystore.py, an archive that
+ * kernel/build-hosted.sh adds to the link). Not a security boundary. Weak, as the others.
+ */
+__attribute__((weak)) void
+oneios_keystore_start(void)
+{
+}
 #endif /* XNU_HOSTED */
 
 void oneios_board_late_start(void);
@@ -73,6 +85,8 @@ oneios_board_late_start(void)
 	 * clients and the root mount do not wait for it.
 	 */
 	oneios_gpu3d_start();
+	/* before the first user process: launchd looks the AppleKeyStore service up in its early boot tasks */
+	oneios_keystore_start();
 #endif /* XNU_HOSTED */
 }
 
