diff --git a/osfmk/arm64/hosted/hosted_pmap.h b/osfmk/arm64/hosted/hosted_pmap.h
new file mode 100644
index 0000000..80207a3
--- /dev/null
+++ b/osfmk/arm64/hosted/hosted_pmap.h
@@ -0,0 +1,417 @@
+/*
+ * OneiOS: the hosted pmap (arm64/hosted/hosted.h explains the model). Included at the end of
+ * osfmk/arm/pmap/pmap.c, so it sees the pmap's own types and helpers; it is not a header for anybody else.
+ *
+ * The arm64 pmap is kept whole: its page tables are the truth about every address space, and they are plain
+ * memory in the RAM window. What is missing under xnuhost is the MMU that would read them. Its place is
+ * taken by the host's mappings, used as a TLB:
+ *
+ *   fill    a fault (user: XH_TRAP_FAULT from thread_run; kernel: the exception upcall) first walks the
+ *           page table. If the entry allows the access, the page is mapped in the host (task_map for an iOS
+ *           task, kernel_map for the kernel's own range) and the faulting instruction runs again. Only a
+ *           fault the tables do not allow reaches XNU's fault handlers.
+ *   flush   every TLB invalidation of the pmap (flush_mmu_tlb_region_asid_async and friends) unmaps the
+ *           range in the host, so the next access faults and is filled from the changed tables.
+ *
+ * One lock orders the two: a fill reads the entry and maps under it, a flush unmaps under it. The pmap
+ * always changes an entry before it flushes, so a fill either runs before the unmap (and is undone by it)
+ * or after the change (and sees it).
+ *
+ * The kernel's own range is also filled eagerly when an entry is made (hosted_kernel_enter): a kernel stack
+ * must be mapped before it is used, because xnuhost writes the interrupted frame onto the interrupted stack.
+ */
+#if XNU_HOSTED
+
+#include <arm64/hosted/hosted.h>
+
+#define HPC(name, a1, a2, a3, a4, a5) \
+	hosted_hc(HOSTED_FN(name), hosted_cpu(), (uint64_t)(a1), (uint64_t)(a2), (uint64_t)(a3), (uint64_t)(a4), (uint64_t)(a5))
+
+uint64_t hosted_kva_base, hosted_kva_end;
+
+static uint32_t hosted_tlb_lock_word;
+static uint64_t hosted_task_sequence;
+
+struct hosted_pmap_stats {
+	uint64_t kernel_maps, kernel_unmaps, user_maps, user_unmaps, tasks_created, tasks_destroyed;
+} hosted_pmap_stats;
+
+static inline uint32_t
+hosted_tlb_lock(void)
+{
+	uint32_t old = hosted_irq_mask();
+	while (!__sync_bool_compare_and_swap(&hosted_tlb_lock_word, 0, 1)) {
+		__builtin_arm_yield();
+	}
+	return old;
+}
+
+static inline void
+hosted_tlb_unlock(uint32_t old)
+{
+	__sync_lock_release(&hosted_tlb_lock_word);
+	hosted_irq_restore(old);
+}
+
+/*
+ * The leaf entry of va, or 0. Lock-free: for the kernel pmap (its tables are never freed) or with the pmap's
+ * lock held. A block entry is returned as a page entry of the block's attributes.
+ */
+static pt_entry_t
+hosted_walk(pmap_t pmap, uint64_t va)
+{
+	const pt_attr_t * const pt_attr = pmap_get_pt_attr(pmap);
+	tt_entry_t *table = pmap->tte;
+	tt_entry_t  tte;
+
+	if (table == NULL || va < pmap->min || va >= pmap->max) {
+		return 0;
+	}
+	for (unsigned int level = pt_attr_root_level(pt_attr); level < pt_attr_leaf_level(pt_attr); level++) {
+		tte = table[ttn_index(pt_attr, va, level)];
+		if (!(tte & ARM_TTE_VALID)) {
+			return 0;
+		}
+		if ((tte & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_BLOCK) {
+			uint64_t span = pt_attr_ln_size(pt_attr, level);
+			return ((tte & ARM_TTE_TABLE_MASK & ~(span - 1)) | (va & (span - 1) & ~(uint64_t)ARM_PGMASK)) |
+			       (tte & ~ARM_PTE_PAGE_MASK) | ARM_PTE_TYPE_VALID;
+		}
+		table = (tt_entry_t *)phystokv(tte & ARM_TTE_TABLE_MASK);
+	}
+	return table[ttn_index(pt_attr, va, pt_attr_leaf_level(pt_attr))];
+}
+
+/* What a valid entry lets its address space do, as XH_PROT_* bits; 0 if it lets it do nothing right now. */
+static uint32_t
+hosted_pte_prot(pt_entry_t pte, bool user)
+{
+	uint32_t prot = 0;
+	unsigned ap = (unsigned)((pte & ARM_PTE_APMASK) >> 6);
+
+	if ((pte & ARM_PTE_TYPE_MASK) != ARM_PTE_TYPE_VALID || !(pte & ARM_PTE_AF)) {
+		return 0;       /* invalid, or waiting for its reference fault */
+	}
+	if (user) {
+		if (ap == AP_RWRW) {
+			prot = XH_PROT_READ | XH_PROT_WRITE;
+		} else if (ap == AP_RORO) {
+			prot = XH_PROT_READ;
+		}
+		if (!(pte & ARM_PTE_NX)) {
+			prot |= XH_PROT_EXEC;
+		}
+	} else {
+		prot = XH_PROT_READ;
+		if (ap == AP_RWNA || ap == AP_RWRW) {
+			prot |= XH_PROT_WRITE;
+		}
+		if (!(pte & ARM_PTE_PNX)) {
+			prot |= XH_PROT_EXEC;
+		}
+	}
+	return prot;
+}
+
+static inline bool
+hosted_pa_in_window(pmap_paddr_t pa)
+{
+	return pa >= hosted_info.ram_phys && pa - hosted_info.ram_phys < hosted_info.ram_size;
+}
+
+/* mmu_kvtop: what the address translation instruction would say, for the part that needs no page table. */
+uint64_t hosted_mmu_kvtop(uint64_t va);
+uint64_t
+hosted_mmu_kvtop(uint64_t va)
+{
+	va = VM_KERNEL_STRIP_PTR(va);
+	if (va >= gVirtBase && va - gVirtBase < gPhysSize) {
+		return va;                      /* the window is its own physical address */
+	}
+	if (va >= hosted_info.io_virt && va - hosted_info.io_virt < hosted_info.io_size) {
+		return hosted_info.io_phys + (va - hosted_info.io_virt);
+	}
+	return 0;                               /* the caller walks the kernel's page tables */
+}
+
+/* ---- the kernel's own range ---------------------------------------------------------------- */
+
+/* Maps what the tables say about [va, va + size) of the kernel's range. TLB lock held. Returns pages mapped. */
+static unsigned
+hosted_kernel_map_locked(uint64_t va, uint64_t size, uint32_t need)
+{
+	unsigned mapped = 0;
+	uint64_t run_va = 0, run_pa = 0, run_size = 0;
+	uint32_t run_prot = 0;
+
+	for (uint64_t at = va; at < va + size; at += ARM_PGBYTES) {
+		pt_entry_t pte = hosted_walk(kernel_pmap, at);
+		uint32_t prot = hosted_pte_prot(pte, false);
+		pmap_paddr_t pa = pte_to_pa(pte);
+
+		if (prot == 0 || (need & ~prot) || !hosted_pa_in_window(pa)) {
+			prot = 0;
+		}
+		if (prot != 0 && run_size != 0 && prot == run_prot && pa == run_pa + run_size) {
+			run_size += ARM_PGBYTES;
+			continue;
+		}
+		if (run_size != 0) {
+			if (HPC(kernel_map, run_va, run_size, run_prot, run_pa, 0) == 0) {
+				mapped += (unsigned)(run_size >> ARM_PGSHIFT);
+			}
+			run_size = 0;
+		}
+		if (prot != 0) {
+			run_va = at;
+			run_pa = pa;
+			run_size = ARM_PGBYTES;
+			run_prot = prot;
+		}
+	}
+	if (run_size != 0 && HPC(kernel_map, run_va, run_size, run_prot, run_pa, 0) == 0) {
+		mapped += (unsigned)(run_size >> ARM_PGSHIFT);
+	}
+	hosted_pmap_stats.kernel_maps += mapped;
+	return mapped;
+}
+
+/* A kernel fault at va: fill it from the tables if they allow `access`. Any context; called masked. */
+bool
+hosted_kernel_fill(uint64_t va, uint32_t access)
+{
+	bool filled;
+
+	va = VM_KERNEL_STRIP_PTR(va) & ~(uint64_t)ARM_PGMASK;
+	if (va < hosted_kva_base || va >= hosted_kva_end || kernel_pmap->tte == NULL) {
+		return false;
+	}
+	uint32_t old = hosted_tlb_lock();
+	filled = hosted_kernel_map_locked(va, ARM_PGBYTES, access) != 0;
+	hosted_tlb_unlock(old);
+	return filled;
+}
+
+/* The kernel pmap just made entries for [va, va + size): map them now. */
+void
+hosted_kernel_enter(uint64_t va, uint64_t size)
+{
+	uint64_t end = va + size;
+
+	va &= ~(uint64_t)ARM_PGMASK;
+	end = (end + ARM_PGMASK) & ~(uint64_t)ARM_PGMASK;
+	if (va < hosted_kva_base) {
+		va = hosted_kva_base;
+	}
+	if (end > hosted_kva_end) {
+		end = hosted_kva_end;
+	}
+	if (va >= end) {
+		return;
+	}
+	uint32_t old = hosted_tlb_lock();
+	(void)hosted_kernel_map_locked(va, end - va, 0);
+	hosted_tlb_unlock(old);
+}
+
+/* ---- iOS tasks ------------------------------------------------------------------------------ */
+
+/* The Linux process that is this pmap's address space; made at the first need. 0 if it cannot be made. */
+uint64_t
+hosted_pmap_task(pmap_t pmap)
+{
+	uint64_t task = os_atomic_load(&pmap->hosted_task, relaxed);
+
+	if (task != 0 || pmap == kernel_pmap || pmap->type != PMAP_TYPE_USER) {
+		return task;
+	}
+	uint32_t old = hosted_irq_mask();
+	int64_t rc = HPC(task_create, &task, 0, 0, 0, 0);
+	if (rc != 0 || task == 0) {
+		hosted_irq_restore(old);
+		printf("hosted: task_create failed (%lld)\n", rc);
+		return 0;
+	}
+	uint32_t locked = hosted_tlb_lock();
+	if (pmap->hosted_task == 0) {
+		pmap->hosted_seq = ++hosted_task_sequence;
+		os_atomic_store(&pmap->hosted_task, task, relaxed);
+		hosted_pmap_stats.tasks_created++;
+		task = 0;
+	}
+	hosted_tlb_unlock(locked);
+	if (task != 0) {
+		(void)HPC(task_destroy, task, 0, 0, 0, 0);     /* another thread made it first */
+	}
+	hosted_irq_restore(old);
+	return pmap->hosted_task;
+}
+
+void
+hosted_pmap_destroy(pmap_t pmap)
+{
+	uint32_t old = hosted_tlb_lock();
+	uint64_t task = pmap->hosted_task;
+	pmap->hosted_task = 0;
+	pmap->hosted_seq = 0;
+	hosted_tlb_unlock(old);
+	if (task != 0) {
+		old = hosted_irq_mask();
+		(void)HPC(task_destroy, task, 0, 0, 0, 0);
+		hosted_pmap_stats.tasks_destroyed++;
+		hosted_irq_restore(old);
+	}
+}
+
+/*
+ * A user fault at va in pmap: fill it from the tables if they allow `access`. Thread context, no locks held.
+ * The pmap's lock keeps its table pages while they are walked.
+ */
+bool
+hosted_user_fill(pmap_t pmap, uint64_t va, uint32_t access)
+{
+	bool filled = false;
+
+	if (pmap == NULL || pmap == kernel_pmap || pmap->hosted_task == 0) {
+		return false;
+	}
+	va &= ~(uint64_t)ARM_PGMASK;
+	pmap_lock(pmap, PMAP_LOCK_SHARED);
+	uint32_t old = hosted_tlb_lock();
+	pt_entry_t pte = hosted_walk(pmap, va);
+	uint32_t prot = hosted_pte_prot(pte, true);
+	if (prot != 0 && !(access & ~prot) && hosted_pa_in_window(pte_to_pa(pte)) && pmap->hosted_task != 0) {
+		filled = HPC(task_map, pmap->hosted_task, va, ARM_PGBYTES, prot, pte_to_pa(pte)) == 0;
+		hosted_pmap_stats.user_maps += filled;
+	}
+	hosted_tlb_unlock(old);
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	return filled;
+}
+
+/* ---- flushes -------------------------------------------------------------------------------- */
+
+static void
+hosted_task_unmap_locked(pmap_t pmap, uint64_t va, uint64_t size)
+{
+	if (pmap->hosted_task != 0) {
+		(void)HPC(task_unmap, pmap->hosted_task, va, size, 0, 0);
+		hosted_pmap_stats.user_unmaps++;
+	}
+}
+
+/* The pmap changed entries in [va, va + size) and invalidates them. */
+void
+hosted_tlb_flush_region(pmap_t pmap, uint64_t va, uint64_t size)
+{
+	uint64_t end = (va + size + ARM_PGMASK) & ~(uint64_t)ARM_PGMASK;
+
+	va &= ~(uint64_t)ARM_PGMASK;
+	if (pmap == kernel_pmap) {
+		if (va < hosted_kva_base) {
+			va = hosted_kva_base;
+		}
+		if (end > hosted_kva_end) {
+			end = hosted_kva_end;
+		}
+		if (va >= end) {
+			return;         /* the window: always mapped, nothing cached */
+		}
+		uint32_t old = hosted_tlb_lock();
+		(void)HPC(kernel_unmap, va, end - va, 0, 0, 0);
+		hosted_pmap_stats.kernel_unmaps++;
+		/* Entries that are still valid (a changed protection) are wanted again at once. */
+		(void)hosted_kernel_map_locked(va, end - va, 0);
+		hosted_tlb_unlock(old);
+		return;
+	}
+	if (end > hosted_info.user_va_limit) {
+		end = hosted_info.user_va_limit;
+	}
+	if (va >= end) {
+		return;
+	}
+	if (pmap->type == PMAP_TYPE_USER) {
+		uint32_t old = hosted_tlb_lock();
+		hosted_task_unmap_locked(pmap, va, end - va);
+		hosted_tlb_unlock(old);
+		return;
+	}
+	/* A nested pmap (the shared region) or the commpage: its tables are part of every task that uses them. */
+	pmap_simple_lock(&pmaps_lock);
+	uint32_t old = hosted_tlb_lock();
+	pmap_t user;
+	queue_iterate(&map_pmap_list, user, pmap_t, pmaps) {
+		if (user->type == PMAP_TYPE_USER && user->hosted_task != 0 &&
+		    (pmap->type != PMAP_TYPE_NESTED || user->nested_pmap == pmap)) {
+			hosted_task_unmap_locked(user, va, end - va);
+		}
+	}
+	hosted_tlb_unlock(old);
+	pmap_simple_unlock(&pmaps_lock);
+}
+
+/* Everything the pmap ever mapped is invalid (its ASID is flushed). */
+void
+hosted_tlb_flush_pmap(pmap_t pmap)
+{
+	if (pmap == kernel_pmap) {
+		return;
+	}
+	hosted_tlb_flush_region(pmap, 0, hosted_info.user_va_limit);
+}
+
+/* ---- copyin / copyout ------------------------------------------------------------------------ */
+
+/*
+ * Copies between kernel memory and a user address space through the RAM window: the user page's physical
+ * address is its kernel address. Returns 0, or the number of bytes left when the tables do not allow the
+ * access at the address reached (the caller resolves the fault and calls again).
+ */
+uint64_t hosted_copy_user_pages(pmap_t pmap, uint64_t uaddr, void *kaddr, uint64_t size, bool to_user, uint64_t *fault_va);
+uint64_t
+hosted_copy_user_pages(pmap_t pmap, uint64_t uaddr, void *kaddr, uint64_t size, bool to_user, uint64_t *fault_va)
+{
+	uint8_t *kernel = kaddr;
+	uint32_t need = to_user ? XH_PROT_WRITE : XH_PROT_READ;
+
+	while (size != 0) {
+		uint64_t chunk = ARM_PGBYTES - (uaddr & ARM_PGMASK);
+		if (chunk > size) {
+			chunk = size;
+		}
+		/*
+		 * The TLB lock is what a TLB shootdown is on hardware: whoever takes this page away from the
+		 * address space flushes after changing the entry, and so waits for the copy to end.
+		 */
+		pmap_lock(pmap, PMAP_LOCK_SHARED);
+		uint32_t old = hosted_tlb_lock();
+		pt_entry_t pte = hosted_walk(pmap, uaddr);
+		uint32_t prot = hosted_pte_prot(pte, true);
+		bool ok = prot != 0 && !(need & ~prot) && hosted_pa_in_window(pte_to_pa(pte));
+		if (ok) {
+			uint8_t *user = (uint8_t *)phystokv(pte_to_pa(pte)) + (uaddr & ARM_PGMASK);
+			if (kernel != NULL) {
+				if (to_user) {
+					memcpy(user, kernel, chunk);
+				} else {
+					memcpy(kernel, user, chunk);
+				}
+			}
+		}
+		hosted_tlb_unlock(old);
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+		if (!ok) {
+			*fault_va = uaddr;
+			return size;
+		}
+		uaddr += chunk;
+		size -= chunk;
+		if (kernel != NULL) {
+			kernel += chunk;
+		}
+	}
+	return 0;
+}
+
+#endif /* XNU_HOSTED */
