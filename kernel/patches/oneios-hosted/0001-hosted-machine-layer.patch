+			for (uint32_t i = 0; i < k_mh->ncmds; i++) {
+				if (lc->cmd == LC_SEGMENT_KERNEL) {
+					kernel_segment_command_t *sg = (kernel_segment_command_t *)lc;
+					kernel_section_t *sect = (kernel_section_t *)((uintptr_t)sg + sizeof(*sg));
+					sg->vmaddr += slide;
