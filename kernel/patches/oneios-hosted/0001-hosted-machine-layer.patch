diff --git a/osfmk/arm64/hosted/hostcall.h b/osfmk/arm64/hosted/hostcall.h
new file mode 100644
index 0000000..f04f95f
--- /dev/null
+++ b/osfmk/arm64/hosted/hostcall.h
@@ -0,0 +1,194 @@
+// SPDX-License-Identifier: MIT
+// xnuhost host-call ABI, version 1: the whole contract between a hosted XNU ("LINUXHOST" machine
+// configuration, kernel/) and xnuhost. This header is freestanding C and is meant to be included by
+// the kernel's machine layer unchanged. docs/booter.md explains the model; the summary:
+//
+//  - The kernel is entered on vCPU 0 at its LC_UNIXTHREAD entry with x0 = boot_args (virtual),
+//    x1 = struct xh_vector *, x2 = struct xh_cpu * of vCPU 0, sp = a 256 KiB boot stack.
+//    The window of RAM is already mapped at boot_args.virtBase; there is no MMU to turn on.
+//    The vector is also in the device tree: /chosen/xnuhost "vector".
+//  - Every host call takes the calling vCPU's struct xh_cpu * first. The host switches to its own
+//    thread register (TPIDR_EL0), x18 and stack for the call, so the kernel may keep anything in
+//    TPIDR_EL0 and x18 while its own code runs. Host calls follow AAPCS64.
+//  - Interrupts are a software flag. The kernel masks them by storing 1 to cpu->irq_masked and
+//    unmasks by storing 0 and then, if cpu->irq_pending is not 0, calling its own interrupt path
+//    (irq_ack until it returns XH_INTID_NONE). While unmasked and running kernel code, an interrupt
+//    arrives as a call of upcalls->irq(cpu, frame) on the interrupted stack with irq_masked = 1;
+//    returning from it resumes the interrupted code. The kernel may block or switch threads inside.
+//  - iOS threads run in other Linux processes. thread_run() gives the vCPU to one until it traps.
+#ifndef XNUHOST_HOSTCALL_H
+#define XNUHOST_HOSTCALL_H
+
+#include <stdint.h>
+
+#define XH_ABI_VERSION 1u
+
+// ---- per-vCPU block (host memory; the kernel reads and writes only the fields marked K) ----------
+struct xh_cpu {
+  uint32_t index;             // 0x00    vCPU number
+  uint32_t irq_masked;        // 0x04 K  1 = interrupts masked (the kernel's DAIF.I)
+  uint32_t irq_pending;       // 0x08    not 0 = the interrupt line is asserted (read by K)
+  uint32_t in_host;           // 0x0c    host only
+  uint64_t kernel_tpidr;      // 0x10    the kernel's TPIDR_EL0 while a host call runs
+  uint64_t kernel_x18;        // 0x18    the kernel's x18 while a host call runs
+  uint64_t host_tpidr;        // 0x20    host only
+  uint64_t host_x18;          // 0x28    host only
+  uint64_t host_sp;           // 0x30    host only
+  uint64_t kernel_data;       // 0x38 K  free for the kernel (its cpu_data pointer)
+  uint64_t tpidr_el1;         // 0x40 K  shadow of TPIDR_EL1 for trapped mrs/msr (current thread)
+  uint64_t reserved[7];       // 0x48
+};                            // 0x80; host-private data follows
+
+// ---- saved register frames ---------------------------------------------------------------------
+struct xh_vreg { uint64_t lo, hi; };
+
+// Kernel context interrupted by an interrupt or exception; lives on the interrupted stack.
+struct xh_frame {
+  uint64_t x[31];
+  uint64_t sp, pc, pstate;    // pstate: NZCV only is meaningful
+  uint32_t fpsr, fpcr;
+  struct xh_vreg v[32];
+  uint32_t irq_masked;        // the mask state to return to
+  uint32_t kind;              // XH_FRAME_*
+  uint64_t far, esr;          // for XH_FRAME_EXCEPTION
+};
+#define XH_FRAME_IRQ        1u
+#define XH_FRAME_EXCEPTION  2u
+
+// User (iOS thread) register state.
+struct xh_user_state {
+  uint64_t x[31];
+  uint64_t sp, pc, pstate;    // pstate: NZCV; the host forces EL0t
+  uint64_t tsd;               // the thread's TSD base. iOS reads it from TPIDRRO_EL0; the host keeps
+                              // it in TPIDR_EL0 and text_fixup() rewrites the reads (docs/booter.md)
+  uint32_t fpsr, fpcr;
+  struct xh_vreg v[32];
+};
+
+// Why a thread stopped running user code.
+struct xh_trap {
+  uint32_t kind;              // XH_TRAP_*
+  uint32_t signo;             // the Linux signal that reported it (diagnostic)
+  uint64_t far;               // fault address (FAULT), instruction address (ILLEGAL, BRK)
+  uint64_t esr;               // ESR_EL1 as Linux reported it, 0 if it did not
+  uint32_t svc;               // SYSCALL: the svc immediate (0x80 for XNU's)
+  uint32_t access;            // FAULT: XH_PROT_* bit of the access that faulted, 0 if unknown
+  uint32_t insn;              // the instruction at the trap, when readable
+  uint32_t exit_status;       // EXITED: the Linux wait status of the task process
+};
+#define XH_TRAP_SYSCALL     1u   // svc: number in x16, as XNU's handle_svc expects
+#define XH_TRAP_FAULT       2u   // data or instruction abort from user mode
+#define XH_TRAP_ILLEGAL     3u   // undefined instruction
+#define XH_TRAP_BRK         4u   // brk / breakpoint / single step
+#define XH_TRAP_FPE         5u
+#define XH_TRAP_INTERRUPT   6u   // an interrupt is pending for this vCPU; state is the interrupted user state
+#define XH_TRAP_EXITED      7u   // the task's Linux process is gone
+#define XH_TRAP_BOOT        8u   // a new thread's first stop, before any user instruction
+
+#define XH_PROT_READ   1u
+#define XH_PROT_WRITE  2u
+#define XH_PROT_EXEC   4u
+
+// ---- interrupts: the board's GICv3 numbering ----------------------------------------------------
+#define XH_INTID_NONE   1023u
+#define XH_INTID_VTIMER 27u      // per-CPU virtual timer (PPI), as ArmCpu takes it
+#define XH_SGI_COUNT    16u
+
+// ---- halt reasons -------------------------------------------------------------------------------
+#define XH_HALT_OFF      0u      // guest shut down: xnuhost exits 0
+#define XH_HALT_RESTART  1u      // guest asked for a reboot: exit 3
+#define XH_HALT_PANIC    2u      // kernel panic: exit 4
+#define XH_HALT_RETURN   3u      // guest asks to return to One UI: session/return.request, exit 0
+
+// ---- static facts about the host ----------------------------------------------------------------
+struct xh_info {
+  uint32_t abi, ncpu;
+  uint32_t host_page_size;     // 4096 on the S24 Ultra; never larger than 16384
+  uint32_t user_va_bits;       // of the host's user address space
+  uint64_t ram_phys, ram_virt, ram_size;      // the kernel's window: physical, where it is mapped, bytes
+  uint64_t io_phys, io_virt, io_size;         // trapped MMIO aperture (the board's devices)
+  uint64_t user_va_min, user_va_limit;        // iOS tasks may use [min, limit)
+  uint64_t timebase_hz;        // CNTFRQ_EL0; CNTVCT_EL0 is readable in the kernel and in tasks
+  uint64_t features;           // XH_FEATURE_*
+  uint64_t video[6];           // boot_args video, repeated
+  uint64_t kva_base, kva_size; // reserved (inaccessible) host addresses for the kernel's own mappings: kernel_map
+};
+#define XH_FEATURE_PAC          (1ull << 0)   // paca/pacg: arm64e runs; one key set for kernel and tasks
+#define XH_FEATURE_TASKS        (1ull << 1)   // the task trap layer works on this host (seccomp, memfd)
+#define XH_FEATURE_PAC_KEYS_OFF (1ull << 2)   // PR_PAC_SET_ENABLED_KEYS: plain arm64 tasks can run
+
+// ---- calls from the host into the kernel --------------------------------------------------------
+struct xh_upcalls {
+  // An interrupt while kernel code ran unmasked. Returning resumes `frame`.
+  void (*irq)(struct xh_cpu *cpu, struct xh_frame *frame);
+  // A fault in kernel code that is not a device access (frame->kind = XH_FRAME_EXCEPTION, far, esr).
+  // The kernel may change frame->pc (copyio recovery) and return, or panic. NULL: xnuhost stops.
+  void (*exception)(struct xh_cpu *cpu, struct xh_frame *frame);
+  // A secondary vCPU's first call, on its boot stack, instead of an entry address (cpu_start with
+  // entry 0). Does not return.
+  void (*cpu_entry)(struct xh_cpu *cpu, uint64_t arg);
+};
+
+// ---- the vector ---------------------------------------------------------------------------------
+// Return values: 0 or a positive count on success, a negative errno otherwise.
+struct xh_vector {
+  uint32_t abi, size;
+  const struct xh_info *info;
+
+  // console, life cycle
+  void     (*console_write)(struct xh_cpu *, const char *text, uint64_t length);
+  void     (*halt)(struct xh_cpu *, uint32_t reason, uint32_t code);           // does not return
+  void     (*ready)(struct xh_cpu *);                 // the guest's first frame is on screen
+  int64_t  (*set_upcalls)(struct xh_cpu *, const struct xh_upcalls *);
+  uint64_t (*wall_time)(struct xh_cpu *);             // seconds since 1970 (armdt_platform_clock_register)
+
+  // CPUs, interrupts, timer
+  int64_t  (*cpu_start)(struct xh_cpu *, uint32_t index, uint64_t entry, uint64_t arg);
+  void     (*cpu_idle)(struct xh_cpu *);              // returns when irq_pending is set
+  uint32_t (*irq_ack)(struct xh_cpu *);               // highest pending INTID, now active; XH_INTID_NONE
+  void     (*irq_eoi)(struct xh_cpu *, uint32_t intid);
+  void     (*irq_enable)(struct xh_cpu *, uint32_t intid, uint32_t enable);
+  void     (*ipi)(struct xh_cpu *, uint32_t target_cpu, uint32_t sgi);
+  void     (*timer_set)(struct xh_cpu *, uint64_t deadline);   // CNTVCT_EL0 value; UINT64_MAX cancels
+  void     (*frame_resume)(struct xh_cpu *, const struct xh_frame *);          // does not return
+
+  // devices
+  uint64_t (*io_map)(struct xh_cpu *, uint64_t phys, uint64_t size);           // kernel VA, 0 if outside
+  uint64_t (*mmio_read)(struct xh_cpu *, uint64_t phys, uint32_t size);
+  void     (*mmio_write)(struct xh_cpu *, uint64_t phys, uint32_t size, uint64_t value);
+
+  // memory
+  int64_t  (*ram_discard)(struct xh_cpu *, uint64_t phys, uint64_t size);      // give free pages back to Linux
+  uint32_t (*text_fixup)(struct xh_cpu *, void *text, uint64_t size);          // rewritten instruction count
+
+  // iOS tasks (Linux processes) and threads
+  int64_t  (*task_create)(struct xh_cpu *, uint64_t *task);
+  int64_t  (*task_destroy)(struct xh_cpu *, uint64_t task);
+  int64_t  (*task_map)(struct xh_cpu *, uint64_t task, uint64_t va, uint64_t size, uint32_t prot, uint64_t phys);
+  int64_t  (*task_unmap)(struct xh_cpu *, uint64_t task, uint64_t va, uint64_t size);
+  int64_t  (*task_protect)(struct xh_cpu *, uint64_t task, uint64_t va, uint64_t size, uint32_t prot);
+  int64_t  (*task_read)(struct xh_cpu *, uint64_t task, uint64_t va, void *buffer, uint64_t size);
+  int64_t  (*task_write)(struct xh_cpu *, uint64_t task, uint64_t va, const void *buffer, uint64_t size);
+  int64_t  (*thread_create)(struct xh_cpu *, uint64_t task, uint64_t *thread);
+  int64_t  (*thread_destroy)(struct xh_cpu *, uint64_t thread);
+  // Runs the thread from *state until it traps; *state is then the trapped state. Blocks the vCPU.
+  int64_t  (*thread_run)(struct xh_cpu *, uint64_t thread, struct xh_user_state *state, struct xh_trap *trap);
+  // Pointer-authentication keys enabled for the thread from its next run (plain arm64 binaries: 0).
+  int64_t  (*thread_set_pac)(struct xh_cpu *, uint64_t thread, uint32_t enabled);
+
+  // The kernel's own address space outside the window: RAM pages at kernel virtual addresses inside
+  // [info->kva_base, +kva_size). Present when size covers them.
+  int64_t  (*kernel_map)(struct xh_cpu *, uint64_t va, uint64_t size, uint32_t prot, uint64_t phys);
+  int64_t  (*kernel_unmap)(struct xh_cpu *, uint64_t va, uint64_t size);
+};
+#define XH_PAC_ALL 0xfu          // APIA, APIB, APDA, APDB
+
+// PSCI function numbers the host answers when the kernel issues `hvc #0` (or `smc #0`) directly,
+// as ArmCpu and ArmDTPlatform do: CPU_ON starts a vCPU at a physical entry address.
+#define XH_PSCI_VERSION       0x84000000u
+#define XH_PSCI_CPU_OFF       0x84000002u
+#define XH_PSCI_CPU_ON        0xc4000003u
+#define XH_PSCI_SYSTEM_OFF    0x84000008u
+#define XH_PSCI_SYSTEM_RESET  0x84000009u
+
+#endif
diff --git a/osfmk/arm64/hosted/hosted.h b/osfmk/arm64/hosted/hosted.h
new file mode 100644
index 0000000..ad2ef50
--- /dev/null
+++ b/osfmk/arm64/hosted/hosted.h
@@ -0,0 +1,160 @@
+/*
+ * OneiOS: the hosted machine layer. XNU runs as an ordinary Linux process under xnuhost
+ * (https://github.com/akshaynexus/OneiOS, runtime/xnuhost): no EL1, no MMU. This header is the kernel's
+ * side of the host-call ABI (arm64/hosted/hostcall.h, a copy of xnuhost's header).
+ *
+ * Register conventions while kernel code runs:
+ *   x18        struct xh_cpu * of the vCPU the code is on. The Darwin ABI reserves x18, so no compiled code
+ *              touches it. It is loaded at entry, and reloaded in every saved frame that is resumed, so a
+ *              thread that is preempted and resumed on another vCPU finds that vCPU's block.
+ *   TPIDR_EL0  the current thread (what TPIDR_EL1 is on hardware). xnuhost keeps its own value across host
+ *              calls and signals.
+ *
+ * Interrupts are a flag: cpu->irq_masked (the kernel's DAIF.I). A single load or store through x18 is atomic
+ * with respect to preemption, which is why the flag is never reached through a copied pointer while unmasked.
+ * Every host call is made with the flag set: the vCPU block it is given must still be the caller's when the
+ * call returns.
+ */
+#ifndef _ARM64_HOSTED_HOSTED_H_
+#define _ARM64_HOSTED_HOSTED_H_
+
+#if XNU_HOSTED
+
+/* struct xh_cpu offsets (hostcall.h) for assembly. */
+#define XH_CPU_INDEX            0x00
+#define XH_CPU_IRQ_MASKED       0x04
+#define XH_CPU_IRQ_PENDING      0x08
+#define XH_CPU_KERNEL_DATA      0x38
+
+/*
+ * The hosted kernel's address range: XNU's small-memory layout (-128 GiB .. -16 GiB) modulo 2^38, which is
+ * the span of the T1SZ = 26 kernel page tables, so every table index is what it is on hardware. xnuhost maps
+ * the RAM window at the bottom of it; the rest is reserved for kernel_map (xh_info.kva_base).
+ */
+#define HOSTED_KERNEL_VA_MIN    0x0000002000000000ULL
+#define HOSTED_KERNEL_VA_MAX    0x0000003bffffffffULL
+
+#ifndef __ASSEMBLER__
+
+#include <stdint.h>
+#include <stdbool.h>
+#include <arm64/hosted/hostcall.h>
+
+extern const struct xh_vector *hosted_vector;
+extern struct xh_info          hosted_info;
+
+static inline struct xh_cpu *
+hosted_cpu(void)
+{
+	struct xh_cpu *cpu;
+	__asm__ volatile ("mov %0, x18" : "=r" (cpu));
+	return cpu;
+}
+
+/* 1 if interrupts are masked on this CPU. */
+static inline uint32_t
+hosted_irq_masked(void)
+{
+	uint32_t masked;
+	__asm__ volatile ("ldr %w0, [x18, #4]" : "=r" (masked));
+	return masked;
+}
+
+/* Mask; returns the previous state. */
+static inline uint32_t
+hosted_irq_mask(void)
+{
+	uint32_t old, one;
+	__asm__ volatile ("ldr %w0, [x18, #4]\n\tmov %w1, #1\n\tstr %w1, [x18, #4]" : "=&r" (old), "=&r" (one));
+	return old;
+}
+
+/* The interrupt line of this CPU. Call masked. */
+static inline uint32_t
+hosted_irq_pending(void)
+{
+	uint32_t pending;
+	__asm__ volatile ("ldr %w0, [x18, #8]" : "=r" (pending));
+	return pending;
+}
+
+extern void hosted_irq_poll(void);
+
+/* Unmask, and take what became pending while masked. */
+static inline void
+hosted_irq_unmask(void)
+{
+	uint32_t pending;
+	__asm__ volatile ("str wzr, [x18, #4]\n\tldr %w0, [x18, #8]" : "=&r" (pending));
+	if (__builtin_expect(pending != 0, 0)) {
+		hosted_irq_poll();
+	}
+}
+
+static inline void
+hosted_irq_restore(uint32_t old)
+{
+	if (!old) {
+		hosted_irq_unmask();
+	}
+}
+
+/* The DAIF value kernel code expects to read: debug exceptions always masked. */
+#define HOSTED_DAIF_MASKED      0x3c0ULL        /* DAIF_ALL */
+#define HOSTED_DAIF_UNMASKED    0x200ULL        /* DAIF_DEBUGF */
+
+static inline uint64_t
+hosted_daif_get(void)
+{
+	return hosted_irq_masked() ? HOSTED_DAIF_MASKED : HOSTED_DAIF_UNMASKED;
+}
+
+static inline void
+hosted_daif_set(uint64_t daif)
+{
+	if (daif & 0x80) {
+		(void)hosted_irq_mask();
+	} else {
+		hosted_irq_unmask();
+	}
+}
+
+/*
+ * The address of a host function. The vector holds plain AArch64 addresses, not signed arm64e function
+ * pointers: they are read as integers and reached through hosted_hc(), never called through a C pointer.
+ */
+#define HOSTED_FN(name)         (*(const uintptr_t *)(const void *)&hosted_vector->name)
+
+/*
+ * int64_t hosted_hc(fn, cpu, a1 .. a5): calls a host function. Call it masked: the vCPU block must still be
+ * the caller's when the call returns.
+ */
+extern int64_t hosted_hc(uintptr_t fn, struct xh_cpu *cpu, uint64_t a1, uint64_t a2, uint64_t a3, uint64_t a4, uint64_t a5);
+
+/* hosted_machine.c */
+struct arm_saved_state;
+extern void hosted_init(void);
+extern void hosted_console_putc(char c);
+extern void hosted_console_flush(void);
+extern void hosted_halt(uint32_t reason, uint32_t code) __attribute__((noreturn));
+extern void hosted_cpu_idle(void);
+extern void hosted_thread_exception_return(void) __attribute__((noreturn));
+extern uint32_t hosted_text_fixup(void *kva, uint64_t size);
+
+/* hosted_pmap.c */
+struct pmap;
+extern uint64_t hosted_kva_base, hosted_kva_end;
+extern void hosted_tlb_flush_region(struct pmap *pmap, uint64_t va, uint64_t size);
+extern void hosted_tlb_flush_pmap(struct pmap *pmap);
+extern bool hosted_kernel_fill(uint64_t va, uint32_t access);
+extern void hosted_kernel_enter(uint64_t va, uint64_t size);
+extern bool hosted_user_fill(struct pmap *pmap, uint64_t va, uint32_t access);
+extern void hosted_pmap_destroy(struct pmap *pmap);
+extern uint64_t hosted_pmap_task(struct pmap *pmap);
+extern int hosted_copy_user(struct pmap *pmap, uint64_t uaddr, void *kaddr, uint64_t size, bool to_user);
+
+#endif /* !__ASSEMBLER__ */
+
+#endif /* XNU_HOSTED */
+
+#endif /* _ARM64_HOSTED_HOSTED_H_ */
diff --git a/osfmk/arm64/hosted/hosted_asm.s b/osfmk/arm64/hosted/hosted_asm.s
new file mode 100644
index 0000000..37a4aca
--- /dev/null
+++ b/osfmk/arm64/hosted/hosted_asm.s
@@ -0,0 +1,162 @@
+/*
+ * OneiOS: the hosted machine layer, assembly (arm64/hosted/hosted.h explains the model).
+ * Entry from xnuhost, stack switches, and the context-switch primitives of a kernel that has no EL1:
+ * what start.s, locore.s and cswitch.s are on hardware.
+ */
+#include <machine/asm.h>
+#include <arm64/machine_machdep.h>
+#include <arm64/machine_routines_asm.h>
+#include <arm64/pac_asm.h>
+#include <arm64/proc_reg.h>
+#include <pexpert/arm64/board_config.h>
+#include "assym.s"
+
+#if XNU_HOSTED
+
+#include <arm64/hosted/hosted.h>
+
+/*
+ * hosted_start: the kernel's entry on vCPU 0 (LC_UNIXTHREAD pc, through _start).
+ *   x0 = boot_args (virtual = physical: the window is mapped where the kernel runs)
+ *   x1 = struct xh_vector *
+ *   x2 = struct xh_cpu * of this vCPU
+ * Nothing is rebased yet: only pc-relative references until arm_init has slid the image.
+ */
+	.text
+	.align 2
+	.globl EXT(hosted_start)
+LEXT(hosted_start)
+	mov		x18, x2								// the vCPU block, for good
+	msr		TPIDR_EL0, xzr						// no current thread yet
+	adrp	x9, EXT(hosted_vector)@page
+	str		x1, [x9, EXT(hosted_vector)@pageoff]
+	adrp	x9, EXT(intstack_top)@page			// the boot CPU's interrupt stack, as on hardware
+	add		x9, x9, EXT(intstack_top)@pageoff
+	mov		sp, x9
+	mov		fp, #0
+	mov		lr, #0
+	bl		EXT(arm_init)
+	b		.
+
+/*
+ * hosted_cpu_start: a secondary vCPU's entry (PSCI CPU_ON from ArmCpu, or the cpu_start host call).
+ *   x0 = the context the starter passed (unused: the CPU is found by its index)
+ *   x1 = struct xh_vector *
+ *   x2 = struct xh_cpu * of this vCPU
+ * The stack is xnuhost's boot stack of the vCPU until arm_init_cpu's thread is loaded.
+ */
+	.text
+	.align 2
+	.globl EXT(hosted_cpu_start)
+LEXT(hosted_cpu_start)
+	mov		x18, x2
+	msr		TPIDR_EL0, xzr
+	mov		fp, #0
+	mov		lr, #0
+	mov		x0, x2
+	bl		EXT(hosted_secondary_entry)
+	b		.
+
+/*
+ * void hosted_call_on_stack(void *arg, vm_offset_t stack_top, void (*fn)(void *))
+ * Calls hosted_stack_call(arg, fn) with sp = stack_top, then comes back to the caller's stack.
+ */
+	.text
+	.align 2
+	.globl EXT(hosted_call_on_stack)
+LEXT(hosted_call_on_stack)
+	ARM64_STACK_PROLOG
+	PUSH_FRAME
+	mov		sp, x1
+	mov		x1, x2
+	bl		EXT(hosted_stack_call)
+	POP_FRAME
+	ARM64_STACK_EPILOG
+
+/*
+ * void hosted_switch_to_stack(void *arg, vm_offset_t stack_top, void (*fn)(void *)) __dead2
+ * As above, but the old stack is abandoned: fn does not return.
+ */
+	.text
+	.align 2
+	.globl EXT(hosted_switch_to_stack)
+LEXT(hosted_switch_to_stack)
+	mov		sp, x1
+	mov		fp, #0
+	mov		lr, #0
+	mov		x1, x2
+	bl		EXT(hosted_stack_call)
+	brk		#0x1
+
+/*
+ * int64_t hosted_hc(uintptr_t fn, struct xh_cpu *cpu, uint64_t a1, ..., uint64_t a5)
+ * Calls a host function (the vector's raw, unsigned address) with (cpu, a1 .. a5).
+ */
+	.text
+	.align 2
+	.globl EXT(hosted_hc)
+LEXT(hosted_hc)
+	ARM64_PROLOG
+	mov		x9, x0
+	mov		x0, x1
+	mov		x1, x2
+	mov		x2, x3
+	mov		x3, x4
+	mov		x4, x5
+	mov		x5, x6
+	br		x9
+
+/*
+ * Upcalls: xnuhost enters these with x0 = struct xh_cpu *, x1 = struct xh_frame * (the interrupted
+ * context, on its own stack) and sp = the frame. They do not return: the C handlers end with frame_resume.
+ * A frame record that points at the interrupted pc and fp keeps backtraces whole.
+ */
+#define XH_FRAME_FP		(29 * 8)
+#define XH_FRAME_PC		(32 * 8)
+
+.macro HOSTED_UPCALL handler
+	mov		x18, x0
+	ldr		x9, [x1, #XH_FRAME_FP]
+	ldr		x10, [x1, #XH_FRAME_PC]
+	stp		x9, x10, [sp, #-16]!
+	mov		fp, sp
+	bl		EXT(\handler)
+	brk		#0x1
+.endmacro
+
+	.text
+	.align 2
+	.globl EXT(hosted_irq_upcall_entry)
+LEXT(hosted_irq_upcall_entry)
+	HOSTED_UPCALL hosted_irq_upcall
+
+	.align 2
+	.globl EXT(hosted_exception_upcall_entry)
+LEXT(hosted_exception_upcall_entry)
+	HOSTED_UPCALL hosted_exception_upcall
+
+	/* cpu_entry(cpu, arg): a secondary vCPU started with the cpu_start host call and no entry address. */
+	.align 2
+	.globl EXT(hosted_cpu_entry_upcall)
+LEXT(hosted_cpu_entry_upcall)
+	mov		x2, x0
+	mov		x0, x1
+	b		EXT(hosted_cpu_start)
+
+/* void hosted_upcall_addresses(uint64_t out[3]): struct xh_upcalls, as raw addresses. */
+	.align 2
+	.globl EXT(hosted_upcall_addresses)
+LEXT(hosted_upcall_addresses)
+	ARM64_PROLOG
+	adrp	x9, EXT(hosted_irq_upcall_entry)@page
+	add		x9, x9, EXT(hosted_irq_upcall_entry)@pageoff
+	str		x9, [x0, #0]
+	adrp	x9, EXT(hosted_exception_upcall_entry)@page
+	add		x9, x9, EXT(hosted_exception_upcall_entry)@pageoff
+	str		x9, [x0, #8]
+	adrp	x9, EXT(hosted_cpu_entry_upcall)@page
+	add		x9, x9, EXT(hosted_cpu_entry_upcall)@pageoff
+	str		x9, [x0, #16]
+	ret
+
+#endif /* XNU_HOSTED */
diff --git a/osfmk/arm64/hosted/hosted_machine.c b/osfmk/arm64/hosted/hosted_machine.c
new file mode 100644
index 0000000..713a562
--- /dev/null
+++ b/osfmk/arm64/hosted/hosted_machine.c
@@ -0,0 +1,501 @@
+/*
+ * OneiOS: the hosted machine layer (arm64/hosted/hosted.h explains the model). This file is what the
+ * exception vectors, the interrupt entry and the return to user mode are on hardware:
+ *   - interrupts and kernel faults arrive as calls from xnuhost (upcalls) on the interrupted stack;
+ *   - user mode is a host call: thread_run() runs the thread's Linux twin until it traps, and the trap is
+ *     handed to sleh_synchronous() / sleh_irq() as the vectors would.
+ */
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <mach/exception_types.h>
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <kern/ast.h>
+#include <kern/debug.h>
+#include <kern/misc_protos.h>
+#include <kern/processor.h>
+#include <kern/sched_prim.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/cpu_internal.h>
+#include <arm/machine_routines.h>
+#include <arm/misc_protos.h>
+#include <arm/thread.h>
+#include <arm/pmap.h>
+#include <arm64/proc_reg.h>
+#include <arm64/machine_machdep.h>
+#include <arm64/instructions.h>
+#include <vm/pmap.h>
+#include <vm/vm_map_xnu.h>
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+#include <ptrauth.h>
+#include <stdarg.h>
+#include <string.h>
+
+extern int vsnprintf(char *, size_t, const char *, va_list) __printflike(3, 0);
+
+#if XNU_HOSTED
+
+#include <arm64/hosted/hosted.h>
+
+const struct xh_vector *hosted_vector;
+struct xh_info          hosted_info;
+
+extern void sleh_irq(arm_saved_state_t *state);
+extern void sleh_synchronous(arm_context_t *context, uint64_t esr, vm_offset_t far, bool did_initiate_panic_lockdown);
+extern void hosted_call_on_stack(void *arg, vm_offset_t stack_top, void (*fn)(void *));
+extern void hosted_switch_to_stack(void *arg, vm_offset_t stack_top, void (*fn)(void *)) __dead2;
+extern void hosted_upcall_addresses(uint64_t out[3]);
+
+void hosted_stack_call(void *arg, void (*fn)(void *));
+void hosted_irq_upcall(struct xh_cpu *cpu, struct xh_frame *frame) __dead2;
+void hosted_exception_upcall(struct xh_cpu *cpu, struct xh_frame *frame) __dead2;
+void hosted_secondary_entry(struct xh_cpu *cpu) __dead2;
+
+/* Counters, for the boot log and the debugger. */
+struct hosted_stats {
+	uint64_t irq_upcalls, irq_polls, irq_user;
+	uint64_t kernel_faults, kernel_fills;
+	uint64_t user_traps, user_syscalls, user_faults, user_fills;
+} hosted_stats;
+
+void
+hosted_stack_call(void *arg, void (*fn)(void *))
+{
+	fn(arg);
+}
+
+/* A host call with up to five arguments after the vCPU block (hosted.h: HOSTED_FN, hosted_hc). */
+#define HC(name, ...)   hosted_hc(HOSTED_FN(name), hosted_cpu(), HC_PAD(__VA_ARGS__ __VA_OPT__(, ) 0, 0, 0, 0, 0))
+#define HC_PAD(a1, a2, a3, a4, a5, ...) (uint64_t)(a1), (uint64_t)(a2), (uint64_t)(a3), (uint64_t)(a4), (uint64_t)(a5)
+
+/* ---- console ------------------------------------------------------------------------------- */
+
+static char     hosted_console_buf[512];
+static uint32_t hosted_console_len;
+static uint32_t hosted_console_lock;
+
+static void
+hosted_console_lock_take(void)
+{
+	while (!__sync_bool_compare_and_swap(&hosted_console_lock, 0, 1)) {
+		__builtin_arm_yield();
+	}
+}
+
+void
+hosted_console_putc(char c)
+{
+	uint32_t old = hosted_irq_mask();
+	hosted_console_lock_take();
+	hosted_console_buf[hosted_console_len++] = c;
+	if (c == '\n' || hosted_console_len == sizeof(hosted_console_buf)) {
+		(void)HC(console_write, hosted_console_buf, hosted_console_len);
+		hosted_console_len = 0;
+	}
+	__sync_lock_release(&hosted_console_lock);
+	hosted_irq_restore(old);
+}
+
+void
+hosted_console_flush(void)
+{
+	uint32_t old = hosted_irq_mask();
+	if (hosted_console_len != 0) {
+		(void)HC(console_write, hosted_console_buf, hosted_console_len);
+		hosted_console_len = 0;
+	}
+	hosted_irq_restore(old);
+}
+
+/* Before the console exists, and where printf must not be trusted: text and a number straight to the host. */
+static void
+hosted_raw_log(const char *text, uint64_t value)
+{
+	char line[160];
+	unsigned n = 0;
+	static const char digits[] = "0123456789abcdef";
+
+	while (*text && n < sizeof(line) - 24) {
+		line[n++] = *text++;
+	}
+	line[n++] = ' ';
+	line[n++] = '0';
+	line[n++] = 'x';
+	for (int shift = 60; shift >= 0; shift -= 4) {
+		line[n++] = digits[(value >> shift) & 0xf];
+	}
+	line[n++] = '\n';
+	uint32_t old = hosted_irq_mask();
+	(void)HC(console_write, line, n);
+	if (!old) {
+		__asm__ volatile ("str wzr, [x18, #4]");
+	}
+}
+
+void
+hosted_halt(uint32_t reason, uint32_t code)
+{
+	(void)hosted_irq_mask();
+	if (hosted_console_len != 0) {
+		(void)HC(console_write, hosted_console_buf, hosted_console_len);
+		hosted_console_len = 0;
+	}
+	(void)HC(halt, reason, code);
+	for (;;) {
+		__builtin_arm_wfi();
+	}
+}
+
+/* panic(): the message and the callers to xnuhost's log, then stop with the panic exit code. */
+void hosted_panic(const char *format, va_list *args, unsigned long caller) __dead2;
+void
+hosted_panic(const char *format, va_list *args, unsigned long caller)
+{
+	static char     message[1024];
+	static uint32_t panicking;
+
+	(void)hosted_irq_mask();
+	if (__sync_lock_test_and_set(&panicking, 1) != 0) {
+		/* a second CPU, or a panic inside this function: the first report stands */
+		hosted_raw_log("hosted: panic while panicking, caller", caller - vm_kernel_slide);
+		hosted_halt(XH_HALT_PANIC, 3);
+	}
+	if (hosted_console_len != 0) {
+		(void)HC(console_write, hosted_console_buf, hosted_console_len);
+		hosted_console_len = 0;
+	}
+	int n = snprintf(message, sizeof(message), "panic(cpu %u caller 0x%lx): ", hosted_cpu()->index, caller - vm_kernel_slide);
+	if (n > 0 && (size_t)n < sizeof(message)) {
+		n += vsnprintf(message + n, sizeof(message) - (size_t)n - 1, format, *args);
+	}
+	if (n < 0 || (size_t)n >= sizeof(message) - 1) {
+		n = (int)sizeof(message) - 2;
+	}
+	message[n++] = '\n';
+	(void)HC(console_write, message, n);
+
+	/* The callers, as link-time addresses (subtract nothing more to look them up in the Mach-O). */
+	uint64_t *fp = (uint64_t *)__builtin_frame_address(0);
+	for (int depth = 0; depth < 24 && fp != NULL; depth++) {
+		uint64_t next = fp[0];
+		uint64_t lr = (uint64_t)ptrauth_strip((void *)fp[1], ptrauth_key_return_address);
+		if (lr == 0) {
+			break;
+		}
+		hosted_raw_log("  frame", lr - vm_kernel_slide);
+		if (next <= (uint64_t)fp || next - (uint64_t)fp > 0x100000) {
+			break;          /* another stack, or the end */
+		}
+		fp = (uint64_t *)next;
+	}
+	hosted_halt(XH_HALT_PANIC, 0);
+}
+
+/* ---- start -------------------------------------------------------------------------------- */
+
+void
+hosted_init(void)
+{
+	if (hosted_vector == NULL || hosted_vector->abi != XH_ABI_VERSION) {
+		for (;;) {
+			__builtin_trap();
+		}
+	}
+	/* The host's facts, copied: the kernel reads them long after it stopped trusting pointers. */
+	memcpy(&hosted_info, hosted_vector->info, sizeof(hosted_info));
+	if (hosted_vector->size < __builtin_offsetof(struct xh_vector, kernel_unmap) + sizeof(void *) ||
+	    hosted_info.kva_size == 0) {
+		hosted_raw_log("hosted: this xnuhost has no kernel_map (vector size)", hosted_vector->size);
+		hosted_halt(XH_HALT_PANIC, 1);
+	}
+	hosted_kva_base = hosted_info.kva_base;
+	hosted_kva_end = hosted_info.kva_base + hosted_info.kva_size;
+	if (hosted_info.ram_virt < HOSTED_KERNEL_VA_MIN || hosted_kva_end > HOSTED_KERNEL_VA_MAX + 1 ||
+	    hosted_info.ram_virt != hosted_info.ram_phys) {
+		hosted_raw_log("hosted: the RAM window is outside the kernel's address range", hosted_info.ram_virt);
+		hosted_halt(XH_HALT_PANIC, 1);
+	}
+
+	uint64_t upcalls[3];
+	hosted_upcall_addresses(upcalls);
+	(void)HC(set_upcalls, upcalls);
+}
+
+/* ---- saved states ----------------------------------------------------------------------------- */
+
+/* The kernel context xnuhost interrupted, as the arm_context_t the exception vectors would have spilled. */
+static void
+hosted_frame_to_context(const struct xh_frame *frame, arm_context_t *context, uint64_t esr)
+{
+	arm_saved_state64_t *ss = &context->ss.ss_64;
+
+	bzero(context, sizeof(*context));
+	context->ss.ash.flavor = ARM_SAVED_STATE64;
+	context->ss.ash.count = ARM_SAVED_STATE64_COUNT;
+	context->ns.nsh.flavor = ARM_NEON_SAVED_STATE64;
+	context->ns.nsh.count = ARM_NEON_SAVED_STATE64_COUNT;
+	for (int i = 0; i < 29; i++) {
+		ss->x[i] = frame->x[i];
+	}
+	ss->fp = frame->x[29];
+	ss->lr = frame->x[30];
+	ss->sp = frame->sp;
+	ss->pc = frame->pc;
+	ss->cpsr = (uint32_t)(frame->pstate & PSR64_NZCV_MASK) | PSR64_MODE_EL1 | PSR64_MODE_SP0 |
+	    (frame->irq_masked ? DAIF_STANDARD_DISABLE : 0);
+	ss->far = frame->far;
+	ss->esr = esr;
+	memcpy(&context->ns.ns_64.v, frame->v, sizeof(frame->v));
+	context->ns.ns_64.fpsr = frame->fpsr;
+	context->ns.ns_64.fpcr = frame->fpcr;
+#if defined(HAS_APPLE_PAC)
+	ml_sign_thread_state(&context->ss, ss->pc, ss->cpsr, ss->lr, ss->x[16], ss->x[17]);
+#endif
+}
+
+/* What a handler changed (the recovery pc of a copyio fault, a debugger's edits) goes back into the frame. */
+static void
+hosted_context_to_frame(const arm_context_t *context, struct xh_frame *frame)
+{
+	const arm_saved_state64_t *ss = &context->ss.ss_64;
+
+	for (int i = 0; i < 29; i++) {
+		frame->x[i] = ss->x[i];
+	}
+	frame->x[29] = ss->fp;
+	frame->x[30] = ss->lr;
+	frame->sp = ss->sp;
+	frame->pc = ss->pc;
+	frame->pstate = (frame->pstate & ~(uint64_t)PSR64_NZCV_MASK) | (ss->cpsr & PSR64_NZCV_MASK);
+}
+
+/* Ends an upcall: the interrupted context continues, on the vCPU this thread is on now. */
+static void __dead2
+hosted_frame_resume(struct xh_frame *frame)
+{
+	(void)hosted_irq_mask();
+	frame->x[18] = (uint64_t)hosted_cpu();
+	(void)HC(frame_resume, frame);
+	__builtin_unreachable();
+}
+
+/* ---- interrupts ------------------------------------------------------------------------------ */
+
+static void
+hosted_irq_run(void *arg)
+{
+	sleh_irq((arm_saved_state_t *)arg);
+}
+
+/* The body of fleh_irq: counts, the interrupt stack, the registered handler. Called masked. */
+static void
+hosted_interrupt(arm_saved_state_t *state)
+{
+	thread_t    thread = current_thread();
+	cpu_data_t *cdp = thread->machine.CpuDatap;
+	vm_offset_t here = (vm_offset_t)__builtin_frame_address(0);
+
+	if (cdp->interrupt_handler == NULL) {
+		return;         /* no interrupt controller yet: the line stays up until there is one */
+	}
+	cdp->cpu_stat.irq_ex_cnt++;
+	cdp->cpu_stat.irq_ex_cnt_wake++;
+	thread->machine.preemption_count++;
+	cdp->cpu_int_state = state;
+	if (here <= cdp->intstack_top && here > cdp->intstack_top - INTSTACK_SIZE) {
+		sleh_irq(state);        /* already on the interrupt stack (the idle path) */
+	} else {
+		hosted_call_on_stack(state, cdp->intstack_top, hosted_irq_run);
+	}
+	cdp->cpu_int_state = NULL;
+	thread->machine.preemption_count--;
+}
+
+/* return_to_kernel: an urgent AST is taken on the way back to an interruptible, preemptible context. */
+static void
+hosted_kernel_ast(void)
+{
+	thread_t thread = current_thread();
+
+	if (thread->machine.preemption_count == 0 &&
+	    (thread->machine.CpuDatap->cpu_pending_ast & AST_URGENT)) {
+		ast_taken_kernel();
+	}
+}
+
+/*
+ * The interrupt line rose while the kernel had interrupts masked, and they were just unmasked: take the
+ * interrupt here, as if it had arrived at the caller's next instruction.
+ */
+void
+hosted_irq_poll(void)
+{
+	arm_context_t context;
+
+	for (int pass = 0; pass < 4; pass++) {
+		if (hosted_irq_mask() != 0) {
+			return;         /* masked again by an interrupt that ran in between */
+		}
+		if (!hosted_irq_pending() || current_thread() == NULL ||
+		    current_thread()->machine.CpuDatap->interrupt_handler == NULL) {
+			__asm__ volatile ("str wzr, [x18, #4]");
+			return;
+		}
+		hosted_stats.irq_polls++;
+		struct xh_frame frame = { .pc = (uint64_t)__builtin_return_address(0),
+			                  .sp = (uint64_t)__builtin_frame_address(0) };
+		frame.pc = (uint64_t)ptrauth_strip((void *)frame.pc, ptrauth_key_return_address);
+		hosted_frame_to_context(&frame, &context, 0);
+		hosted_interrupt(&context.ss);
+		hosted_kernel_ast();
+		__asm__ volatile ("str wzr, [x18, #4]");
+	}
+}
+
+/* xnuhost: an interrupt while kernel code ran unmasked. `frame` is on the interrupted stack. */
+void
+hosted_irq_upcall(struct xh_cpu *cpu __unused, struct xh_frame *frame)
+{
+	arm_context_t context;
+
+	hosted_stats.irq_upcalls++;
+	if (current_thread() != NULL) {
+		hosted_frame_to_context(frame, &context, 0);
+		for (int pass = 0; pass < 4 && hosted_irq_pending(); pass++) {
+			hosted_interrupt(&context.ss);
+		}
+		if (!frame->irq_masked) {
+			hosted_kernel_ast();
+		}
+	}
+	hosted_frame_resume(frame);
+}
+
+/* ---- kernel faults --------------------------------------------------------------------------- */
+
+static uint32_t hosted_fault_depth[MAX_CPUS];
+
+static void __dead2
+hosted_fatal_fault(const struct xh_frame *frame, const char *why)
+{
+	hosted_raw_log(why, frame->far);
+	hosted_raw_log("  pc", frame->pc);
+	hosted_raw_log("  lr", frame->x[30]);
+	hosted_raw_log("  sp", frame->sp);
+	hosted_raw_log("  esr", frame->esr);
+	hosted_raw_log("  kernel slide", vm_kernel_slide);
+	hosted_raw_log("  pc unslid", frame->pc - vm_kernel_slide);
+	hosted_raw_log("  lr unslid", (uint64_t)ptrauth_strip((void *)frame->x[30], ptrauth_key_return_address) - vm_kernel_slide);
+	for (int i = 0; i < 29; i += 1) {
+		hosted_raw_log("  x", frame->x[i]);
+	}
+	hosted_halt(XH_HALT_PANIC, 2);
+}
+
+/*
+ * The exception class the vectors would have read from ESR_EL1. Linux reports the syndrome of a fault as
+ * its own kernel took it (from EL0); a trap that is not a fault comes with no syndrome at all.
+ */
+static uint64_t
+hosted_kernel_esr(const struct xh_frame *frame)
+{
+	uint64_t esr = frame->esr;
+	uint32_t ec = (uint32_t)ESR_EC(esr);
+
+	if (ec == ESR_EC_DABORT_EL0) {
+		return (esr & ~(uint64_t)ESR_EC_MASK) | ((uint64_t)ESR_EC_DABORT_EL1 << ESR_EC_SHIFT);
+	}
+	if (ec == ESR_EC_IABORT_EL0) {
+		return (esr & ~(uint64_t)ESR_EC_MASK) | ((uint64_t)ESR_EC_IABORT_EL1 << ESR_EC_SHIFT);
+	}
+	if (esr != 0) {
+		return esr;
+	}
+	/* No syndrome: a breakpoint or an undefined instruction at pc (which is readable: it was fetched). */
+	uint32_t insn = *(const uint32_t *)frame->pc;
+	if ((insn & 0xffe0001f) == 0xd4200000) {
+		return ((uint64_t)ESR_EC_BRK_AARCH64 << ESR_EC_SHIFT) | ESR_IL | ((insn >> 5) & 0xffff);
+	}
+	return ((uint64_t)ESR_EC_UNCATEGORIZED << ESR_EC_SHIFT) | ESR_IL;
+}
+
+/* xnuhost: a synchronous trap in kernel code that is not a device access. */
+void
+hosted_exception_upcall(struct xh_cpu *cpu, struct xh_frame *frame)
+{
+	arm_context_t context;
+	uint64_t      esr = hosted_kernel_esr(frame);
+	uint32_t      ec = (uint32_t)ESR_EC(esr);
+	unsigned      index = cpu->index < MAX_CPUS ? cpu->index : 0;
+
+	hosted_stats.kernel_faults++;
+	/* The software TLB: the page tables may already allow what the host mapping does not have yet. */
+	if (ec == ESR_EC_DABORT_EL1 || ec == ESR_EC_IABORT_EL1) {
+		uint32_t access = ec == ESR_EC_IABORT_EL1 ? XH_PROT_EXEC : (esr & ISS_DA_WNR) ? XH_PROT_WRITE : XH_PROT_READ;
+		if (hosted_kernel_fill(frame->far, access)) {
+			hosted_stats.kernel_fills++;
+			hosted_frame_resume(frame);
+		}
+	}
+	if (current_thread() == NULL) {
+		hosted_fatal_fault(frame, "hosted: kernel fault before the first thread, address");
+	}
+	if (hosted_fault_depth[index]++ != 0) {
+		hosted_fatal_fault(frame, "hosted: kernel fault inside the fault handler, address");
+	}
+	hosted_frame_to_context(frame, &context, esr);
+	sleh_synchronous(&context, esr, frame->far, false);
+	/* sleh_synchronous may have enabled interrupts and switched CPUs: mask before the frame is touched. */
+	(void)hosted_irq_mask();
+	hosted_fault_depth[hosted_cpu()->index < MAX_CPUS ? hosted_cpu()->index : 0] = 0;
+	hosted_context_to_frame(&context, frame);
+	hosted_frame_resume(frame);
+}
+
+/* ---- idle, CPUs ------------------------------------------------------------------------------- */
+
+/* wfi: returns when this CPU's interrupt line is up. Called masked. */
+void
+hosted_cpu_idle(void)
+{
+	(void)HC(cpu_idle);
+}
+
+void
+hosted_secondary_entry(struct xh_cpu *cpu)
+{
+	hosted_raw_log("hosted: secondary CPUs are not started by the hosted layer yet, cpu", cpu->index);
+	(void)hosted_irq_mask();
+	for (;;) {
+		(void)HC(cpu_idle);
+	}
+}
+
+/* io_map(): where the host has a device window or memory outside the kernel's window; 0 if it has neither. */
+vm_offset_t hosted_io_map(vm_map_offset_t phys_addr, vm_size_t size);
+vm_offset_t
+hosted_io_map(vm_map_offset_t phys_addr, vm_size_t size)
+{
+	uint32_t old = hosted_irq_mask();
+	vm_offset_t va = (vm_offset_t)HC(io_map, phys_addr, size);
+	hosted_irq_restore(old);
+	return va;
+}
+
+uint32_t
+hosted_text_fixup(void *kva, uint64_t size)
+{
+	uint32_t old = hosted_irq_mask();
+	uint32_t count = (uint32_t)HC(text_fixup, kva, size);
+	hosted_irq_restore(old);
+	return count;
+}
+
+void
+hosted_thread_exception_return(void)
+{
+	panic("hosted: return to user mode is not implemented");
+}
