+#if XNU_HOSTED
+/*
+ * OneiOS hosted: a standalone kernel (MH_EXECUTE, not inside a kernel collection) linked with chained fixups
+ * (LC_DYLD_CHAINED_FIXUPS, DYLD_CHAINED_PTR_ARM64E_KERNEL) has an empty __thread_starts and nobody to apply its
+ * chains: iBoot and DarwinBoot only ever start such a kernel inside a collection. xnuhost loads it as it is,
+ * so the kernel walks its own chains here: each rebase becomes image base + offset, each authenticated one is
+ * signed in place with this process's keys. Nothing is rebased yet, so no function is called.
+ */
+static inline __attribute__((__always_inline__)) void
+hosted_apply_chained_fixups(kernel_mach_header_t *mh)
+{
+	const struct linkedit_data_command *fixups = NULL;
+	uintptr_t linkedit = 0;
+	uint64_t linkedit_fileoff = 0;
+	struct load_command *lc = (struct load_command *)((uintptr_t)mh + sizeof(*mh));
+
+	for (uint32_t i = 0; i < mh->ncmds; i++) {
+		if (lc->cmd == LC_DYLD_CHAINED_FIXUPS) {
+			fixups = (const struct linkedit_data_command *)lc;
+		} else if (lc->cmd == LC_SEGMENT_KERNEL) {
+			kernel_segment_command_t *sg = (kernel_segment_command_t *)lc;
+			if (strings_are_equal(sg->segname, "__LINKEDIT")) {
+				linkedit = sg->vmaddr;          /* already slid by the caller */
+				linkedit_fileoff = sg->fileoff;
+			}
+		}
+		lc = (struct load_command *)((uintptr_t)lc + lc->cmdsize);
+	}
+	if (fixups == NULL || linkedit == 0) {
+		return;
+	}
+	const struct dyld_chained_fixups_header *header =
+	    (const struct dyld_chained_fixups_header *)(linkedit + (fixups->dataoff - linkedit_fileoff));
+	const struct dyld_chained_starts_in_image *starts =
+	    (const struct dyld_chained_starts_in_image *)((uintptr_t)header + header->starts_offset);
+
+	for (uint32_t seg = 0; seg < starts->seg_count; seg++) {
+		if (starts->seg_info_offset[seg] == 0) {
+			continue;
+		}
+		const struct dyld_chained_starts_in_segment *si =
+		    (const struct dyld_chained_starts_in_segment *)((uintptr_t)starts + starts->seg_info_offset[seg]);
+		if (si->pointer_format != DYLD_CHAINED_PTR_ARM64E_KERNEL) {
+			__builtin_trap();
+		}
+		for (uint32_t page = 0; page < si->page_count; page++) {
+			if (si->page_start[page] == DYLD_CHAINED_PTR_START_NONE) {
+				continue;
+			}
+			uint64_t *loc = (uint64_t *)((uintptr_t)mh + si->segment_offset +
+			    (uint64_t)page * si->page_size + si->page_start[page]);
+			for (;;) {
+				uint64_t raw = *loc;
+				uint64_t next = (raw >> 51) & 0x7ff;
+				uint64_t value;
+
+				if (raw & (1ULL << 62)) {
+					/*
+					 * A bind: a weak import nothing in this image defines for the linker (the board's
+					 * optional entry points). Unresolved, as dyld leaves a missing weak symbol: NULL.
+					 */
+					value = 0;
+				} else if (raw & (1ULL << 63)) {
+					value = (uintptr_t)mh + (raw & 0xffffffffULL);
+#if HAS_APPLE_PAC
+					uint64_t discriminator = (raw >> 32) & 0xffff;
+					if (raw & (1ULL << 48)) {
+						discriminator = discriminator ?
+						    __builtin_ptrauth_blend_discriminator((void *)loc, discriminator) : (uint64_t)(uintptr_t)loc;
+					}
+					switch ((raw >> 49) & 3) {
+					case 0:
+						value = (uint64_t)__builtin_ptrauth_sign_unauthenticated((void *)value, ptrauth_key_asia, discriminator);
+						break;
+					case 1:
+						value = (uint64_t)__builtin_ptrauth_sign_unauthenticated((void *)value, ptrauth_key_asib, discriminator);
+						break;
+					case 2:
+						value = (uint64_t)__builtin_ptrauth_sign_unauthenticated((void *)value, ptrauth_key_asda, discriminator);
+						break;
+					case 3:
+						value = (uint64_t)__builtin_ptrauth_sign_unauthenticated((void *)value, ptrauth_key_asdb, discriminator);
+						break;
+					}
+#endif /* HAS_APPLE_PAC */
+				} else {
+					value = ((uintptr_t)mh + (raw & 0x7ffffffffffULL)) | (((raw >> 43) & 0xff) << 56);
+				}
+				*loc = value;
+				if (next == 0) {
+					break;
+				}
+				loc = (uint64_t *)((uintptr_t)loc + next * 4);
+			}
+		}
+	}
+}
+#endif /* XNU_HOSTED */
