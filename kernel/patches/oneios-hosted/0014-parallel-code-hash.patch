+	struct cs_native4k_job job = {
+		.vp = vp, .blob = blob, .storage = storage, .limit = limit, .ioflags = ioflags,
+		.cred = vfs_context_ucred(vfs_context_current()),
+	};
+	error = cs_native4k_job_all(&job, vp->v_name);
+	if (error != 0) {
+		goto out;
+	}
+	for (chunk = limit; chunk < limit; chunk += CS_NATIVE4K_CHUNK) {        /* the single-thread loop: not taken */
+#else
 	for (chunk = 0; chunk < limit; chunk += CS_NATIVE4K_CHUNK) {
+#endif
 		size_t chunk_length = MIN((uint64_t)CS_NATIVE4K_CHUNK, limit - chunk);
 		int resid = 0;
 		off_t position;
