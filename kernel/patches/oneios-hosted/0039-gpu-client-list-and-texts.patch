+#if XNU_HOSTED
+/*
+ * OneiOS hosted (0039): the Metal plug-in's list of the processes that get a device (NativeAdrenoMetal.clients beside its
+ * bundle; the plug-in reads it in every process but backboardd) is written at every boot from the kernel's own list, the
+ * one the accelerator's grant decides the open by (droidvm-gpu-clients or the GPU archive's default, OneiOSAdreno.cpp;
+ * oneios-gpu-plugin-clients for the plug-in alone). Before, the plug-in's list was the Data seed's, fixed when the image
+ * was built: another list needed a new seed, and a new seed starts the Data store over. One line:
+ *   oneios-gpu-list: /private/var/oneios/addons/Extensions/NativeAdrenoMetal.clients "a,b": written (0)
+ */
+extern void oneios_gpu_plugin_client_list(char *, size_t) __attribute__((weak_import));
+static void
+oneios_gpu_clients_file(const char *folder)
+{
+	char list[256], text[260], path[128];
+	if (!oneios_gpu_plugin_client_list) {
+		return;
+	}
+	oneios_gpu_plugin_client_list(list, sizeof(list));
+	size_t length = 0;
+	for (const char *at = list; *at && length + 2 < sizeof(text); at++) {
+		text[length++] = *at == ',' ? '\n' : *at;
+	}
+	text[length++] = '\n';
+	snprintf(path, sizeof(path), "%s/NativeAdrenoMetal.clients", folder);
+	int error = native_gpu_addon_write(path, (const uint8_t *)text, length, 0644, vfs_context_current());
+	printf("oneios-gpu-list: %s \"%s\": %s (%d)\n", path, list, error < 0 ? "unchanged" : error ? "not written" : "written", error);
+}
+#endif
