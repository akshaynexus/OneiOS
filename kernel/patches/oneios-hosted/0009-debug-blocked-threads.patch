+
+/*
+ * A debugging aid for a boot that waits: the kernel stack of every blocked thread, as link addresses of the image
+ * (subtract nothing: they are what kernel/prelink/unmapped.py and a symbol table take). Printed at each "Waiting on"
+ * of the root device search when the boot argument hosted_dump_threads=1 is given, and callable from anywhere.
+ * A thread with a continuation has no stack to walk and is left out.
+ */
+#include <kern/processor.h>
+void hosted_dump_blocked_threads(void);
+void
+hosted_dump_blocked_threads(void)
+{
+	thread_t t;
+	extern vm_offset_t vm_kernel_slide;
+
+	queue_iterate(&threads, t, thread_t, threads) {
+		if (t == current_thread() || t->kernel_stack == 0 || t->continuation != NULL) {
+			continue;
+		}
+		thread_kernel_state_t ks = thread_get_kernel_state(t);
+		uint64_t fp = ks->machine.ss.fp, lr = ks->machine.ss.lr;
+		printf("THR %p ev %p:", t, (void *)(uintptr_t)t->wait_event);
+		for (int i = 0; i < 16; i++) {
+			printf(" %llx", (unsigned long long)((uintptr_t)ptrauth_strip((void *)lr, ptrauth_key_return_address) - vm_kernel_slide));
+			if (fp < t->kernel_stack || fp >= t->kernel_stack + KERNEL_STACK_SIZE - 16) {
+				break;
+			}
+			lr = ((uint64_t *)fp)[1];
+			fp = ((uint64_t *)fp)[0];
+		}
+		printf("\n");
+	}
+}
