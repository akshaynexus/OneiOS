 	va &= ~(uint64_t)ARM_PGMASK;
+	hosted_check_prepare(pmap, va);
 	pmap_lock(pmap, PMAP_LOCK_SHARED);
 	uint32_t old = hosted_tlb_lock();
 	pt_entry_t pte = hosted_walk(pmap, va);
@@ -342,6 +630,9 @@ hosted_user_fill(pmap_t pmap, uint64_t va, uint32_t access)
 	    pmap->hosted_task != 0) {
 		filled = HPC(task_map, pmap->hosted_task, va, ARM_PGBYTES, prot, pte_to_pa(pte)) == 0;
 		hosted_pmap_stats.user_maps += filled;
+		if (filled && hosted_pa_in_window(pte_to_pa(pte))) {
+			hosted_check_filled(pmap, va, pte_to_pa(pte), prot);
+		}
 	}
 	hosted_tlb_unlock(old);
 	pmap_unlock(pmap, PMAP_LOCK_SHARED);
@@ -356,6 +647,7 @@ hosted_task_unmap_locked(pmap_t pmap, uint64_t va, uint64_t size)
 	if (pmap->hosted_task != 0) {
 		(void)HPC(task_unmap, pmap->hosted_task, va, size, 0, 0);
