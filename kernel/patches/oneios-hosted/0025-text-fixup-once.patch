 {
+	hosted_check_destroy(pmap);
 	uint32_t old = hosted_tlb_lock();
 	uint64_t task = pmap->hosted_task;
 	pmap->hosted_task = 0;
@@ -334,6 +621,7 @@ hosted_user_fill(pmap_t pmap, uint64_t va, uint32_t access)
 		return false;
