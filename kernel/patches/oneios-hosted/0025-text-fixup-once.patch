diff --git a/osfmk/arm64/hosted/hosted_text.c b/osfmk/arm64/hosted/hosted_text.c
new file mode 100644
index 0000000..2e5ccc6
--- /dev/null
+++ b/osfmk/arm64/hosted/hosted_text.c
@@ -0,0 +1,183 @@
+/*
+ * OneiOS: the host's text fixups, once per page of code (arm64/hosted/hosted.h explains the model).
+ *
+ * iOS code cannot run unchanged in a Linux task: it reads the thread's TSD base from TPIDRRO_EL0 and the CPU
+ * number from TPIDR_EL0, and where the host has no seccomp (qemu-user) its `svc #0x80` must become a
+ * trapping instruction. xnuhost's text_fixup host call rewrites those instructions in a page. Three rules
+ * follow from what that call is, and this file keeps them:
+ *
+ *  1. Code only. The call matches 32-bit patterns; in a page of data a matching word is data, and
+ *     rewriting it corrupts the file's contents for every process. So a page is fixed when it is first
+ *     entered into an address space with execute permission (vm_fault_enter_prepare), not when it is
+ *     validated: a signed file's data and link-edit pages are validated too.
+ *  2. Once. A second pass over a fixed page rewrites the rewritten instructions (the TSD read becomes a
+ *     zero). Each fixed page has a record: whose page it is (object, offset) and every word that changed,
+ *     before and after. A page whose record matches and whose words are the "after" ones is left alone.
+ *  3. The signature still checks. A fixed page no longer has the bytes its hash was made from, and XNU
+ *     validates a page again whenever it may have changed (after any UPL over it is committed: a read() of
+ *     the file, the first page of an executable at every exec). The second validation used to fail
+ *     ("Text page corruption detected", the process killed). vm_page_validate_cs_mapped_slow now asks for
+ *     the page as it was (hosted_text_original): a copy with the recorded words put back, which is what
+ *     gets hashed.
+ *
+ * A record is found by physical page number. Records of pages that were freed stay until the page number
+ * is fixed again; a stale one cannot match, because a page read in again has its original words.
+ */
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <kern/debug.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/misc_protos.h>
+#include <arm/pmap.h>
+#include <vm/pmap.h>
+#include <vm/vm_kern_xnu.h>
+#include <libkern/OSAtomic.h>
+#include <string.h>
+
+#if XNU_HOSTED
+
+#include <arm64/hosted/hosted.h>
+
+struct hosted_text_site {
+	uint16_t index;                 /* word in the page */
+	uint32_t original, fixed;
+};
+
+struct hosted_text_record {
+	struct hosted_text_record *next;
+	ppnum_t                    page;
+	uint32_t                   count;
+	const void                *object;      /* identity only, never dereferenced */
+	uint64_t                   offset;
+	struct hosted_text_site    sites[];
+};
+
+#define HOSTED_TEXT_BUCKETS 16384
+#define HOSTED_TEXT_WORDS   ((uint32_t)(PAGE_SIZE / sizeof(uint32_t)))
+#define HOSTED_TEXT_WORDS_MAX (16384 / sizeof(uint32_t))
+
+static LCK_GRP_DECLARE(hosted_text_grp, "hosted_text");
+static LCK_MTX_DECLARE(hosted_text_lock, &hosted_text_grp);
+static struct hosted_text_record *hosted_text_table[HOSTED_TEXT_BUCKETS];
+static uint32_t hosted_text_scratch[HOSTED_TEXT_WORDS_MAX] __attribute__((aligned(16)));
+
+struct hosted_text_stats {
+	uint64_t pages_fixed, pages_clean, words_fixed, already_fixed, originals, no_record_memory;
+} hosted_text_stats;
+
+static struct hosted_text_record **
+hosted_text_slot(ppnum_t page)
+{
+	struct hosted_text_record **slot = &hosted_text_table[page % HOSTED_TEXT_BUCKETS];
+
+	while (*slot != NULL && (*slot)->page != page) {
+		slot = &(*slot)->next;
+	}
+	return slot;
+}
+
+/* The page's record if it is this page's and the page holds what the fixup left. Lock held. */
+static struct hosted_text_record *
+hosted_text_fixed_record(ppnum_t page, const void *object, uint64_t offset, const uint32_t *words)
+{
+	struct hosted_text_record *record = *hosted_text_slot(page);
+
+	if (record == NULL || record->object != object || record->offset != offset) {
+		return NULL;
+	}
+	for (uint32_t i = 0; i < record->count; i++) {
+		if (words[record->sites[i].index] != record->sites[i].fixed) {
+			return NULL;            /* read in again since: its original words */
+		}
+	}
+	return record;
+}
+
+/*
+ * A page of `object` at `offset` is about to be entered with execute permission: the host's fixups, unless
+ * it has them. Returns the number of words changed now. Thread context, may block (a mutex, a host call).
+ */
+uint32_t
+hosted_text_fix_page(ppnum_t page, const void *object, uint64_t offset)
+{
+	uint32_t *words = (uint32_t *)phystokv(ptoa(page));
+	uint32_t  changed = 0;
+
+	lck_mtx_lock(&hosted_text_lock);
+	if (hosted_text_fixed_record(page, object, offset, words) != NULL) {
+		hosted_text_stats.already_fixed++;
+		lck_mtx_unlock(&hosted_text_lock);
+		return 0;
+	}
+	memcpy(hosted_text_scratch, words, PAGE_SIZE);
+	if (hosted_text_fixup(words, PAGE_SIZE) != 0) {
+		for (uint32_t i = 0; i < HOSTED_TEXT_WORDS; i++) {
+			changed += words[i] != hosted_text_scratch[i];
+		}
+	}
+	struct hosted_text_record *record = kalloc_data(sizeof(*record) + changed * sizeof(record->sites[0]), Z_WAITOK);
+	struct hosted_text_record **slot = hosted_text_slot(page);
+	struct hosted_text_record *old = *slot;
+	if (record != NULL) {
+		record->next = old != NULL ? old->next : NULL;
+		record->page = page;
+		record->count = changed;
+		record->object = object;
+		record->offset = offset;
+		for (uint32_t i = 0, n = 0; i < HOSTED_TEXT_WORDS && n < changed; i++) {
+			if (words[i] != hosted_text_scratch[i]) {
+				record->sites[n++] = (struct hosted_text_site){ .index = (uint16_t)i,
+					                                        .original = hosted_text_scratch[i], .fixed = words[i] };
+			}
+		}
+		*slot = record;
+	} else {
+		/* No record: the page is right to run, but its next validation will not know its original. */
+		hosted_text_stats.no_record_memory++;
+		if (old != NULL) {
+			*slot = old->next;
+		}
+	}
+	if (old != NULL) {
+		kfree_data(old, sizeof(*old) + old->count * sizeof(old->sites[0]));
+	}
+	if (changed != 0) {
+		hosted_text_stats.pages_fixed++;
+		hosted_text_stats.words_fixed += changed;
+	} else {
+		hosted_text_stats.pages_clean++;
+	}
+	lck_mtx_unlock(&hosted_text_lock);
+	return changed;
+}
+
+/*
+ * The page as its signature knows it. If the page (mapped at kaddr) carries the host's fixups, returns a
+ * copy with the original words, to be hashed instead, and keeps the lock until hosted_text_original_done();
+ * NULL if the page is as it was read (nothing to undo, nothing held).
+ */
+const void *
+hosted_text_original(ppnum_t page, const void *object, uint64_t offset, const void *kaddr)
+{
+	lck_mtx_lock(&hosted_text_lock);
+	struct hosted_text_record *record = hosted_text_fixed_record(page, object, offset, kaddr);
+	if (record == NULL || record->count == 0) {
+		lck_mtx_unlock(&hosted_text_lock);
+		return NULL;
+	}
+	memcpy(hosted_text_scratch, kaddr, PAGE_SIZE);
+	for (uint32_t i = 0; i < record->count; i++) {
+		hosted_text_scratch[record->sites[i].index] = record->sites[i].original;
+	}
+	hosted_text_stats.originals++;
+	return hosted_text_scratch;
+}
+
+void
+hosted_text_original_done(void)
+{
+	lck_mtx_unlock(&hosted_text_lock);
+}
+
+#endif /* XNU_HOSTED */
