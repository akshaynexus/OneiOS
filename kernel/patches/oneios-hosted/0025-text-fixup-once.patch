diff --git a/osfmk/arm64/hosted/hosted_pmap.h b/osfmk/arm64/hosted/hosted_pmap.h
index d38e080..669c3e3 100644
--- a/osfmk/arm64/hosted/hosted_pmap.h
+++ b/osfmk/arm64/hosted/hosted_pmap.h
@@ -272,6 +272,292 @@ hosted_kernel_enter(uint64_t va, uint64_t size)
 	hosted_tlb_unlock(old);
 }
 
+/* ---- debug: what every task has mapped in the host (boot-arg hosted_mapcheck=1) --------------- */
+
+/*
+ * The host mapping of a task is a TLB that nothing but this file fills and flushes. When a process sees a
+ * page it should not (another task's data, an old copy), the question is whether that TLB went stale. With
+ * hosted_mapcheck=1 every fill and flush is also recorded here, per pmap (va -> page, protection) and per
+ * page (how many task mappings), and three things are reported on the console ("hosted check:", printed
+ * at the next audit):
+ *   - a fill at an address that still had another page mapped: its entry changed with no flush between;
+ *   - a page freed by the VM while a task still has it mapped;
+ *   - (hosted_check_audit, called by hosted_user.c now and then and when a task traps on a brk) a mapping
+ *     that the task's page table no longer has, or has with less access.
+ * Costs memory (16 KiB per 16 MiB of a task's address space in use) and time: off unless asked for.
+ */
+static TUNABLE(bool, hosted_check_on, "hosted_mapcheck", false);
+extern int proc_selfpid(void);
+extern void delay(int usec);
+
+#define HOSTED_CHECK_LEAF_SHIFT 24
+#define HOSTED_CHECK_TOP        ((unsigned)(HOSTED_KERNEL_VA_MIN >> HOSTED_CHECK_LEAF_SHIFT))
+#define HOSTED_CHECK_LEAF       (1u << (HOSTED_CHECK_LEAF_SHIFT - 12))
+#define HOSTED_CHECK_PAGE(e)    (((e) & 0x0fffffffu) - 1)
+#define HOSTED_CHECK_PROT(e)    ((e) >> 28)
+
+struct hosted_check_top {
+	uint32_t *leaf[HOSTED_CHECK_TOP];       /* [va >> 24][(va >> 12) & 0xfff]: 0, or (page index + 1) | prot << 28 */
+};
+
+static uint8_t *hosted_check_counts;            /* per page of the RAM window: task mappings (255 sticks) */
+
+/*
+ * A finding is made with the TLB lock held or in a context that cannot print (interrupts masked): it is
+ * noted here and printed by hosted_check_report() from thread context.
+ */
+struct hosted_check_note {
+	uint8_t  kind;                          /* 1 replaced, 2 freed while mapped, 3 stale (audit) */
+	int32_t  pid;
+	uint64_t task, va, entry;
+	uint32_t had_page, had_prot, now_page, now_prot;
+};
+#define HOSTED_CHECK_NOTES 64
+static struct hosted_check_note hosted_check_notes[HOSTED_CHECK_NOTES];
+static uint32_t hosted_check_noted, hosted_check_printed;
+
+static void
+hosted_check_note(uint8_t kind, uint64_t task, uint64_t va, uint32_t had_page, uint32_t had_prot, uint32_t now_page, uint32_t now_prot, uint64_t entry)
+{
+	uint32_t n = os_atomic_inc_orig(&hosted_check_noted, relaxed);
+
+	if (n < HOSTED_CHECK_NOTES) {
+		hosted_check_notes[n] = (struct hosted_check_note){ .kind = kind, .pid = proc_selfpid(), .task = task, .va = va, .entry = entry,
+			                                            .had_page = had_page, .had_prot = had_prot, .now_page = now_page, .now_prot = now_prot };
+	}
+}
+
+/* Prints what was noted. Thread context, interrupts enabled, no lock held. */
+void hosted_check_report(void);
+void
+hosted_check_report(void)
+{
+	while (hosted_check_printed < HOSTED_CHECK_NOTES && hosted_check_printed < os_atomic_load(&hosted_check_noted, relaxed)) {
+		uint32_t n = os_atomic_inc_orig(&hosted_check_printed, relaxed);
+		if (n >= HOSTED_CHECK_NOTES) {
+			break;
+		}
+		const struct hosted_check_note *note = &hosted_check_notes[n];
+		if (note->kind == 1) {
+			printf("hosted check: task %llu (in pid %d) va 0x%llx: page 0x%x (prot %u) was still mapped when its entry became page 0x%x (prot %u): no flush between\n",
+			    note->task, note->pid, note->va, note->had_page, note->had_prot, note->now_page, note->now_prot);
+		} else if (note->kind == 2) {
+			printf("hosted check: page 0x%x is freed while %u task mapping(s) of it remain (pid %d frees it)\n",
+			    note->had_page, note->had_prot, note->pid);
+		} else {
+			printf("hosted check: audit: task %llu (in pid %d) va 0x%llx: the host maps page 0x%x prot %u, the page table has page 0x%x prot %u (entry 0x%llx)\n",
+			    note->task, note->pid, note->va, note->had_page, note->had_prot, note->now_page, note->now_prot, note->entry);
+		}
+	}
+}
+struct hosted_check_stats {
+	uint64_t fills, replaced, unmapped, freed_mapped, audits, stale;
+} hosted_check_stats;
+
+/* Before a fill, in thread context with no lock held: the tables the fill will write into. */
+static void
+hosted_check_prepare(pmap_t pmap, uint64_t va)
+{
+	if (!hosted_check_on || va >= HOSTED_KERNEL_VA_MIN) {
+		return;
+	}
+	if (hosted_check_counts == NULL) {
+		uint8_t *counts = kalloc_data(hosted_info.ram_size >> 12, Z_WAITOK | Z_ZERO);
+		if (counts != NULL && !os_atomic_cmpxchg(&hosted_check_counts, NULL, counts, relaxed)) {
+			kfree_data(counts, hosted_info.ram_size >> 12);
+		}
+	}
+	struct hosted_check_top *top = os_atomic_load(&pmap->hosted_check, relaxed);
+	if (top == NULL) {
+		top = kalloc_data(sizeof(*top), Z_WAITOK | Z_ZERO);
+		if (top != NULL && !os_atomic_cmpxchg(&pmap->hosted_check, NULL, top, relaxed)) {
+			kfree_data(top, sizeof(*top));
+		}
+		top = os_atomic_load(&pmap->hosted_check, relaxed);
+	}
+	if (top != NULL && top->leaf[va >> HOSTED_CHECK_LEAF_SHIFT] == NULL) {
+		uint32_t *leaf = kalloc_data(HOSTED_CHECK_LEAF * sizeof(uint32_t), Z_WAITOK | Z_ZERO);
+		if (leaf != NULL && !os_atomic_cmpxchg(&top->leaf[va >> HOSTED_CHECK_LEAF_SHIFT], NULL, leaf, relaxed)) {
+			kfree_data(leaf, HOSTED_CHECK_LEAF * sizeof(uint32_t));
+		}
+	}
+}
+
+static void
+hosted_check_count(uint32_t page, int by)
+{
+	if (hosted_check_counts != NULL && page < (hosted_info.ram_size >> 12) && hosted_check_counts[page] != 255) {
+		hosted_check_counts[page] = (uint8_t)(hosted_check_counts[page] + by);
+	}
+}
+
+/* task_map(va, one page, prot, pa) succeeded. TLB lock held. */
+static void
+hosted_check_filled(pmap_t pmap, uint64_t va, pmap_paddr_t pa, uint32_t prot)
+{
+	struct hosted_check_top *top = hosted_check_on ? pmap->hosted_check : NULL;
+	uint32_t *leaf = top != NULL && va < HOSTED_KERNEL_VA_MIN ? top->leaf[va >> HOSTED_CHECK_LEAF_SHIFT] : NULL;
+
+	if (leaf == NULL) {
+		return;
+	}
+	uint32_t page = (uint32_t)((pa - hosted_info.ram_phys) >> 12);
+	uint32_t *entry = &leaf[(va >> 12) & (HOSTED_CHECK_LEAF - 1)];
+	hosted_check_stats.fills++;
+	if (*entry != 0) {
+		if (HOSTED_CHECK_PAGE(*entry) != page) {
+			hosted_check_stats.replaced++;
+			hosted_check_note(1, pmap->hosted_task, va, HOSTED_CHECK_PAGE(*entry), HOSTED_CHECK_PROT(*entry), page, prot, 0);
+		}
+		hosted_check_count(HOSTED_CHECK_PAGE(*entry), -1);
+	}
+	*entry = (page + 1) | (prot << 28);
+	hosted_check_count(page, 1);
+}
+
+/* task_unmap(va, size) was given. TLB lock held. */
+static void
+hosted_check_unmapped(pmap_t pmap, uint64_t va, uint64_t size)
+{
+	struct hosted_check_top *top = hosted_check_on ? pmap->hosted_check : NULL;
+	uint64_t end = va + size;
+
+	if (top == NULL) {
+		return;
+	}
+	if (end > HOSTED_KERNEL_VA_MIN) {
+		end = HOSTED_KERNEL_VA_MIN;
+	}
+	while (va < end) {
+		uint64_t next = ((va >> HOSTED_CHECK_LEAF_SHIFT) + 1) << HOSTED_CHECK_LEAF_SHIFT;
+		uint32_t *leaf = top->leaf[va >> HOSTED_CHECK_LEAF_SHIFT];
+		if (next > end) {
+			next = end;
+		}
+		if (leaf != NULL) {
+			for (uint64_t at = va; at < next; at += 4096) {
+				uint32_t *entry = &leaf[(at >> 12) & (HOSTED_CHECK_LEAF - 1)];
+				if (*entry != 0) {
+					hosted_check_count(HOSTED_CHECK_PAGE(*entry), -1);
+					*entry = 0;
+					hosted_check_stats.unmapped++;
+				}
+			}
+		}
+		va = next;
+	}
+}
+
+/* The task is gone. No lock held. */
+static void
+hosted_check_destroy(pmap_t pmap)
+{
+	struct hosted_check_top *top = pmap->hosted_check;
+
+	if (top == NULL) {
+		return;
+	}
+	uint32_t old = hosted_tlb_lock();
+	hosted_check_unmapped(pmap, 0, HOSTED_KERNEL_VA_MIN);
+	pmap->hosted_check = NULL;
+	hosted_tlb_unlock(old);
+	for (unsigned i = 0; i < HOSTED_CHECK_TOP; i++) {
+		if (top->leaf[i] != NULL) {
+			kfree_data(top->leaf[i], HOSTED_CHECK_LEAF * sizeof(uint32_t));
+		}
+	}
+	kfree_data(top, sizeof(*top));
+}
+
+/* The VM frees a page (pmap_recycle_page): nobody may still have it mapped. Any context. */
+void hosted_check_page_free(ppnum_t pn);
+void
+hosted_check_page_free(ppnum_t pn)
+{
+	pmap_paddr_t pa = ptoa(pn);
+
+	if (!hosted_check_on || hosted_check_counts == NULL || !hosted_pa_in_window(pa)) {
+		return;
+	}
+	uint32_t page = (uint32_t)((pa - hosted_info.ram_phys) >> 12);
+	uint8_t count = hosted_check_counts[page];
+	if (count != 0 && count != 255) {
+		hosted_check_stats.freed_mapped++;
+		hosted_check_note(2, 0, 0, page, count, 0, 0, 0);
+	}
+}
+
+/* One recorded mapping against the page table. TLB lock and the pmap's lock held. True if the table allows it. */
+static bool
+hosted_check_entry(pmap_t pmap, uint64_t va, uint32_t recorded, bool note)
+{
+	pt_entry_t pte = hosted_walk(pmap, va);
+	uint32_t allowed = hosted_pte_prot(pte | ARM_PTE_AF, true);     /* a cleared reference bit leaves the TLB alone */
+	uint32_t page = hosted_pa_in_window(pte_to_pa(pte)) ? (uint32_t)((pte_to_pa(pte) - hosted_info.ram_phys) >> 12) : ~0u;
+
+	if (allowed != 0 && page == HOSTED_CHECK_PAGE(recorded) && !(HOSTED_CHECK_PROT(recorded) & ~allowed)) {
+		return true;
+	}
+	if (note) {
+		hosted_check_note(3, pmap->hosted_task, va, HOSTED_CHECK_PAGE(recorded), HOSTED_CHECK_PROT(recorded), page, allowed, (uint64_t)pte);
+	}
+	return false;
+}
+
+/*
+ * Every host mapping of the task against its page table. Thread context, no lock held. Returns the number
+ * of mappings the table does not allow. An entry is changed first and flushed a moment later (for a range,
+ * after the whole range), so a mapping that disagrees is looked at again 2 ms later, and only one that
+ * still disagrees then counts.
+ */
+unsigned hosted_check_audit(pmap_t pmap, const char *why);
+unsigned
+hosted_check_audit(pmap_t pmap, const char *why)
+{
+	uint64_t suspects[16];
+	unsigned suspected = 0, stale = 0;
+
+	if (!hosted_check_on || pmap == NULL || pmap->hosted_check == NULL) {
+		return 0;
+	}
+	pmap_lock(pmap, PMAP_LOCK_SHARED);
+	uint32_t old = hosted_tlb_lock();
+	struct hosted_check_top *top = pmap->hosted_check;
+	hosted_check_stats.audits++;
+	for (unsigned i = 0; top != NULL && i < HOSTED_CHECK_TOP; i++) {
+		const uint32_t *leaf = top->leaf[i];
+		for (unsigned j = 0; leaf != NULL && j < HOSTED_CHECK_LEAF; j++) {
+			uint64_t va = ((uint64_t)i << HOSTED_CHECK_LEAF_SHIFT) | ((uint64_t)j << 12);
+			if (leaf[j] != 0 && !hosted_check_entry(pmap, va, leaf[j], false) && suspected < 16) {
+				suspects[suspected++] = va;
+			}
+		}
+	}
+	hosted_tlb_unlock(old);
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	if (suspected != 0) {
+		delay(2000);
+		pmap_lock(pmap, PMAP_LOCK_SHARED);
+		old = hosted_tlb_lock();
+		top = pmap->hosted_check;
+		for (unsigned k = 0; top != NULL && k < suspected; k++) {
+			const uint32_t *leaf = top->leaf[suspects[k] >> HOSTED_CHECK_LEAF_SHIFT];
+			uint32_t recorded = leaf != NULL ? leaf[(suspects[k] >> 12) & (HOSTED_CHECK_LEAF - 1)] : 0;
+			if (recorded != 0 && !hosted_check_entry(pmap, suspects[k], recorded, true)) {
+				stale++;
+			}
+		}
+		hosted_check_stats.stale += stale;
+		hosted_tlb_unlock(old);
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	}
+	if (stale != 0) {
+		printf("hosted check: %s: %u of pid %d's host mappings are not what its page table says\n", why, stale, proc_selfpid());
+	}
+	hosted_check_report();
+	return stale;
+}
+
