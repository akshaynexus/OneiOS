+#endif
 
 			/* ubc_blob_add() has consumed "kernel_blob_addr" if it is zeroed */
 			if (error) {
@@ -4449,6 +4478,9 @@
 #if CONFIG_MACF
 		error = mac_file_check_library_validation(p, fg, lv.lv_file_start,
 		    (user_long_t)lv.lv_error_message, lv.lv_error_message_size);
+#if XNU_HOSTED
