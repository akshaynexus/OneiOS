 /*
+ * 0046, oneios-fault-around=N (pages; 0 or 1 = off, the default; at most 16): after a fill, the other pages of the
+ * N-page aligned window around it whose entries already allow access are mapped too, with what their entries allow.
+ * A TLB may hold any entry the tables allow (hardware fetches ahead the same way), and the flush rule is unchanged:
+ * every one of them is mapped under the pmap's TLB word, after its entry was read, so a later change of an entry is
+ * followed by a flush that unmaps it. Entries waiting for their reference fault (no AF) are left: that fault is the
+ * VM's. Only pages of the RAM window, not the GPU pool. On the first phone boot about half the faults were fills of
+ * entries that already allowed the access; each costs a trap and a release, a fault-around map one mmap in the task.
+ */
+static TUNABLE(uint32_t, hosted_fault_around, "oneios-fault-around", 0);
+
+/* The neighbours of a filled page. The pmap's lock (shared) and its TLB word held. */
+static void
+hosted_fill_around_locked(pmap_t pmap, uint64_t va)
+{
+	uint32_t window = hosted_fault_around > 16 ? 16 : hosted_fault_around;
+	if (window < 2 || (window & (window - 1)) != 0) {
+		return;
+	}
+	uint64_t span = (uint64_t)window * ARM_PGBYTES, base = va & ~(span - 1);
+	for (uint64_t at = base; at < base + span; at += ARM_PGBYTES) {
+		if (at == va || at >= hosted_info.user_va_limit) {
+			continue;
+		}
+		pt_entry_t pte = hosted_walk(pmap, at);
+		uint32_t prot = hosted_pte_prot(pte, true);
+		if (prot == 0 || !hosted_pa_in_window(pte_to_pa(pte))) {
+			continue;
+		}
+		hosted_nested_mark(pmap, at);
+		if (HPC(task_map, pmap->hosted_task, at, ARM_PGBYTES, prot, pte_to_pa(pte)) == 0) {
+			os_atomic_inc(&hosted_fault_around_maps, relaxed);
+			hosted_check_filled(pmap, at, pte_to_pa(pte), prot);
+		}
+	}
+}
+
+/*
  * A user fault at va in pmap: fill it from the tables if they allow `access`. Thread context, no locks held.
  * The pmap's lock keeps its table pages while they are walked.
  */
@@ -763,6 +801,9 @@
 		os_atomic_add(&hosted_pmap_stats.user_maps, filled, relaxed);
 		if (filled && hosted_pa_in_window(pte_to_pa(pte))) {
 			hosted_check_filled(pmap, va, pte_to_pa(pte), prot);
+		}
+		if (filled) {
+			hosted_fill_around_locked(pmap, va);    /* 0046 */
 		}
 	}
 	hosted_utlb_unlock(pmap, old);
