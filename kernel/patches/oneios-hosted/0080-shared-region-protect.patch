+/*
+ * 0080, oneios-top=N (default 6; 0 = off; only with oneios-perf): the N processes whose traps took the kernel most time
+ * in each oneios-perf period, one `oneios-top:` line each: their traps and kernel time, the faults that went to
+ * vm_fault and the fills from the tables, the host unmap orders of their own address space made in their own context,
+ * their most used system calls and Mach traps, and their vm_protect calls (those in the shared region, and the
+ * shared-region unnests they caused). oneios-perf says how much; this says who. A slot per process (by pid), claimed at
+ * its first trap of the period; the report takes the table and clears it. Counters of a slot reclaimed during the
+ * report may go to the next period: a report, not an exact sum.
+ */
+#define HOSTED_TOP_SLOTS 256
+#define HOSTED_TOP_CALLS 16
+struct hosted_top_slot {
+	int32_t  pid;                           /* 0: free */
+	char     name[20];
+	uint64_t traps, ticks;                  /* every trap counted by oneios-perf, and its time */
+	uint64_t vm_faults, vm_fault_ticks, fills, unmaps;
+	uint64_t protects, sr_protects, unnests;
+	uint32_t call[HOSTED_TOP_CALLS];        /* kind << 16 | number, + 1; 0: free */
+	uint64_t call_n[HOSTED_TOP_CALLS], call_t[HOSTED_TOP_CALLS];
+	uint64_t sr_pc, sr_lr, sr_prot;         /* the last shared-region vm_protect: where the call came from */
+};
+static struct hosted_top_slot hosted_top[HOSTED_TOP_SLOTS];
+static uint32_t hosted_top_lines = 6;
+static uint64_t hosted_top_unnests, hosted_top_sr_protects, hosted_top_sr_noops;
+
+struct proc;
+extern int proc_pid(struct proc *);
+extern const char *proc_best_name(struct proc *);
+
+/* The slot of the current thread's process; NULL for the kernel's threads, when off, or when the table is full. */
+static struct hosted_top_slot *
+hosted_top_slot(void)
+{
+	if (hosted_top_lines == 0 || hosted_perf_every == 0) {
+		return NULL;
+	}
+	task_t task = current_task();
+	struct proc *p = task != TASK_NULL && task != kernel_task ? (struct proc *)get_bsdtask_info(task) : NULL;
+	int32_t pid = p != NULL ? proc_pid(p) : 0;
+	if (pid <= 0) {
+		return NULL;
+	}
+	unsigned h = ((uint32_t)pid * 2654435761u) % HOSTED_TOP_SLOTS;
+	for (unsigned i = 0; i < 16; i++) {
+		struct hosted_top_slot *s = &hosted_top[(h + i) % HOSTED_TOP_SLOTS];
+		int32_t now = os_atomic_load(&s->pid, relaxed);
+		if (now == pid) {
+			return s;
+		}
+		if (now == 0 && os_atomic_cmpxchg(&s->pid, 0, pid, relaxed)) {
+			strlcpy(s->name, proc_best_name(p), sizeof(s->name));
+			return s;
+		}
+	}
+	return NULL;
+}
+
+static void
+hosted_top_call(struct hosted_top_slot *s, uint32_t key, uint64_t ticks)
+{
+	for (unsigned i = 0; i < HOSTED_TOP_CALLS; i++) {
+		uint32_t now = os_atomic_load(&s->call[i], relaxed);
+		if (now == 0 && !os_atomic_cmpxchg(&s->call[i], 0u, key, relaxed)) {
+			now = os_atomic_load(&s->call[i], relaxed);
+		} else if (now == 0) {
+			now = key;
+		}
+		if (now == key) {
+			os_atomic_inc(&s->call_n[i], relaxed);
+			os_atomic_add(&s->call_t[i], ticks, relaxed);
+			return;
+		}
+	}
+}
+
+/* hosted_pmap.h: a host unmap order for pmap's task (own: the pmap is the current thread's) */
+void hosted_top_note_unmap(pmap_t pmap);
+void
+hosted_top_note_unmap(pmap_t pmap)
+{
+	if (current_task() != kernel_task && pmap == get_task_pmap(current_task())) {
+		struct hosted_top_slot *s = hosted_top_slot();
+		if (s != NULL) {
+			os_atomic_inc(&s->unmaps, relaxed);
+		}
+	}
+}
