+/*
+ * The process's CPU (user and system, TASK_POWER_INFO) since the last report that printed it, as a percentage of one
+ * vCPU over wall_us; -1 the first time (the PC has no oneios-cpu lines: the GPU archive prints them with 3D only).
+ */
+static int
+hosted_top_cpu(int32_t pid, uint64_t wall_us)
+{
+	static struct { int32_t pid; uint64_t mach; } seen[HOSTED_TOP_SLOTS];
+	struct proc *p = proc_find(pid);
+	if (p == NULL) {
+		return -1;
+	}
+	struct task_power_info info = {};
+	mach_msg_type_number_t count = TASK_POWER_INFO_COUNT;
+	task_t task = proc_task(p);
+	kern_return_t kr = task != TASK_NULL ? task_info(task, TASK_POWER_INFO, (task_info_t)&info, &count) : KERN_FAILURE;
+	proc_rele(p);
+	if (kr != KERN_SUCCESS) {
+		return -1;
+	}
+	uint64_t mach = info.total_user + info.total_system;
+	unsigned slot = ((uint32_t)pid * 2654435761u) % HOSTED_TOP_SLOTS;
+	int percent = -1;
+	if (seen[slot].pid == pid && mach >= seen[slot].mach) {
+		percent = (int)(hosted_perf_us(mach - seen[slot].mach) * 100 / (wall_us ? wall_us : 1));
+	}
+	seen[slot].pid = pid;
+	seen[slot].mach = mach;
+	return percent;
+}
