+/*
+ * vm_map.c's vm_map_protect: a user call on its own map. The first 24 in the shared region of each boot are printed
+ * with where they came from (saved pc and lr, then four return addresses up the frame pointers: oneios-tool sym names
+ * them), as `oneios-srprot:` lines; noop says that 0080 found nothing to change and so left the region nested.
+ */
+extern bool hosted_shared_region_ready;
+
+void hosted_top_note_protect(vm_map_t map, uint64_t start, uint64_t end, uint32_t prot, bool set_max, bool noop);
+void
+hosted_top_note_protect(vm_map_t map, uint64_t start, uint64_t end, uint32_t prot, bool set_max, bool noop)
+{
+	static uint32_t printed;
+	if (!hosted_shared_region_ready || current_task() == kernel_task || map != current_map()) {
+		return;
+	}
+	struct hosted_top_slot *s = hosted_top_slot();
+	bool sr = start < SHARED_REGION_BASE_ARM64 + SHARED_REGION_SIZE_ARM64 && end > SHARED_REGION_BASE_ARM64;
+	arm_saved_state_t *state = get_user_regs(current_thread());
+	if (s != NULL) {
+		os_atomic_inc(&s->protects, relaxed);
+	}
+	if (!sr) {
+		return;
+	}
+	os_atomic_inc(noop ? &hosted_top_sr_noops : &hosted_top_sr_protects, relaxed);
+	uint64_t pc = state ? get_saved_state_pc(state) & 0x7fffffffffffULL : 0;
+	uint64_t lr = state ? get_saved_state_lr(state) & 0x7fffffffffffULL : 0;
+	if (s != NULL) {
+		os_atomic_inc(&s->sr_protects, relaxed);
+		s->sr_pc = pc;
+		s->sr_lr = lr;
+		s->sr_prot = prot | (set_max ? 0x100 : 0) | (noop ? 0x200 : 0);
+	}
+	if (os_atomic_inc_orig(&printed, relaxed) >= 24 || state == NULL || !ml_get_interrupts_enabled() ||
+	    get_preemption_level() != 0) {
+		return;
+	}
+	char line[4 * 16 + 1];
+	unsigned used = 0;
+	uint64_t fp = get_saved_state_fp(state);
+	line[0] = 0;
+	for (int depth = 0; depth < 4 && fp != 0 && (fp & 7) == 0; depth++) {
+		uint64_t pair[2];
+		if (vm_map_read_user(current_map(), (vm_map_address_t)fp, pair, sizeof(pair)) != KERN_SUCCESS) {
+			break;
+		}
+		used += (unsigned)snprintf(line + used, sizeof(line) - used, " 0x%llx", pair[1] & 0x7fffffffffffULL);
+		if (pair[0] <= fp) {
+			break;
+		}
+		fp = pair[0];
+	}
+	struct proc *p = (struct proc *)get_bsdtask_info(current_task());
+	printf("oneios-srprot: %s[%d] vm_protect 0x%llx-0x%llx prot 0x%x%s%s in the shared region: pc 0x%llx lr 0x%llx, frames%s\n",
+	    p ? proc_best_name(p) : "?", p ? proc_pid(p) : 0, start, end, prot, set_max ? " (max)" : "",
+	    noop ? " changes nothing: left nested" : "", pc, lr, line);
+}
+
