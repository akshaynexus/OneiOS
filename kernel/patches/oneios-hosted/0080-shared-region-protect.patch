+/* 0080: the processes of the period by the kernel's time on their traps (oneios-top), and the shared region's line */
+extern void hosted_pmap_protect_stats(uint64_t out[2]);
+static struct hosted_top_slot hosted_top_copy[HOSTED_TOP_SLOTS];
+extern struct proc *proc_find(int);
