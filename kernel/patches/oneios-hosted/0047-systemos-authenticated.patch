 static volatile int oneios_app_cryptex_known;    /* set once, before launchd's first exec, then read only */
+
+/*
+ * OneiOS hosted (0047): the SystemOS volume (the OS cryptex, systemos.img) answers the same. Its programs that carry a
+ * self launch constraint of their own in the code signature (SafariConfigurationSubscriber.xpc of SafariFoundation:
+ * on-system-volume or on-authorized-authapfs-volume, and validation-category 1) failed it with "c[4]p[1]m[1]e[0]" and
+ * were killed at each launch: the volume is the upper layer of the root union, not the root mount itself (MNT_ROOTFS
+ * stays with os.img), and APFS cannot authorize it without a personalized manifest. native_owner_cache_prepare
+ * (kern_exec.c) names the mount once it has checked it: read-only, APFS, on the device the image set names, which
+ * xnuhost verifies chunk by chunk (the same check the App volume gets below).
+ */
+static fsid_t oneios_systemos_fsid;
+static volatile int oneios_systemos_known;       /* set once, before launchd's first exec, then read only */
+
+void oneios_systemos_verified(mount_t mp);
+void
+oneios_systemos_verified(mount_t mp)
+{
+	if (mp == NULL || !(vfs_flags(mp) & MNT_RDONLY)) {
+		return;
+	}
+	oneios_systemos_fsid = vfs_statfs(mp)->f_fsid;
+	oneios_systemos_known = 1;
+}
+
+static bool
+oneios_fsid_is(mount_t mp, const fsid_t *want)
+{
+	fsid_t *fsid = &vfs_statfs(mp)->f_fsid;
+	return fsid->val[0] == want->val[0] && fsid->val[1] == want->val[1];
+}
 
