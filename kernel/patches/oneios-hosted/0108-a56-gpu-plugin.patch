  */
 extern void oneios_gpu_plugin_client_list(char *, size_t) __attribute__((weak_import));
+/*
+ * 0108 (a56-gpu, 2026-11-24): the plug-in is the one the published accelerator names (the GPU archive's
+ * oneios_gpu_metal_plugin, OneiOSAdreno.cpp): NativeAdrenoMetal as before, OneiOSRadeonMetal on the Galaxy A56's
+ * accelerator (oneios-gpu-amd=1 on an AMDGPU capset, docs/a56-gpu.md 5). Its list is written beside its bundle, and for
+ * the A56's one line says whether Metal can see the bundle (0031's stage 5 looks for NativeAdrenoMetal's alone):
+ *   oneios-gpu-addon: /System/Library/Extensions/OneiOSRadeonMetal.bundle/Info.plist (the accelerator's MetalPluginName): visible (0)
+ */
+extern const char *oneios_gpu_metal_plugin(void) __attribute__((weak_import));
+static const char *
+oneios_gpu_plugin_name(void)
+{
+	return oneios_gpu_metal_plugin ? oneios_gpu_metal_plugin() : "NativeAdrenoMetal";
+}
+static void
+oneios_gpu_plugin_visible(void)
+{
+	const char *name = oneios_gpu_plugin_name();
+	char path[128];
+	vnode_t vp = NULLVP;
+	if (!strcmp(name, "NativeAdrenoMetal")) {
+		return;
+	}
+	snprintf(path, sizeof(path), "/System/Library/Extensions/%s.bundle/Info.plist", name);
+	int error = vnode_lookup(path, 0, &vp, vfs_context_current());
+	if (!error) {
+		vnode_put(vp);
+	}
+	printf("oneios-gpu-addon: %s (the accelerator's MetalPluginName): %s (%d)\n", path,
+	    error ? "not there: Metal finds no plug-in and every process draws on the CPU" : "visible", error);
+}
