+#if XNU_HOSTED
+/*
+ * OneiOS hosted (0062), a debugging aid: how a named process looks for its hardware. Boot argument
+ * oneios-iokit=NAME[,NAME...] (the process's short name); without it bluetoothd and BlueTool are traced
+ * (oneios-iokit=- traces nothing). One line per distinct request of a process: a matching lookup, a matching
+ * notification, a registry path, a property read (by name and plane), a user client open, a kernel control looked up
+ * by name; again when its answer changes and at the 16th, 64th, 256th, ... asking (a polling loop shows), at most 800:
+ *   oneios-iokit: bluetoothd[74] match {IONameMatch=bluetooth} -> AppleARMIODevice "bluetooth"
+ *   oneios-iokit: bluetoothd[74] property "transport-encoding" (IODeviceTree, recursive) of "bluetooth" -> found (call 1)
+ *   oneios-iokit: bluetoothd[74] match {IONameMatch=AppleOLYHAL} -> none (call 16)
+ * The question it answers: what a daemon that never opens its transport looked for and did not find.
+ */
+static char hosted_iokit_names[128];
+static int hosted_iokit_state = -1;
+static uint32_t hosted_iokit_lines;
+struct hosted_iokit_entry { uint64_t key; uint32_t calls; int32_t last; };
+static struct hosted_iokit_entry hosted_iokit_table[1024];
+
+static bool
+hosted_iokit_traced(char *name, size_t size)
+{
+	if (hosted_iokit_state < 0) {
+		if (!PE_parse_boot_argn("oneios-iokit", hosted_iokit_names, sizeof(hosted_iokit_names))) {
+			strlcpy(hosted_iokit_names, "bluetoothd,BlueTool", sizeof(hosted_iokit_names));
+		}
+		hosted_iokit_state = hosted_iokit_names[0] && strcmp(hosted_iokit_names, "-") && strcmp(hosted_iokit_names, "0");
+	}
+	if (hosted_iokit_state == 0) {
+		return false;
+	}
+	name[0] = 0;
+	proc_name(proc_selfpid(), name, (int)size);
+	size_t length = strlen(name);
+	for (const char *at = hosted_iokit_names; *at;) {
+		const char *end = strchr(at, ',');
+		size_t n = end ? (size_t)(end - at) : strlen(at);
+		if (n == length && !strncmp(at, name, n)) {
+			return true;
+		}
+		at += n + (end ? 1 : 0);
+	}
+	return false;
+}
+
+/* The request's text (without its answer) and its answer: a line when it is new, when the answer changed, or at the
+ * 16th, 64th, 256th, ... asking. A racy table is fine: a lost count or a doubled line at worst. */
+static void
+hosted_iokit_say(const char *name, const char *request, int answer, const char *answer_text)
+{
+	uint64_t key = 1469598103934665603ULL ^ (uint64_t)proc_selfpid();
+	for (const char *c = request; *c; c++) {
+		key = (key ^ (uint8_t)*c) * 1099511628211ULL;
+	}
+	struct hosted_iokit_entry *e = NULL;
+	for (unsigned i = 0; i < 1024; i++) {
+		struct hosted_iokit_entry *t = &hosted_iokit_table[(key + i) % 1024];
+		if (t->key == key || t->key == 0) {
+			if (t->key == 0) {
+				t->key = key; t->calls = 0; t->last = ~answer;
+			}
+			e = t;
+			break;
+		}
+	}
+	uint32_t calls = e ? ++e->calls : 1;
+	bool say = e == NULL || e->last != answer || (calls >= 16 && (calls & (calls - 1)) == 0 && (__builtin_ctz(calls) & 1) == 0);
+	if (e) {
+		e->last = answer;
+	}
+	if (say && hosted_iokit_lines < 800) {
+		hosted_iokit_lines++;
+		IOLog("oneios-iokit: %s[%d] %s -> %s (call %u)\n", name, proc_selfpid(), request, answer_text, calls);
+	}
+}
+
+/* A matching dictionary in one line: string values as they are, numbers, nested dictionaries one level. */
+static void
+hosted_iokit_dict(const OSDictionary *dict, char *out, size_t size, int depth)
+{
+	OSCollectionIterator *iter = dict ? OSCollectionIterator::withCollection(dict) : NULL;
+	strlcat(out, "{", size);
+	bool first = true;
+	if (iter) {
+		const OSSymbol *key;
+		while ((key = OSDynamicCast(OSSymbol, iter->getNextObject())) && strlen(out) + 8 < size) {
+			OSObject *v = dict->getObject(key);
+			char value[96] = "?";
+			OSString *s;
+			OSNumber *n;
+			OSDictionary *d;
+			OSData *data;
+			if (!first) {
+				strlcat(out, " ", size);
+			}
+			first = false;
+			strlcat(out, key->getCStringNoCopy(), size);
+			strlcat(out, "=", size);
+			if ((s = OSDynamicCast(OSString, v))) {
+				strlcpy(value, s->getCStringNoCopy(), sizeof(value));
+			} else if ((n = OSDynamicCast(OSNumber, v))) {
+				snprintf(value, sizeof(value), "%llu", n->unsigned64BitValue());
+			} else if (OSDynamicCast(OSBoolean, v)) {
+				strlcpy(value, v == kOSBooleanTrue ? "true" : "false", sizeof(value));
+			} else if ((data = OSDynamicCast(OSData, v))) {
+				snprintf(value, sizeof(value), "<%u bytes>", data->getLength());
+			} else if ((d = OSDynamicCast(OSDictionary, v)) && depth == 0) {
+				hosted_iokit_dict(d, out, size, 1);
+				value[0] = 0;
+			} else if (OSDynamicCast(OSArray, v)) {
+				snprintf(value, sizeof(value), "[%u]", OSDynamicCast(OSArray, v)->getCount());
+			}
+			strlcat(out, value, size);
+		}
+		iter->release();
+	}
+	strlcat(out, "}", size);
+}
+
+static void
+hosted_iokit_service_text(IORegistryEntry *entry, char *out, size_t size)
+{
+	if (!entry) {
+		strlcpy(out, "none", size);
+		return;
+	}
+	snprintf(out, size, "%s \"%s\"", entry->getMetaClass()->getClassName(), entry->getName() ? entry->getName() : "?");
+}
+
+static void
+hosted_iokit_match(const char *what, const OSDictionary *dict, IORegistryEntry *found, IOReturn ret)
+{
+	char name[33];
+	if (!hosted_iokit_traced(name, sizeof(name))) {
+		return;
+	}
+	char request[320], answer[96];
+	strlcpy(request, what, sizeof(request));
+	strlcat(request, " ", sizeof(request));
+	hosted_iokit_dict(dict, request, sizeof(request), 0);
+	if (ret != kIOReturnSuccess && !found) {
+		snprintf(answer, sizeof(answer), "none (0x%x)", ret);
+	} else {
+		hosted_iokit_service_text(found, answer, sizeof(answer));
+	}
+	hosted_iokit_say(name, request, found ? (int)(uintptr_t)found->getRegistryEntryID() : -1 - (ret != kIOReturnSuccess), answer);
+}
+
+static void
+hosted_iokit_path(const char *path, IORegistryEntry *found)
+{
+	char name[33];
+	if (!hosted_iokit_traced(name, sizeof(name))) {
+		return;
+	}
+	char request[320], answer[96];
+	snprintf(request, sizeof(request), "path \"%s\"", path);
+	hosted_iokit_service_text(found, answer, sizeof(answer));
+	hosted_iokit_say(name, request, found ? 1 : 0, answer);
+}
+
+static void
+hosted_iokit_property(io_object_t object, const char *plane, const char *property, uint32_t options, kern_return_t ret)
+{
+	char name[33];
+	if (!hosted_iokit_traced(name, sizeof(name))) {
+		return;
+	}
+	IORegistryEntry *entry = OSDynamicCast(IORegistryEntry, object);
+	char request[320], where[96], answer[48];
+	hosted_iokit_service_text(entry, where, sizeof(where));
+	snprintf(request, sizeof(request), "property \"%s\" (%s%s) of %s", property, plane && plane[0] ? plane : "no plane",
+	    (options & kIORegistryIterateRecursively) ? ", recursive" : "", where);
+	if (ret == kIOReturnSuccess) {
+		strlcpy(answer, "found", sizeof(answer));
+	} else {
+		snprintf(answer, sizeof(answer), "not found (0x%x)", ret);
+	}
+	hosted_iokit_say(name, request, ret, answer);
+}
+
+static void
+hosted_iokit_open(io_object_t object, uint32_t type, IOReturn ret)
+{
+	char name[33];
+	if (!hosted_iokit_traced(name, sizeof(name))) {
+		return;
+	}
+	char request[160], where[96], answer[32];
+	hosted_iokit_service_text(OSDynamicCast(IORegistryEntry, object), where, sizeof(where));
+	snprintf(request, sizeof(request), "open %s type %u", where, type);
+	snprintf(answer, sizeof(answer), "0x%x", ret);
+	hosted_iokit_say(name, request, ret, answer);
+}
+
+extern "C" void hosted_iokit_ctl_lookup(const char *control, int error, uint32_t id);
+extern "C" void
+hosted_iokit_ctl_lookup(const char *control, int error, uint32_t id)
+{
+	char name[33];
+	if (!hosted_iokit_traced(name, sizeof(name))) {
+		return;
+	}
+	char request[160], answer[48];
+	snprintf(request, sizeof(request), "kernel control \"%.96s\"", control);
+	if (error) {
+		snprintf(answer, sizeof(answer), "not registered (errno %d)", error);
+	} else {
+		snprintf(answer, sizeof(answer), "id %u", id);
+	}
+	hosted_iokit_say(name, request, error, answer);
+}
