 				if (apps != NULL) {
-					oneios_ls_apps_list(apps);
+					oneios_ls_apps_list(apps, keep_mode == 3);
 					snprintf(path, 256, "%s/%s/Library/Caches/%s", parents[k], containers[i], files[largest_file]);
 					named = oneios_ls_apps_named(apps, path, &size, ctx);
 					keep = apps->count != 0 && named == (int)apps->count;
@@ -9769,7 +9787,7 @@
 				printf("oneios-ls: %s/%s: %lld bytes, names %d of %u apps of /Applications: %s\n", containers[i], files[largest_file],
 				    (long long)largest, named, apps != NULL ? apps->count : 0,
 				    keep ? (keep_mode == 1 ? "kept (oneios-ls-keep=1)" : "kept") :
-				    keep_mode == 2 ? "dropped (lsd rebuilds it and registers every app again)" : "dropped");
+				    keep_mode >= 2 ? "dropped (lsd rebuilds it and registers every app again)" : "dropped");
 				if (apps != NULL) {
 					kfree_data(apps, sizeof(struct oneios_ls_apps));
 				}
