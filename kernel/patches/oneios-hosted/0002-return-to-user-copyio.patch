@@ -386,15 +386,54 @@ hosted_tlb_flush_pmap(pmap_t pmap)
 
 /* ---- copyin / copyout ------------------------------------------------------------------------ */
 
+/*
+ * The window address of user page `uaddr` if the tables allow `need` there; NULL if not. Called with the
+ * pmap's lock and the TLB lock held: the address is good until they are released (whoever takes the page
+ * away from the address space flushes after changing the entry, and so waits for the TLB lock).
+ */
+static uint8_t *
+hosted_user_window_locked(pmap_t pmap, uint64_t uaddr, uint32_t need)
+{
+	pt_entry_t pte = hosted_walk(pmap, uaddr);
+	uint32_t prot = hosted_pte_prot(pte, true);
+
+	if (prot == 0 || (need & ~prot) || !hosted_pa_in_window(pte_to_pa(pte))) {
+		return NULL;
+	}
+	return (uint8_t *)phystokv(pte_to_pa(pte)) + (uaddr & ARM_PGMASK);
+}
+
+/*
+ * The pmap's lock for a copy. A caller that has interrupts masked only tries: the holder may be the
+ * context this one interrupted.
+ */
+static bool
+hosted_copy_lock(pmap_t pmap)
+{
+	if (hosted_irq_masked()) {
+		return pmap_try_lock(pmap, PMAP_LOCK_SHARED);
+	}
+	pmap_lock(pmap, PMAP_LOCK_SHARED);
+	return true;
+}
+
