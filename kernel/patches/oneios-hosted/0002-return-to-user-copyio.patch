diff --git a/osfmk/arm64/hosted/hosted_copyio.c b/osfmk/arm64/hosted/hosted_copyio.c
new file mode 100644
index 0000000..acbaf3a
--- /dev/null
+++ b/osfmk/arm64/hosted/hosted_copyio.c
@@ -0,0 +1,262 @@
+/*
+ * OneiOS: copyin / copyout of the hosted kernel (arm64/hosted/hosted.h explains the model).
+ *
+ * On hardware the copyio primitives (_bcopyin and friends, machine_routines_asm.s) load and store through
+ * the user half of the address space, and a fault in them is recovered through the copyio recovery table.
+ * Here an iOS task's memory is not in the kernel's address space at all: it is another Linux process. But
+ * every user page is a page of the RAM window, so a copy is a walk of the task's page table and a memcpy
+ * on the window (hosted_copy_user_pages, hosted_pmap.h). Where the table does not allow the access, the
+ * fault is resolved the way handle_kernel_abort would (arm_fast_fault, then vm_fault) and the copy goes
+ * on; a fault that cannot be resolved is EFAULT. Kernel code never dereferences a user address, so no
+ * kernel fault and no recovery entry is involved.
+ *
+ * osfmk/arm64/copyio.c keeps all of its validation and reaches these through WRAP_COPYIO.
+ */
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <kern/thread.h>
+#include <kern/task.h>
+#include <kern/debug.h>
+#include <kern/startup.h>
+#include <kern/misc_protos.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/machine_routines.h>
+#include <arm/misc_protos.h>
+#include <arm/pmap.h>
+#include <sys/errno.h>
+#include <vm/pmap.h>
+#include <vm/vm_fault.h>
+#include <vm/vm_map_xnu.h>
+#include <string.h>
+
+#if XNU_HOSTED
+
+#include <arm64/hosted/hosted.h>
+
+extern kern_return_t arm_fast_fault(pmap_t, vm_map_address_t, vm_prot_t, bool, bool);
+
+int hosted_bcopyin(const user_addr_t src, char *dst, vm_size_t len);
+int hosted_bcopyinstr(const user_addr_t src, char *dst, vm_size_t max, vm_size_t *actual);
+int hosted_bcopyout(const char *src, user_addr_t dst, vm_size_t len);
+int hosted_copyin_atomic32(const user_addr_t src, uint32_t *dst);
+int hosted_copyin_atomic32_wait_if_equals(const user_addr_t src, uint32_t value);
+int hosted_copyin_atomic64(const user_addr_t src, uint64_t *dst);
+int hosted_copyout_atomic32(uint32_t u32, user_addr_t dst);
+int hosted_copyout_atomic64(uint64_t u64, user_addr_t dst);
+
+struct hosted_copyio_stats {
+	uint64_t copies, faults, unresolved;
+} hosted_copyio_stats;
+
+/* The same fault on the same page this many times in a row is not going to resolve (device memory). */
+#define HOSTED_COPYIO_RETRIES 8
+
+/*
+ * The page table of `map` does not allow `prot` at va: what handle_kernel_abort does for a fault of a
+ * copyio routine on a user address. True if the copy can try again.
+ */
+static bool
+hosted_copyio_fault(vm_map_t map, uint64_t va, vm_prot_t prot)
+{
+	thread_t      thread = current_thread();
+	kern_return_t result;
+
+	hosted_copyio_stats.faults++;
+	/* a reference or modify fault of the pmap: no VM work */
+	result = arm_fast_fault(map->pmap, va, prot, false, false);
+	if (result == KERN_SUCCESS) {
+		return true;
+	}
+	/* As on hardware: no paging from a context that has interrupts masked. */
+	if (result != KERN_PROTECTION_FAILURE &&
+	    (ml_get_interrupts_enabled() || startup_phase < STARTUP_SUB_EARLY_BOOT)) {
+		bool const was_recover = thread->recover;
+		thread->recover = true;         /* a copyio fault is not throttled */
+		result = vm_fault(map, va, prot, /* change_wiring */ FALSE, VM_KERN_MEMORY_NONE, THREAD_UNINT,
+		    /* caller_pmap */ NULL, /* caller_pmap_addr */ 0);
+		thread->recover = was_recover;
+		if (result == KERN_SUCCESS) {
+			return true;
+		}
+	}
+	hosted_copyio_stats.unresolved++;
+	return false;
+}
+
+/* Copies between kernel memory and `map`'s address space. 0 or EFAULT (part of the range may be copied). */
+static int
+hosted_copyio(vm_map_t map, uint64_t uaddr, void *kaddr, uint64_t size, bool to_user)
+{
+	uint8_t  *kernel = kaddr;
+	uint64_t  last_fault = ~0ULL;
+	unsigned  repeats = 0;
+
+	hosted_copyio_stats.copies++;
+	while (size != 0) {
+		uint64_t fault_va = 0;
+		uint64_t left = hosted_copy_user_pages(map->pmap, uaddr, kernel, size, to_user, &fault_va);
+		uint64_t done = size - left;
+
+		uaddr += done;
+		kernel += done;
+		size = left;
+		if (left == 0) {
+			break;
+		}
+		fault_va &= ~(uint64_t)ARM_PGMASK;
+		if (fault_va != last_fault) {
+			last_fault = fault_va;
+			repeats = 0;
+		} else if (++repeats >= HOSTED_COPYIO_RETRIES) {
+			hosted_copyio_stats.unresolved++;
+			return EFAULT;
+		}
+		if (!hosted_copyio_fault(map, uaddr, to_user ? (VM_PROT_READ | VM_PROT_WRITE) : VM_PROT_READ)) {
+			return EFAULT;
+		}
+	}
+	return 0;
+}
+
+/* For kernel code that holds a pmap and no map switch (hosted.h): no fault is resolved. */
+int
+hosted_copy_user(struct pmap *pmap, uint64_t uaddr, void *kaddr, uint64_t size, bool to_user)
+{
+	uint64_t fault_va = 0;
+
+	return hosted_copy_user_pages(pmap, uaddr, kaddr, size, to_user, &fault_va) == 0 ? 0 : EFAULT;
+}
+
+int
+hosted_bcopyin(const user_addr_t src, char *dst, vm_size_t len)
+{
+	return hosted_copyio(current_thread()->map, src, dst, len, false);
+}
+
+int
+hosted_bcopyout(const char *src, user_addr_t dst, vm_size_t len)
+{
+	return hosted_copyio(current_thread()->map, dst, (void *)(uintptr_t)src, len, true);
+}
+
+/*
+ * _bcopyinstr: the string up to and with its NUL, at most `max` bytes. Returns 0 and the length with the
+ * NUL in *actual; ENAMETOOLONG (and *actual = max) if there is no NUL in `max` bytes; EFAULT. Read piece
+ * by piece, and never past the end of the 4 KiB page a piece starts in: a string that ends in the last
+ * mapped page of a region must not fault on the page after it.
+ */
+int
+hosted_bcopyinstr(const user_addr_t src, char *dst, vm_size_t max, vm_size_t *actual)
+{
+	char      piece[256];
+	vm_map_t  map = current_thread()->map;
+	vm_size_t copied = 0;
+
+	while (copied < max) {
+		uint64_t  at = src + copied;
+		vm_size_t chunk = 0x1000 - (at & 0xfff);
+		vm_size_t take;
+
+		if (chunk > sizeof(piece)) {
+			chunk = sizeof(piece);
+		}
+		if (chunk > max - copied) {
+			chunk = max - copied;
+		}
+		if (hosted_copyio(map, at, piece, chunk, false) != 0) {
+			return EFAULT;
+		}
+		for (take = 0; take < chunk && piece[take] != '\0'; take++) {
+		}
+		bool ended = take < chunk;
+		if (ended) {
+			take++;                 /* the NUL */
+		}
+		memcpy(dst + copied, piece, take);
+		copied += take;
+		if (ended) {
+			*actual = copied;
+			return 0;
+		}
+	}
+	*actual = copied;
+	return ENAMETOOLONG;
+}
+
+/* One aligned word as a single access (copy_validate has checked the alignment). */
+static int
+hosted_copyio_atomic(user_addr_t uaddr, uint32_t size, uint32_t op, uint64_t *value)
+{
+	vm_map_t map = current_thread()->map;
+
+	hosted_copyio_stats.copies++;
+	for (unsigned tries = 0; tries <= HOSTED_COPYIO_RETRIES; tries++) {
+		if (hosted_user_atomic(map->pmap, uaddr, size, op, value)) {
+			return 0;
+		}
+		if (!hosted_copyio_fault(map, uaddr, op == HOSTED_UA_STORE ? (VM_PROT_READ | VM_PROT_WRITE) : VM_PROT_READ)) {
+			return EFAULT;
+		}
+	}
+	hosted_copyio_stats.unresolved++;
+	return EFAULT;
+}
+
+int
+hosted_copyin_atomic32(const user_addr_t src, uint32_t *dst)
+{
+	uint64_t value = 0;
+	int      result = hosted_copyio_atomic(src, 4, HOSTED_UA_LOAD, &value);
+
+	if (result == 0) {
+		*dst = (uint32_t)value;
+	}
+	return result;
+}
+
+int
+hosted_copyin_atomic64(const user_addr_t src, uint64_t *dst)
+{
+	uint64_t value = 0;
+	int      result = hosted_copyio_atomic(src, 8, HOSTED_UA_LOAD, &value);
+
+	if (result == 0) {
+		*dst = value;
+	}
+	return result;
+}
+
+/* ESTALE if the word is not `value`; else a short wait for an event (wfe on hardware) and 0. */
+int
+hosted_copyin_atomic32_wait_if_equals(const user_addr_t src, uint32_t value)
+{
+	uint64_t word = 0;
+	int      result = hosted_copyio_atomic(src, 4, HOSTED_UA_LOAD, &word);
+
+	if (result != 0) {
+		return result;
+	}
+	if ((uint32_t)word != value) {
+		return ESTALE;
+	}
+	__builtin_arm_yield();
+	return 0;
+}
+
+int
+hosted_copyout_atomic32(uint32_t u32, user_addr_t dst)
+{
+	uint64_t value = u32;
+
+	return hosted_copyio_atomic(dst, 4, HOSTED_UA_STORE, &value);
+}
+
+int
+hosted_copyout_atomic64(uint64_t u64, user_addr_t dst)
+{
+	uint64_t value = u64;
+
+	return hosted_copyio_atomic(dst, 8, HOSTED_UA_STORE, &value);
+}
+
+#endif /* XNU_HOSTED */
