+/*
+ * One aligned 4- or 8-byte user word, as a single access (copyin_atomic*, copyout_atomic*; HOSTED_UA_* in
+ * hosted.h):
+ *   HOSTED_UA_LOAD   *value = the word
+ *   HOSTED_UA_STORE  the word = *value
+ * Returns true, or false and nothing done when the tables do not allow it (the caller resolves the fault).
+ */
+bool
+hosted_user_atomic(pmap_t pmap, uint64_t uaddr, uint32_t size, uint32_t op, uint64_t *value)
+{
+	uint64_t v = *value;                            /* the caller's word is touched outside the locks */
+
+	if ((size != 4 && size != 8) || (uaddr & (size - 1))) {
+		return false;
+	}
+	if (!hosted_copy_lock(pmap)) {
+		return false;
+	}
+	uint32_t old = hosted_tlb_lock();
+	uint8_t *user = hosted_user_window_locked(pmap, uaddr, op == HOSTED_UA_STORE ? XH_PROT_WRITE : XH_PROT_READ);
+	if (user != NULL) {
+		if (op == HOSTED_UA_STORE) {
+			if (size == 4) {
+				__atomic_store_n((uint32_t *)user, (uint32_t)v, __ATOMIC_SEQ_CST);
+			} else {
+				__atomic_store_n((uint64_t *)user, v, __ATOMIC_SEQ_CST);
+			}
+		} else {
+			v = size == 4 ? __atomic_load_n((uint32_t *)user, __ATOMIC_SEQ_CST) :
+			    __atomic_load_n((uint64_t *)user, __ATOMIC_SEQ_CST);
+		}
+	}
+	hosted_tlb_unlock(old);
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	if (user != NULL && op == HOSTED_UA_LOAD) {
+		*value = v;
+	}
+	return user != NULL;
+}
