+/*
+ * 0058: a free page is about to be given back to the host (ram_discard, vm_resident.c's free-page reporting): no
+ * task may have any 4 KiB part of it mapped as the kernel recorded it (its unmaps, queued by xnuhost or not, were
+ * all given), and the pmap must have no mapping of it. hosted_mapcheck=1 only. No lock held.
+ */
+void hosted_check_page_discard(ppnum_t pn);
+void
+hosted_check_page_discard(ppnum_t pn)
+{
+	pmap_paddr_t pa = ptoa(pn);
+
+	if (!hosted_check_on || hosted_check_counts == NULL || !hosted_pa_in_window(pa)) {
+		return;
+	}
+	hosted_check_stats.discards++;
+	uint32_t page = (uint32_t)((pa - hosted_info.ram_phys) >> 12), mapped = 0;
+	for (uint32_t k = 0; k < PAGE_SIZE / 4096; k++) {
+		uint8_t count = hosted_check_counts[page + k];
+		mapped += count != 255 ? count : 0;
+	}
+	bool pmapped = !pmap_verify_free(pn);
+	if (mapped != 0 || pmapped) {
+		hosted_check_stats.discarded_mapped++;
+		hosted_check_note(4, 0, 0, page, mapped, pmapped, 0, 0);
+	}
+}
+
