+#if XNU_HOSTED
+/*
+ * OneiOS hosted (0058): free-page reporting. iOS keeps all of its ram=auto memory; the host gets back only pages iOS
+ * has freed. XNU's free queue is the only source: a page on it is memory iOS is not using at all; cached,
+ * compressed and wired pages are never touched, and nothing here changes the free count, the free target or what
+ * memorystatus sees (but for the moment a batch is off the queue, below).
+ *
+ * The RAM is xnuhost's memfd: the host holds a page once it was touched, until the kernel gives it back with the
+ * ram_discard host call (a hole punched in the memfd; the page reads as zero when it is used again). The free queues
+ * keep two kinds of pages, in this order:
+ *
+ *   head  [ pages iOS freed: the host still holds them ][ pages given back: the host holds nothing ]  tail
+ *
+ * A page iOS frees goes to the head (vm_page_free_queue_enter: enter_first), so the next allocation takes memory the
+ * host still holds; a page given back goes to the tail, used last. (Stock arm64 XNU enters every free page at the
+ * tail and takes from the head; with oneios-free-report=0 that is kept.) Pages released at startup were never
+ * touched: they enter as given back. Per colour queue: hosted_fr_held[] counts the held pages and
+ * hosted_fr_first[] is the first given-back page (every page after it is one too), both with the free queue lock.
+ * The reporting thread (below) takes the coldest held pages, those just before hosted_fr_first, and leaves the
+ * hottest at the head.
+ */
+#include <arm64/hosted/hosted.h>
+#include <arm64/hosted/free_report.h>
+static TUNABLE(uint32_t, hosted_fr_on, "oneios-free-report", 1);
+static uint32_t  hosted_fr_held[MAX_COLORS];
+static vm_page_t hosted_fr_first[MAX_COLORS];
+static uint32_t  hosted_fr_reported;            /* pages on the free queues given back */
+
+/* A regular page went onto colour `color`'s free queue. Free queue lock held. */
+static inline void
+hosted_fr_entered(vm_page_t mem, unsigned int color)
+{
+	if (mem->vmp_hosted_reported) {
+		hosted_fr_reported++;
+		if (hosted_fr_first[color] == VM_PAGE_NULL) {
+			hosted_fr_first[color] = mem;
+		}
+	} else {
+		hosted_fr_held[color]++;
+	}
+}
+
+/* A regular page is about to be unlinked from `queue` (colour `color`): called before, its next link is read. */
+static inline void
+hosted_fr_leaving(vm_page_queue_t queue, vm_page_t mem, unsigned int color)
+{
+	if (!mem->vmp_hosted_reported) {
+		hosted_fr_held[color]--;
+		return;
+	}
+	mem->vmp_hosted_reported = false;
+	hosted_fr_reported--;
+	if (hosted_fr_first[color] == mem) {
+		vm_page_t next = (vm_page_t)vm_page_queue_next(&mem->vmp_pageq);
+		hosted_fr_first[color] = ((void *)next == (void *)queue) ? VM_PAGE_NULL : next;
+	}
+}
