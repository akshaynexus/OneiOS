+#if XNU_HOSTED
+/*
+ * OneiOS hosted (0058): the reporting thread. Every oneios-free-report-ms (1000) it looks at how many free-queue
+ * pages the host holds (vm_page_free_count less the given-back ones). Above keep + hysteresis it starts a round and
+ * gives pages back down to keep, a batch at a time:
+ *
+ *   keep        vm_page_free_target + oneios-free-report-keep MiB (32): the pages the next allocations take; XNU
+ *               keeps its free count between vm_page_free_min and vm_page_free_target under pressure, so pages that
+ *               cycle through the free queue are never given back (no punch, no refill, no cost to iOS);
+ *   hysteresis  oneios-free-report-hysteresis MiB (16);
+ *   (oneios-free-report-stress=1, a check: keep 0, so every held free page above the hysteresis is given back and
+ *   pages come back used at once: the races of the paths below, with hosted_mapcheck=1)
+ *   batch       oneios-free-report-batch pages (64, the most): taken off the free queue with its lock, given back
+ *               with the lock dropped, put back at the tail with the lock. While a batch is out, vm_page_free_count is
+ *               that much lower (at most 1 MiB, for the host calls' time, only while the free count is far above
+ *               the free target); nothing can allocate a page whose hole is being punched, and XNU's contiguous
+ *               allocator does not take pages that are off every queue (vm_page_is_relocatable: VM_PAGE_NOT_ON_Q).
+ *
+ * The decisions are arm64/hosted/free_report.h (xh_fr_batch, xh_fr_runs), the same file as xnuhost's, host-tested
+ * there. A page given back may still be mapped in no task: XNU's pmap removes every mapping before a page reaches
+ * the free queue; with hosted_mapcheck=1 each page is checked again (hosted_check_page_discard). A task whose unmap
+ * xnuhost still has queued (a deferred unmap, docs/booter.md 2.6) cannot run before the stub has carried it out,
+ * and the punch drops the page from that task's process too.
+ *
+ * Every oneios-free-report-log seconds (30; 0: never) the thread prints what XNU sees of its memory, also with
+ * oneios-free-report=0 (the lines to compare a boot with and without), and what was given back:
+ *   oneios-mem: free F MiB (G given back, H held), active ..., wired ..., compressor C MiB holding P MiB
+ *   oneios-mem: purgeable ..., file-backed ..., anonymous ..., secluded ... MiB; memorystatus available M MiB; RAM T MiB
+ *   oneios-mem: given back X MiB since boot in B batches, R runs, N rounds (0 failed, 0 out of order), D ms
+ */
+#define HOSTED_FR_BATCH_MAX 64                  /* vmp_free_list_result_t counts in uint8_t */
+static TUNABLE(uint32_t, hosted_fr_period_ms, "oneios-free-report-ms", 1000);
+static TUNABLE(uint32_t, hosted_fr_keep_mb, "oneios-free-report-keep", 32);
+static TUNABLE(uint32_t, hosted_fr_hysteresis_mb, "oneios-free-report-hysteresis", 16);
+static TUNABLE(uint32_t, hosted_fr_batch_pages, "oneios-free-report-batch", HOSTED_FR_BATCH_MAX);
+static TUNABLE(uint32_t, hosted_fr_log_s, "oneios-free-report-log", 30);
+/* a check, not a setting: keep 0 (every held free page above the hysteresis goes back, used pages come back at once) */
+static TUNABLE(uint32_t, hosted_fr_stress, "oneios-free-report-stress", 0);
+
+static struct {
+	uint64_t rounds, batches, pages, runs, failed, out_of_order, ticks;
+	bool     stopped;                       /* a host call failed: no more reporting this boot */
+} hosted_fr_stats;
+
+#if CONFIG_JETSAM
+extern uint32_t memorystatus_available_pages;
+#endif
+extern void hosted_check_page_discard(ppnum_t pn);
+
+#define HOSTED_FR_MIB(pages) ((unsigned long long)(((uint64_t)(pages) * PAGE_SIZE) >> 20))
+
+/*
+ * Free queue lock held. Takes up to `want` held pages off the free queues, from each colour's queue only what it
+ * holds above keep_q, coldest first (backwards from its first given-back page, or from its tail).
+ */
+static uint32_t
+hosted_fr_take(vm_page_t *out, uint32_t want, uint32_t keep_q)
+{
+	static unsigned int start;
+	uint32_t n = 0;
+
+	for (unsigned int i = 0; i < vm_colors && n < want; i++) {
+		unsigned int    color = (start + i) & vm_color_mask;
+		vm_page_queue_t queue = &vm_page_queue_free.vmpfq_queues[color].qhead;
+		uint32_t        spare = hosted_fr_held[color] > keep_q ? hosted_fr_held[color] - keep_q : 0;
+		vm_page_t       mem   = (vm_page_t)(hosted_fr_first[color] != VM_PAGE_NULL
+		    ? vm_page_queue_prev(&hosted_fr_first[color]->vmp_pageq)
+		    : vm_page_queue_last(queue));
+
+		while (spare > 0 && n < want && (void *)mem != (void *)queue) {
+			vm_page_t prev = (vm_page_t)vm_page_queue_prev(&mem->vmp_pageq);
+			if (mem->vmp_hosted_reported || mem->vmp_q_state != VM_PAGE_ON_FREE_Q) {
+				/* not the order above: leave this queue alone this time (counted, printed) */
+				hosted_fr_stats.out_of_order++;
+				break;
+			}
+			vm_page_free_queue_remove(VM_MEMORY_CLASS_REGULAR, mem, VM_PAGE_GET_PHYS_PAGE(mem), VM_PAGE_NOT_ON_Q);
+			out[n++] = mem;
+			spare--;
+			mem = prev;
+		}
+	}
+	start = (start + 1) & vm_color_mask;
+	return n;
+}
+
+/* No lock held. Gives the pages back to the host, as runs of consecutive pages. False if a host call failed. */
+static bool
+hosted_fr_give(vm_page_t *pages, uint32_t n)
+{
+	uint32_t pn[HOSTED_FR_BATCH_MAX], first[HOSTED_FR_BATCH_MAX], count[HOSTED_FR_BATCH_MAX];
+	bool ok = true;
+
+	for (uint32_t i = 0; i < n; i++) {
+		pn[i] = VM_PAGE_GET_PHYS_PAGE(pages[i]);
+	}
+	uint32_t runs = xh_fr_runs(pn, n, first, count);
+	for (uint32_t r = 0; r < runs; r++) {
+		for (uint32_t k = 0; k < count[r]; k++) {
+			hosted_check_page_discard(first[r] + k);        /* hosted_mapcheck=1 */
+		}
+		uint32_t old = hosted_irq_mask();
+		int64_t rc = hosted_hc(HOSTED_FN(ram_discard), hosted_cpu(), ptoa_64(first[r]), ptoa_64(count[r]), 0, 0, 0);
+		hosted_irq_restore(old);
+		if (rc != 0) {
+			if (hosted_fr_stats.failed++ == 0) {
+				printf("oneios-mem: ram_discard(0x%llx, %u pages) failed: %lld; free pages are no longer given back\n",
+				    (unsigned long long)ptoa_64(first[r]), count[r], (long long)rc);
+			}
+			ok = false;
+		}
+	}
+	hosted_fr_stats.runs += runs;
+	return ok;
+}
+
+/* No lock held. The batch back onto the free queues, at their tails if it was given back. */
+static void
+hosted_fr_return(vm_page_t *pages, uint32_t n, bool given)
+{
+	vmp_free_list_result_t result = { };
+
+	vm_free_page_lock_spin();
+	for (uint32_t i = 0; i < n; i++) {
+		pages[i]->vmp_hosted_reported = given;
+		vm_page_free_queue_enter(VM_MEMORY_CLASS_REGULAR, pages[i], VM_PAGE_GET_PHYS_PAGE(pages[i]));
+		result.vmpr_regular++;
+	}
+	if (vm_page_free_queue_has_any_waiters()) {
+		vm_page_free_queue_handle_wakeups_and_unlock(result);
+	} else {
+		vm_free_page_unlock();
+	}
+	VM_CHECK_MEMORYSTATUS;
+}
+
+static void
+hosted_fr_log(void)
+{
+	/* three lines: the console cuts a line past about 256 characters and puts the next message in it */
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(hosted_fr_stats.ticks, &ns);
+	uint32_t reported = os_atomic_load(&hosted_fr_reported, relaxed), free = vm_page_free_count;
+	printf("oneios-mem: free %llu MiB (%llu given back, %llu held), active %llu, inactive %llu, speculative %llu, "
+	    "throttled %llu, wired %llu, compressor %llu MiB holding %llu MiB\n",
+	    HOSTED_FR_MIB(free), HOSTED_FR_MIB(reported), HOSTED_FR_MIB(free > reported ? free - reported : 0),
+	    HOSTED_FR_MIB(vm_page_active_count), HOSTED_FR_MIB(vm_page_inactive_count), HOSTED_FR_MIB(vm_page_speculative_count),
+	    HOSTED_FR_MIB(vm_page_throttled_count), HOSTED_FR_MIB(vm_page_wire_count), HOSTED_FR_MIB(VM_PAGE_COMPRESSOR_COUNT),
+	    HOSTED_FR_MIB(c_segment_pages_compressed));
+	printf("oneios-mem: purgeable %llu, file-backed %llu, anonymous %llu, secluded %llu MiB; "
+#if CONFIG_JETSAM
+	    "memorystatus available %llu MiB; "
+#endif
+	    "RAM %llu MiB\n",
+	    HOSTED_FR_MIB(counter_load(&vm_page_purgeable_count)), HOSTED_FR_MIB(vm_page_pageable_external_count),
+	    HOSTED_FR_MIB(vm_page_pageable_internal_count), HOSTED_FR_MIB(vm_page_secluded_count),
+#if CONFIG_JETSAM
+	    HOSTED_FR_MIB(memorystatus_available_pages),
+#endif
+	    HOSTED_FR_MIB(vm_page_pages));
+	printf("oneios-mem: given back %llu MiB since boot in %llu batches, %llu runs, %llu rounds (%llu failed, %llu out of order), "
+	    "%llu ms\n", HOSTED_FR_MIB(hosted_fr_stats.pages), hosted_fr_stats.batches, hosted_fr_stats.runs, hosted_fr_stats.rounds,
+	    hosted_fr_stats.failed, hosted_fr_stats.out_of_order, ns / NSEC_PER_MSEC);
+}
+
+static void
+hosted_fr_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static vm_page_t pages[HOSTED_FR_BATCH_MAX];
+	const uint32_t batch = MAX(1u, MIN(hosted_fr_batch_pages, HOSTED_FR_BATCH_MAX));
+	const uint32_t hysteresis = (uint32_t)(((uint64_t)hosted_fr_hysteresis_mb << 20) / PAGE_SIZE);
+	const uint32_t extra = (uint32_t)(((uint64_t)hosted_fr_keep_mb << 20) / PAGE_SIZE);
+	uint64_t last_log = 0, log_every = 0;
+
+	nanoseconds_to_absolutetime((uint64_t)hosted_fr_log_s * NSEC_PER_SEC, &log_every);
+	for (;;) {
+		bool active = false;
+		/* the free target is read each time: it is a sysctl (kern.vm_page_free_target) */
+		const uint32_t keep = hosted_fr_stress ? 0 : vm_page_free_target + extra, keep_q = xh_fr_keep_per_queue(keep, vm_colors);
+
+		while (hosted_fr_on && !hosted_fr_stats.stopped) {
+			uint32_t free = vm_page_free_count, reported = os_atomic_load(&hosted_fr_reported, relaxed);
+			uint32_t want = xh_fr_batch(free > reported ? free - reported : 0, keep, hysteresis, batch, active);
+			if (want == 0) {
+				break;
+			}
+			uint64_t began = mach_absolute_time();
+			vm_free_page_lock();
+			uint32_t n = hosted_fr_take(pages, want, keep_q);
+			vm_free_page_unlock();
+			if (n == 0) {
+				break;
+			}
+			if (!active) {
+				active = true;
+				hosted_fr_stats.rounds++;
+			}
+			bool ok = hosted_fr_give(pages, n);
+			hosted_fr_return(pages, n, ok);
+			hosted_fr_stats.batches++;
+			if (ok) {
+				hosted_fr_stats.pages += n;
+			} else {
+				hosted_fr_stats.stopped = true;
+			}
+			hosted_fr_stats.ticks += mach_absolute_time() - began;
+		}
+		uint64_t now = mach_absolute_time();
+		if (hosted_fr_log_s != 0 && now - last_log >= log_every) {
+			last_log = now;
+			hosted_fr_log();
+		}
+		assert_wait_timeout((event_t)&hosted_fr_stats, THREAD_UNINT, MAX(hosted_fr_period_ms, 10u), NSEC_PER_MSEC);
+		thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void hosted_free_report_start(void);
+void
+hosted_free_report_start(void)
+{
+	thread_t thread = THREAD_NULL;
+
+	printf("oneios-mem: free-page reporting %s (oneios-free-report=%u): keep %u pages (free target %u + %u MiB), "
+	    "hysteresis %u MiB, batch %u pages, every %u ms; %u of %u free pages never touched\n",
+	    hosted_fr_on ? (hosted_fr_stress ? "on, stress check" : "on") : "off", hosted_fr_on,
+	    hosted_fr_stress ? 0 : vm_page_free_target + (uint32_t)(((uint64_t)hosted_fr_keep_mb << 20) / PAGE_SIZE),
+	    vm_page_free_target, hosted_fr_keep_mb, hosted_fr_hysteresis_mb, MAX(1u, MIN(hosted_fr_batch_pages, HOSTED_FR_BATCH_MAX)),
+	    hosted_fr_period_ms, os_atomic_load(&hosted_fr_reported, relaxed), vm_page_free_count);
+	if (!hosted_fr_on && hosted_fr_log_s == 0) {
+		return;
+	}
+	if (kernel_thread_start_priority(hosted_fr_thread, NULL, BASEPRI_UTILITY, &thread) == KERN_SUCCESS) {
+		thread_set_thread_name(thread, "oneios_free_report");
+		thread_deallocate(thread);
+	}
+}
+#endif /* XNU_HOSTED */
