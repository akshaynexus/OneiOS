diff --git a/bsd/kern/code_signing/xnu.c b/bsd/kern/code_signing/xnu.c
index 716d7a4..00d8de7 100644
--- a/bsd/kern/code_signing/xnu.c
+++ b/bsd/kern/code_signing/xnu.c
@@ -383,7 +383,17 @@ xnu_image4_monitor_trap(
 	__unused const void *input_data,
 	__unused size_t input_size)
 {
+#if XNU_HOSTED
+	/*
+	 * OneiOS hosted (0007-prelink-kext-start.patch): the collection's Image4 is built for a phone with a code
+	 * signing monitor and sends each nonce slot to it from its start, without asking whether there is one and
+	 * without reading the result. kernel.kc binds that call here: there is no monitor to tell.
+	 */
+	(void)selector;
+	return ENOTSUP;
+#else
 	panic("image4 dispatch: trap without code signing monitor: %llu", selector);
+#endif /* XNU_HOSTED */
 }
 
 #endif /* !CODE_SIGNING_MONITOR */
diff --git a/libkern/c++/OSKext.cpp b/libkern/c++/OSKext.cpp
index b921bd8..06f606b 100644
--- a/libkern/c++/OSKext.cpp
+++ b/libkern/c++/OSKext.cpp
@@ -8505,7 +8505,12 @@ OSKext::start(bool startDependenciesFlag)
 		bool executable = false;
 		if (!earlyInit || !isPrelinked() || mac_late ||
 		    getPropertyForHostArch(kAppleSecurityExtensionKey) != kOSBooleanTrue ||
+#if XNU_HOSTED
+		    /* OneiOS hosted: the collection is linked high and runs low; link address + slide wraps by design. */
+		    ((target = (uintptr_t)earlyInit->unsigned64BitValue() + vm_kernel_slide), false) ||
+#else
 		    __builtin_add_overflow((uintptr_t)earlyInit->unsigned64BitValue(), vm_kernel_slide, &target) ||
+#endif
 		    (target & 3)) {
 			panic("NativePrelink: invalid early security initializer or phase for %s", getIdentifierCString());
 		}
diff --git a/libkern/libkern/Block_private.h b/libkern/libkern/Block_private.h
index d1f1a36..58139de 100644
--- a/libkern/libkern/Block_private.h
+++ b/libkern/libkern/Block_private.h
@@ -440,6 +440,14 @@ _Block_get_descriptor(struct Block_layout *aBlock)
 	uintptr_t disc = ptrauth_blend_discriminator(
 		&aBlock->descriptor, _Block_descriptor_ptrauth_discriminator);
 	return ptrauth_auth_data(aBlock->descriptor, ptrauth_key_asda, disc);
+#elif XNU_HOSTED && __has_feature(ptrauth_calls)
+	/*
+	 * OneiOS hosted: the kexts of the collection are built by Apple's clang with signed block descriptor
+	 * pointers (key DA, the field's address blended with 0xC0BB); the clang this kernel is built with has no
+	 * ptrauth_signed_block_descriptors, so its own blocks carry a plain pointer. Take either: strip the
+	 * signature. (Block_copy of a kext's stack block read the signed pointer as an address: data abort.)
+	 */
+	return ptrauth_strip(aBlock->descriptor, ptrauth_key_asda);
 #else
 	return aBlock->descriptor;
 #endif
diff --git a/osfmk/prng/prng_random.c b/osfmk/prng/prng_random.c
index 310719a..7f35aa0 100644
--- a/osfmk/prng/prng_random.c
+++ b/osfmk/prng/prng_random.c
@@ -606,7 +606,20 @@ source_corecrypto14_bootstrap(void)
 	}
 	kmod_info_t *original = source_corecrypto14_original();
 	if (original != NULL) {
+#if XNU_HOSTED
+		/*
+		 * OneiOS hosted: this start runs before OSKext has seen the collection, and kmod_info.address is the one
+		 * field of a prelinked kmod_info outside the fixup chains: OSKext adds the slide to it when it adopts the
+		 * kext (OSKext.cpp, "kaslr: unslid"). Original corecrypto reads its own Mach-O header through it in its
+		 * integrity self-test. The slide is not zero under xnuhost, so lend it the slid address for the call.
+		 */
+		extern vm_offset_t vm_kernel_slide;
+		original->address += vm_kernel_slide;
 		source_corecrypto14_status = source_corecrypto14_start_once(original, NULL);
+		original->address -= vm_kernel_slide;
+#else
+		source_corecrypto14_status = source_corecrypto14_start_once(original, NULL);
+#endif
 		if (source_corecrypto14_status != KERN_SUCCESS) {
 			panic("original corecrypto initialization failed: %d", source_corecrypto14_status);
 		}
