+/*
+ * A line about a rare event on the way back to user mode. That path runs with interrupts masked, and the serial
+ * console refuses output then ("Console I/O from interrupt-disabled context" panicked the boot whenever a task's
+ * process was gone or a twin could not be made, each of which costs one task at most): the line is printed with
+ * interrupts on. Every caller re-reads the thread's state afterwards (the loop starts over, or the task is killed).
+ */
+#define hosted_user_say(...) do { \
+	boolean_t hosted_say_were = ml_set_interrupts_enabled(TRUE); \
+	printf(__VA_ARGS__); \
+	(void)ml_set_interrupts_enabled(hosted_say_were); \
+} while (0)
+
 /* machine_thread_destroy: the thread is gone. */
 void
 hosted_thread_twin_destroy(thread_t thread)
