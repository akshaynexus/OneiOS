+	if (hosted_esr_is_cache_maintenance(esr)) {
+		/*
+		 * 0070: CM and WnR as the hardware set them, so the thread state says what the instruction was; the fault
+		 * an access flag fault, not a permission fault: inspect_data_abort takes CM with WnR as a write only when
+		 * it is a permission fault. As with the permission fault below, arm_fast_fault is tried before vm_fault.
+		 */
+		return ((uint64_t)ESR_EC_DABORT_EL0 << ESR_EC_SHIFT) | ESR_IL | (esr & (ISS_DA_CM | ISS_DA_WNR)) |
+		       FSC_ACCESS_FLAG_FAULT_L3;
+	}
