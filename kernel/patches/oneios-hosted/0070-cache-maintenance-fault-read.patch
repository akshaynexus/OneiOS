+	/*
+	 * 0070: the syndrome a user fault reaches XNU with. A cache maintenance fault as the hardware reports it (CM and
+	 * WnR, a translation fault: dc cvau on a page the host has not mapped), with the stub of an older xnuhost that
+	 * said XH_PROT_WRITE for it, must be a read by inspect_data_abort's rule (a write only with WnR and either no CM
+	 * or a permission fault); a store stays a write.
+	 */
+	{
+		const uint64_t dabt = ((uint64_t)ESR_EC_DABORT_EL0 << ESR_EC_SHIFT) | ESR_IL;
+		struct xh_trap cm = { .kind = XH_TRAP_FAULT, .far = 0x100004000ULL, .access = XH_PROT_WRITE,
+			              .esr = dabt | ISS_DA_CM | ISS_DA_WNR | FSC_TRANSLATION_FAULT_L3 };
+		struct xh_trap st = cm;
+		uint64_t       far = 0, esr;
+
+		st.esr = dabt | ISS_DA_WNR | FSC_TRANSLATION_FAULT_L3;
