+/*
+ * 0070: a cache maintenance instruction by address that faults (the ones EL0 may run: dc cvau, dc cvac, dc civac,
+ * dc cvap, ic ivau) reports a data abort with ISS.WnR = 1 and ISS.CM = 1. It needs read access to the page only
+ * (Linux's is_write_abort and XNU's inspect_data_abort take it as a read): JSC's sys_icache_invalidate of a new
+ * thunk on the read-execute alias of its JIT region, whose first access is that dc cvau when the host has not
+ * mapped the alias yet. Taken as a write, the fill refused it and vm_fault failed it on the read-execute entry:
+ * KERN_PROTECTION_FAILURE, "byte write Permission fault", every WebContent process at JSC::initialize.
+ * Linux passes the hardware's ESR of a user address whole (set_thread_esr sanitizes kernel addresses only).
+ */
+static inline bool
+hosted_esr_is_cache_maintenance(uint64_t esr)
+{
+	return ESR_EC(esr) == ESR_EC_DABORT_EL0 && (esr & ISS_DA_CM) != 0;
+}
+
+/* sleh.c's is_permission_fault (static there): the fault codes inspect_data_abort takes CM with WnR as a write for */
+static inline bool
+is_hosted_permission_fsc(uint32_t fsc)
+{
+	return fsc >= FSC_PERMISSION_FAULT_L1 && fsc <= FSC_PERMISSION_FAULT_L3;
+}
+
 /* The access a user fault was, as XH_PROT_* bits. */
 static uint32_t
 hosted_trap_access(const struct xh_trap *trap, uint64_t pc)
 {
 	uint32_t ec = (uint32_t)ESR_EC(trap->esr);
 
+	if (hosted_esr_is_cache_maintenance(trap->esr)) {
+		return XH_PROT_READ;    /* 0070: also from a stub that said XH_PROT_WRITE for it (xnuhost before 0070) */
+	}
 	if (trap->access != 0) {
 		return trap->access;
 	}
@@ -360,6 +385,15 @@
 			return esr;
 		}
