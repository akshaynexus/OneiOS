+		bool st_write = hosted_trap_access(&st, 0x100000000ULL) == XH_PROT_WRITE && !(esr & ISS_DA_CM) &&
+		    (esr & ISS_DA_WNR) && is_hosted_permission_fsc((uint32_t)ISS_DA_FSC(esr));
+		hosted_selftest_check(cm_read && st_write,
+		    "a cache maintenance fault (CM, WnR) reaches XNU as a read with CM kept; a store as a write");
+	}
