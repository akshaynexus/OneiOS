+/*
+ * 0041: how the TLB lock is used (oneios-perf, hosted_user.c): times taken, times another CPU held it, the counter
+ * ticks spent waiting for it and held. Updated with the lock held, so plain stores. CNTVCT_EL0 is readable here
+ * (the kernel runs at EL0 under xnuhost).
+ */
+static struct {
+	uint64_t taken, contended, wait_ticks, held_ticks, since;
+} hosted_tlb_stats;
+
 static inline uint32_t
 hosted_tlb_lock(void)
 {
 	uint32_t old = hosted_irq_mask();
-	while (!__sync_bool_compare_and_swap(&hosted_tlb_lock_word, 0, 1)) {
-		__builtin_arm_yield();
+	if (__improbable(!__sync_bool_compare_and_swap(&hosted_tlb_lock_word, 0, 1))) {
+		uint64_t began = __builtin_arm_rsr64("CNTVCT_EL0");
+		while (!__sync_bool_compare_and_swap(&hosted_tlb_lock_word, 0, 1)) {
+			__builtin_arm_yield();
+		}
+		hosted_tlb_stats.since = __builtin_arm_rsr64("CNTVCT_EL0");
+		hosted_tlb_stats.contended++;
+		hosted_tlb_stats.wait_ticks += hosted_tlb_stats.since - began;
+	} else {
+		hosted_tlb_stats.since = __builtin_arm_rsr64("CNTVCT_EL0");
 	}
+	hosted_tlb_stats.taken++;
 	return old;
 }
 
 static inline void
 hosted_tlb_unlock(uint32_t old)
 {
+	hosted_tlb_stats.held_ticks += __builtin_arm_rsr64("CNTVCT_EL0") - hosted_tlb_stats.since;
 	__sync_lock_release(&hosted_tlb_lock_word);
 	hosted_irq_restore(old);
 }
 
+/* 0041: the pmap's counters for the oneios-perf report: user maps, user unmaps, kernel maps, kernel unmaps, and the
+ * TLB lock's taken, contended, wait ticks, held ticks. Read without the lock: a report, not an exact sum. */
+void hosted_pmap_perf(uint64_t out[8]);
+void
+hosted_pmap_perf(uint64_t out[8])
+{
+	out[0] = hosted_pmap_stats.user_maps;
+	out[1] = hosted_pmap_stats.user_unmaps;
+	out[2] = hosted_pmap_stats.kernel_maps;
+	out[3] = hosted_pmap_stats.kernel_unmaps;
+	out[4] = hosted_tlb_stats.taken;
+	out[5] = hosted_tlb_stats.contended;
+	out[6] = hosted_tlb_stats.wait_ticks;
+	out[7] = hosted_tlb_stats.held_ticks;
+}
+
 /*
  * The leaf entry of va, or 0. Lock-free: for the kernel pmap (its tables are never freed) or with the pmap's
  * lock held. A block entry is returned as a page entry of the block's attributes.
diff --git a/osfmk/arm64/hosted/hosted_user.c b/osfmk/arm64/hosted/hosted_user.c
--- a/osfmk/arm64/hosted/hosted_user.c
+++ b/osfmk/arm64/hosted/hosted_user.c
@@ -64,6 +64,95 @@
 	uint64_t runs, syscalls, faults, fills, refills, interrupts, illegal, brk, fpe, exited;
 	uint64_t twins_made, twins_dropped;
 } hosted_user_stats;
+
+/*
+ * 0041, oneios-perf=SECONDS (default 30, 0 = off): what the kernel does with the traps of user code, on the console
+ * every SECONDS. xnuhost's "perf:" lines time the host's side of each trip (docs/booter.md 2.6a); these say which
+ * system calls and faults the kernel's share goes to.
+ *
+ * A trap's time is its vCPU's from the trap to the next entry into user mode on that vCPU (by this thread or any
+ * other) or to the vCPU's next idle: the kernel's work for the call up to the point it returns or blocks, and what
+ * runs on the vCPU before then. Time a blocked thread waits is not in it. Kept per vCPU (one open trap each), summed per system
+ * call number in counters every vCPU adds to.
+ */
+#define HOSTED_PERF_BSD   1024
+#define HOSTED_PERF_MACH  128
+#define HOSTED_PERF_CPUS  16
+enum { HOSTED_PERF_K_BSD, HOSTED_PERF_K_MACH, HOSTED_PERF_K_PLATFORM, HOSTED_PERF_K_VM_FAULT, HOSTED_PERF_K_OTHER };
+struct hosted_perf_counts {
+	uint64_t bsd_n[HOSTED_PERF_BSD], bsd_t[HOSTED_PERF_BSD];
+	uint64_t mach_n[HOSTED_PERF_MACH], mach_t[HOSTED_PERF_MACH];
+	uint64_t kind_n[5], kind_t[5];
+	uint64_t fill_t;                        /* hosted_user_fill on the trap path, all of them */
+};
+static struct hosted_perf_counts hosted_perf, hosted_perf_last;
+static struct {
+	uint64_t at;
+	uint32_t kind, number;
+} hosted_perf_open[HOSTED_PERF_CPUS];
+static uint32_t hosted_perf_every = 30;
+
+static inline uint64_t
+hosted_perf_now(void)
+{
+	return __builtin_arm_rsr64("CNTVCT_EL0");
+}
+
+/* A trap the kernel now works on (interrupts masked: the vCPU is this one until the next user entry). */
+static inline void
+hosted_perf_trap(uint32_t kind, uint32_t number)
+{
+	unsigned cpu = (unsigned)cpu_number();
+	if (hosted_perf_every != 0 && cpu < HOSTED_PERF_CPUS) {
+		hosted_perf_open[cpu].at = hosted_perf_now();
+		hosted_perf_open[cpu].kind = kind;
+		hosted_perf_open[cpu].number = number;
+	}
+}
+
+/* The next entry into user mode on this vCPU: the open trap's time is counted. Interrupts masked. */
+static inline void
+hosted_perf_enter_user(void)
+{
+	unsigned cpu = (unsigned)cpu_number();
+	if (cpu >= HOSTED_PERF_CPUS || hosted_perf_open[cpu].at == 0) {
+		return;
+	}
+	uint64_t ticks = hosted_perf_now() - hosted_perf_open[cpu].at;
+	uint32_t kind = hosted_perf_open[cpu].kind, number = hosted_perf_open[cpu].number;
+	hosted_perf_open[cpu].at = 0;
+	os_atomic_inc(&hosted_perf.kind_n[kind], relaxed);
+	os_atomic_add(&hosted_perf.kind_t[kind], ticks, relaxed);
+	if (kind == HOSTED_PERF_K_BSD && number < HOSTED_PERF_BSD) {
+		os_atomic_inc(&hosted_perf.bsd_n[number], relaxed);
+		os_atomic_add(&hosted_perf.bsd_t[number], ticks, relaxed);
+	} else if (kind == HOSTED_PERF_K_MACH && number < HOSTED_PERF_MACH) {
+		os_atomic_inc(&hosted_perf.mach_n[number], relaxed);
+		os_atomic_add(&hosted_perf.mach_t[number], ticks, relaxed);
+	}
+}
+
+/* cpu_idle (hosted_machine.c): the vCPU idles, so the open trap's time ends here, not at the next user entry. */
+void hosted_perf_idle(void);
+void
+hosted_perf_idle(void)
+{
+	hosted_perf_enter_user();
+}
+
+/* The system call of a trapped svc, as handle_svc and unix_syscall read it: x16 (x0 for the indirect call 0). */
+static void
+hosted_perf_syscall(const arm_saved_state64_t *ss)
+{
+	int64_t x16 = (int64_t)ss->x[16];
+	if ((int32_t)x16 == (int32_t)0x80000000) {
+		hosted_perf_trap(HOSTED_PERF_K_PLATFORM, 0);
+	} else if ((int32_t)x16 < 0) {
+		hosted_perf_trap(HOSTED_PERF_K_MACH, (uint32_t)-(int32_t)x16);
+	} else {
+		hosted_perf_trap(HOSTED_PERF_K_BSD, x16 == 0 ? (uint32_t)ss->x[0] : (uint32_t)x16);
+	}
+}
 
