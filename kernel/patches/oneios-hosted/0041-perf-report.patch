+/* ---- 0041: the oneios-perf report --------------------------------------------------------------- */
+
+extern void hosted_pmap_perf(uint64_t out[8]);
+struct hosted_copyio_stats {                    /* hosted_copyio.c's, the same layout */
+	uint64_t copies, faults, unresolved;
+};
+extern struct hosted_copyio_stats hosted_copyio_stats;
+
+static uint64_t
+hosted_perf_us(uint64_t ticks)
+{
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(ticks, &ns);
+	return ns / 1000;
+}
+
+/* The `count` numbers with the most calls in n[0..size), as " NUMBER CALLS xMEAN_US" items. */
+static void
+hosted_perf_top(const char *what, const uint64_t *n, const uint64_t *t, const uint64_t *n0, const uint64_t *t0,
+    unsigned size, unsigned count, bool negative)
+{
+	char line[400];
+	unsigned used = 0;
+	uint8_t taken[HOSTED_PERF_BSD] = {0};
+	used += (unsigned)snprintf(line + used, sizeof(line) - used, "%s:", what);
+	for (unsigned k = 0; k < count && used < sizeof(line) - 40; k++) {
+		unsigned best = size;
+		uint64_t best_n = 0;
+		for (unsigned i = 0; i < size; i++) {
+			if (!taken[i] && n[i] - n0[i] > best_n) {
+				best = i;
+				best_n = n[i] - n0[i];
+			}
+		}
+		if (best == size) {
+			break;
+		}
+		taken[best] = 1;
+		used += (unsigned)snprintf(line + used, sizeof(line) - used, " %s%u %llu x%llu", negative ? "-" : "", best,
+		    best_n, hosted_perf_us(t[best] - t0[best]) / best_n);
+	}
+	printf("oneios-perf:   %s us\n", line);
+}
+
+static void
+hosted_perf_report_thread(__unused void *arg, __unused wait_result_t result)
+{
+	static struct hosted_user_stats user_last;
+	static uint64_t pmap_last[8], copies_last, copy_faults_last;
+	uint64_t last = mach_absolute_time();
+	for (;;) {
+		assert_wait_timeout((event_t)&hosted_perf_every, THREAD_UNINT, hosted_perf_every * 1000, NSEC_PER_MSEC);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+		uint64_t now = mach_absolute_time(), wall = now - last;
+		struct hosted_user_stats u = hosted_user_stats;
+		uint64_t pm[8];
+		hosted_pmap_perf(pm);
+		static struct hosted_perf_counts c;
+		c = hosted_perf;
+		const struct hosted_perf_counts *c0 = &hosted_perf_last;
+		uint64_t wall_us = hosted_perf_us(wall) ? hosted_perf_us(wall) : 1;
+#define D(f) (u.f - user_last.f)
+#define KN(k) (c.kind_n[k] - c0->kind_n[k])
+#define KT(k) hosted_perf_us(c.kind_t[k] - c0->kind_t[k])
+		printf("oneios-perf: %llu s: %llu user stays; %llu syscalls (bsd %llu, %llu us; mach %llu, %llu us; platform %llu, %llu us); "
+		    "%llu faults, %llu filled from the tables (%llu us), %llu to vm_fault (%llu us), %llu refilled; %llu interrupts; twins +%llu -%llu\n",
+		    wall_us / 1000000, D(runs), D(syscalls), KN(HOSTED_PERF_K_BSD), KT(HOSTED_PERF_K_BSD), KN(HOSTED_PERF_K_MACH),
+		    KT(HOSTED_PERF_K_MACH), KN(HOSTED_PERF_K_PLATFORM), KT(HOSTED_PERF_K_PLATFORM), D(faults), D(fills),
+		    hosted_perf_us(c.fill_t - c0->fill_t), KN(HOSTED_PERF_K_VM_FAULT), KT(HOSTED_PERF_K_VM_FAULT), D(refills),
+		    D(interrupts), D(twins_made), D(twins_dropped));
+		printf("oneios-perf:   pmap: user maps %llu, unmaps %llu, kernel maps %llu, unmaps %llu; TLB lock taken %llu, %llu waited "
+		    "(%llu us waiting, %llu.%01llu%% of a vCPU), held %llu us (%llu.%01llu%%); copyio %llu (%llu faults)\n",
+		    pm[0] - pmap_last[0], pm[1] - pmap_last[1], pm[2] - pmap_last[2], pm[3] - pmap_last[3], pm[4] - pmap_last[4],
+		    pm[5] - pmap_last[5], hosted_perf_us(pm[6] - pmap_last[6]), hosted_perf_us(pm[6] - pmap_last[6]) * 100 / wall_us,
+		    hosted_perf_us(pm[6] - pmap_last[6]) * 1000 / wall_us % 10, hosted_perf_us(pm[7] - pmap_last[7]),
+		    hosted_perf_us(pm[7] - pmap_last[7]) * 100 / wall_us, hosted_perf_us(pm[7] - pmap_last[7]) * 1000 / wall_us % 10,
+		    hosted_copyio_stats.copies - copies_last, hosted_copyio_stats.faults - copy_faults_last);
+#undef D
+#undef KN
+#undef KT
+		hosted_perf_top("bsd (number calls x mean)", c.bsd_n, c.bsd_t, c0->bsd_n, c0->bsd_t, HOSTED_PERF_BSD, 12, false);
+		hosted_perf_top("mach traps", c.mach_n, c.mach_t, c0->mach_n, c0->mach_t, HOSTED_PERF_MACH, 8, true);
+		hosted_perf_last = c;
+		user_last = u;
+		for (unsigned i = 0; i < 8; i++) {
+			pmap_last[i] = pm[i];
+		}
+		copies_last = hosted_copyio_stats.copies;
+		copy_faults_last = hosted_copyio_stats.faults;
+		last = now;
+	}
+}
+
+void hosted_perf_report_start(void);
+void
+hosted_perf_report_start(void)
+{
+	thread_t thread = THREAD_NULL;
+	(void)PE_parse_boot_argn("oneios-perf", &hosted_perf_every, sizeof(hosted_perf_every));
+	if (hosted_perf_every == 0) {
+		return;
+	}
+	if (kernel_thread_start(hosted_perf_report_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+	printf("oneios-perf: the kernel's share of user traps every %u s (oneios-perf=0 turns it off)\n", hosted_perf_every);
+}
