 	if (cdp->cpu_get_decrementer_func) {
 		dec = cdp->cpu_get_decrementer_func();
 	} else {
@@ -2672,6 +2682,7 @@ ml_get_decrementer(void)
 		dec = (uint32_t)wide_val;
 		assert(wide_val == (uint64_t)dec);
 	}
+#endif
 
 	/* Back in timebase ticks; a timer already past (TVAL negative) stays as read. */
 	if (timebase_scaled() && (int32_t)dec > 0) {
@@ -2684,8 +2695,12 @@ ml_get_decrementer(void)
 boolean_t
 ml_get_timer_pending(void)
 {
+#if XNU_HOSTED
+	return hosted_timer_pending() ? TRUE : FALSE;
+#else
 	uint64_t cntv_ctl = __builtin_arm_rsr64(KERNEL_CNTV_CTL_EL0);
 	return ((cntv_ctl & CNTV_CTL_EL0_ISTATUS) != 0) ? TRUE : FALSE;
+#endif
 }
 
 __attribute__((noreturn))
@@ -2765,6 +2780,9 @@ _enable_timebase_event_stream(uint32_t bit_index)
 static void
 _enable_virtual_timer(void)
 {
+#if XNU_HOSTED
+	/* OneiOS hosted: the timer is armed by timer_set (ml_set_decrementer); there is nothing to switch on. */
+#else
 	uint64_t cntvctl = CNTV_CTL_EL0_ENABLE; /* One wants to use 32 bits, but "mrs" prefers it this way */
 
 	__builtin_arm_wsr64(KERNEL_CNTV_CTL_EL0, cntvctl);
@@ -2773,6 +2791,7 @@ _enable_virtual_timer(void)
 #if HAS_APPLE_GENERIC_TIMER
 	__builtin_arm_wsr64("S3_1_C15_C13_4", CNTP_CTL_EL0_IMASKED);
 #endif
+#endif /* !XNU_HOSTED */
 }
 
