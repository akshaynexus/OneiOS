diff --git a/osfmk/arm64/hosted/hosted_pmap.h b/osfmk/arm64/hosted/hosted_pmap.h
index 80207a3..6fd42e3 100644
--- a/osfmk/arm64/hosted/hosted_pmap.h
+++ b/osfmk/arm64/hosted/hosted_pmap.h
@@ -192,6 +192,29 @@ hosted_kernel_fill(uint64_t va, uint32_t access)
 	return filled;
 }
 
+/*
+ * A kernel fault at va on a device page: IOKit maps a board device (IOMemoryMap, IODeviceMemory) at an address
+ * of the kernel's own range, and the pmap's entry then names a physical address in the host's I/O aperture,
+ * which has no memory to map. Returns that physical address (page and offset) if the entry allows `access`,
+ * else 0. Such a page is never given to kernel_map: each access is emulated by the host (mmio_emulate).
+ */
+uint64_t
+hosted_kernel_device(uint64_t va, uint32_t access)
+{
+	va = VM_KERNEL_STRIP_PTR(va);
+	if (va < hosted_kva_base || va >= hosted_kva_end || kernel_pmap->tte == NULL) {
+		return 0;
+	}
+	pt_entry_t pte = hosted_walk(kernel_pmap, va & ~(uint64_t)ARM_PGMASK);
+	uint32_t prot = hosted_pte_prot(pte, false);
+	pmap_paddr_t pa = pte_to_pa(pte);
+
+	if (prot == 0 || (access & ~prot) || pa < hosted_info.io_phys || pa - hosted_info.io_phys >= hosted_info.io_size) {
+		return 0;
+	}
+	return pa + (va & ARM_PGMASK);
+}
+
 /* The kernel pmap just made entries for [va, va + size): map them now. */
 void
 hosted_kernel_enter(uint64_t va, uint64_t size)
diff --git a/osfmk/arm64/hosted/hosted_smp.c b/osfmk/arm64/hosted/hosted_smp.c
new file mode 100644
index 0000000..46e3308
--- /dev/null
+++ b/osfmk/arm64/hosted/hosted_smp.c
@@ -0,0 +1,135 @@
+/*
+ * OneiOS: the hosted machine layer, more than one CPU (arm64/hosted/hosted.h explains the model).
+ *
+ *   Secondary CPUs   ArmCpu starts a core with PSCI CPU_ON at the kernel's reset vector page. Under xnuhost
+ *                    that call makes a new host thread (a vCPU), which enters LowResetVectorBase ->
+ *                    hosted_cpu_start -> hosted_secondary_entry with its own struct xh_cpu in x18. From there
+ *                    it is arm_init_cpu() on the CPU's interrupt stack, as start_cpu/common_start do on
+ *                    hardware, minus the MMU.
+ *   Identity         A vCPU is told who it is by xnuhost (xh_cpu.index = the "reg" of its /cpus node), not by
+ *                    MPIDR_EL1: at EL0 Linux answers that register itself, the same value on every core.
+ *                    The build (kernel/hosted-fixup.py, run by build-hosted.sh before the image is sealed
+ *                    again) turns every `mrs xN, MPIDR_EL1` of the linked kernel, XNU's own and ArmCpu's,
+ *                    into `ldr wN, [x18]`: xh_cpu.index. It cannot be done at boot: the text is covered by
+ *                    corecrypto's integrity HMAC.
+ *   Timer            XNU's decrementer is xnuhost's per-vCPU deadline timer (the timer_set host call). It
+ *                    arrives as INTID 27, which ArmCpu acknowledges and hands to rtclock_intr().
+ *   IPIs             ArmCpu sends them (ICC_SGI1R_EL1, or its SPIs 1008 + core); xnuhost's GIC delivers them
+ *                    as a signal to the target vCPU's thread. Nothing here.
+ */
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <kern/thread.h>
+#include <kern/processor.h>
+#include <kern/debug.h>
+#include <arm/cpu_data_internal.h>
+#include <arm/cpu_internal.h>
+#include <arm/machine_routines.h>
+#include <arm64/proc_reg.h>
+
+#if XNU_HOSTED
+
+#include <arm64/hosted/hosted.h>
+
+extern void arm_init_cpu(cpu_data_t *cpu_data_ptr, uint64_t hib_header_phys);
+extern void hosted_switch_to_stack(void *arg, vm_offset_t stack_top, void (*fn)(void *)) __dead2;
+
+void hosted_secondary_entry(struct xh_cpu *cpu) __dead2;
+
+#define HSC(name, a1) hosted_hc(HOSTED_FN(name), hosted_cpu(), (uint64_t)(a1), 0, 0, 0, 0)
+
+struct hosted_smp_stats {
+	uint32_t cpus_entered;                  /* secondary vCPUs that reached arm_init_cpu */
+	uint64_t timer_sets;
+} hosted_smp_stats;
+
+/* ---- secondary CPUs ------------------------------------------------------------------------ */
+
+static void
+hosted_secondary_run(void *arg)
+{
+	arm_init_cpu((cpu_data_t *)arg, 0);     /* ends in secondary_cpu_main(): does not return */
+	panic("hosted: arm_init_cpu returned");
+}
+
+static void __dead2
+hosted_secondary_park(const char *why, uint64_t value)
+{
+	hosted_raw_log(why, value);
+	for (;;) {
+		(void)HSC(cpu_idle, 0);
+	}
+}
+
+/*
+ * A secondary vCPU's first C code, on xnuhost's boot stack of that vCPU, interrupts masked, no current
+ * thread. cpu_start() has put the CPU's first thread into its cpu data; the CPU is found by the vCPU's
+ * index, which is the "reg" of its device-tree node (the PSCI target ArmCpu passed).
+ */
+void
+hosted_secondary_entry(struct xh_cpu *cpu)
+{
+	int         number = ml_get_cpu_number(cpu->index);
+	cpu_data_t *cdp = (number >= 0 && number < MAX_CPUS) ? CpuDataEntries[number].cpu_data_vaddr : NULL;
+
+	(void)hosted_irq_mask();
+	if (cdp == NULL || cdp->cpu_active_thread == NULL || cdp->intstack_top == 0) {
+		hosted_secondary_park("hosted: a vCPU was started that XNU has no CPU data or first thread for, index", cpu->index);
+	}
+	cpu->kernel_data = (uint64_t)cdp;
+	os_atomic_inc(&hosted_smp_stats.cpus_entered, relaxed);
+	hosted_switch_to_stack(cdp, cdp->intstack_top, hosted_secondary_run);
+}
+
+/* ---- the deadline timer ---------------------------------------------------------------------- */
+
+/* The CNTVCT_EL0 value each vCPU's timer was last set to; UINT64_MAX before the first set. */
+static uint64_t hosted_timer_deadline[MAX_CPUS] = { [0 ... MAX_CPUS - 1] = UINT64_MAX };
+
+static inline unsigned
+hosted_timer_slot(void)
+{
+	unsigned index = hosted_cpu()->index;
+	return index < MAX_CPUS ? index : 0;
+}
+
+/* CNTV_TVAL_EL0 = ticks: the timer fires `ticks` counter ticks from now (at once if not positive). Masked. */
+void
+hosted_timer_set(int32_t ticks)
+{
+	uint64_t deadline = __builtin_arm_rsr64("CNTVCT_EL0") + (uint64_t)(int64_t)ticks;
+
+	hosted_timer_deadline[hosted_timer_slot()] = deadline;
+	hosted_smp_stats.timer_sets++;
+	(void)HSC(timer_set, deadline);
+}
+
+/* What CNTV_TVAL_EL0 would read: the ticks left, negative once the deadline has passed. Masked. */
+uint32_t
+hosted_timer_get(void)
+{
+	uint64_t deadline = hosted_timer_deadline[hosted_timer_slot()];
+	int64_t  left;
+
+	if (deadline == UINT64_MAX) {
+		return 0x7fffffff;
+	}
+	left = (int64_t)(deadline - __builtin_arm_rsr64("CNTVCT_EL0"));
+	if (left > 0x7fffffff) {
+		left = 0x7fffffff;
+	} else if (left < -0x7fffffff) {
+		left = -0x7fffffff;
+	}
+	return (uint32_t)(int32_t)left;
+}
+
+/* CNTV_CTL_EL0.ISTATUS. */
+bool
+hosted_timer_pending(void)
+{
+	uint64_t deadline = hosted_timer_deadline[hosted_timer_slot()];
+
+	return deadline != UINT64_MAX && __builtin_arm_rsr64("CNTVCT_EL0") >= deadline;
+}
+
+#endif /* XNU_HOSTED */
