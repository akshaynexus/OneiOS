diff --git a/osfmk/arm64/hosted/hosted_machine.c b/osfmk/arm64/hosted/hosted_machine.c
--- a/osfmk/arm64/hosted/hosted_machine.c
+++ b/osfmk/arm64/hosted/hosted_machine.c
@@ -692,6 +692,9 @@
 hosted_user_backtrace_start(void)
 {
 	thread_t thread = THREAD_NULL;
+	/* 0027: decided and said here, on bsd_init's thread: its first caller may have interrupts masked (no console) */
+	extern bool hosted_user_pac_off(void);
+	(void)hosted_user_pac_off();
 	if (!PE_parse_boot_argn("oneios-ubt", hosted_ubt_names, sizeof(hosted_ubt_names)) || hosted_ubt_names[0] == 0) {
 		return;
 	}
@@ -702,3 +705,47 @@
 	}
 }
 #endif /* XNU_HOSTED */
+
+#if XNU_HOSTED
+/*
+ * OneiOS hosted (0027): user pointer authentication off on a host with a narrow user address space.
+ *
+ * A pointer's authentication code sits in the bits above the address: from bit 64 - T0SZ up to bit 54. iOS user
+ * code is built for the iPhone's 47-bit user addresses and does not always strip a signed pointer with the
+ * instruction: libobjc takes a class's signed isa with a constant mask (realizeClassWithoutSwift: `and x0, x8,
+ * #0x7fffffffff8`, bits 3..42), which is right when the code starts at bit 47 and under qemu-user (48 bits).
+ * The S24 Ultra's Linux gives user space 39 bits, so the CPU puts the code in bits 39..54 and that mask leaves
+ * four bits of it in the address: the first process of the first phone boot (newfs_apfs) died in objc's
+ * map_images with a fault at 0x81f8d4ed30, the metaclass 0x1f8d4ed30 with bit 39 of its code left in.
+ *
+ * The host's address width cannot be changed, so on such a host iOS user space runs without pointer
+ * authentication, the state XNU already has for it: arm_user_jop_disabled() is true, so the kernel signs nothing
+ * it hands to user space (the shared cache's pointers at page-in, dyld's pager, thread states, the signal
+ * trampoline's token), and every task thread runs with the four keys off (hosted_user.c; the host needs
+ * PR_PAC_SET_ENABLED_KEYS, XH_FEATURE_PAC_KEYS_OFF), where pac*, aut* and the authenticated branches are plain
+ * instructions. The kernel's own pointers stay signed. Boot argument oneios-user-pac=1 or =0 forces it either way.
+ */
+bool hosted_user_pac_off(void);
+bool
+hosted_user_pac_off(void)
+{
+	static int off = -1;
+	if (off < 0) {
+		uint32_t wanted = 0;
+		bool narrow = hosted_info.user_va_bits != 0 && hosted_info.user_va_bits < 47;
+		bool decided = narrow;
+		if (PE_parse_boot_argn("oneios-user-pac", &wanted, sizeof(wanted))) {
+			decided = wanted == 0;
+		}
+		off = decided;
+		if (decided) {
+			printf("hosted: iOS user space runs without pointer authentication: the host's user addresses are %u bits wide "
+			    "(%s)%s\n", hosted_info.user_va_bits,
+			    narrow ? "the codes would start below bit 47, inside what iOS code takes for the address" : "asked for with oneios-user-pac=0",
+			    (hosted_info.features & XH_FEATURE_PAC_KEYS_OFF) ? "" :
+			    "; THIS HOST CANNOT TURN A THREAD'S KEYS OFF (no PR_PAC_SET_ENABLED_KEYS): user code will fail its own checks");
+		}
+	}
+	return off != 0;
+}
+#endif /* XNU_HOSTED */
