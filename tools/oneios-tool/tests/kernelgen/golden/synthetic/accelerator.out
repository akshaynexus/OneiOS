extern "C" void native_adreno_note_property_read(const char *);
// OneiOS (OneiOSAdreno.cpp): the A56 accelerator's open types and its CPU-composition processes.
extern "C" bool oneios_gpu_open_refused(uint32_t type);
extern "C" bool oneios_gpu_discovery_hidden(const char *key);
extern "C" bool oneios_gpu_discovery_hidden_here(void);
// (before anchor 1)
class AGXAccelerator : public IOAcceleratorES {
    OSObject *copyProperty(const char *key) const APPLE_KEXT_OVERRIDE;
    bool serializeProperties(OSSerialize *s) const APPLE_KEXT_OVERRIDE;
};
// (before anchor 2)
