// OneiOS: the offer with the frame's NGP format (1 B,G,R,X; 2 half floats of linear light, LegacyDisplayProbe.cpp).
extern "C" bool oneios_virtio_gpu_offer_format(void *display, IOMemoryDescriptor *memory, uint64_t stride, uint32_t width,
