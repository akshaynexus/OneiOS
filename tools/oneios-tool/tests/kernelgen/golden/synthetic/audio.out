void DroidVMAudioDevice::engineMain(void *self, wait_result_t) { static_cast<DroidVMAudioDevice *>(self)->run(); }

// OneiOS (fix-audio-late): the engine's thread (the caller) as a time-constraint thread of one period: period and
// constraint 5 ms, computation 2.5 ms (XNU raises a computation under half the constraint to that). A kernel thread
// is at 81 otherwise, under the VM's pageout and compressor threads (91) and the high thread calls (93). The guest's
// scheduler only: xnuhost's vCPUs stay SCHED_OTHER Linux threads. One line per device, at its first start.
void DroidVMAudioDevice::oneiosRealtime() {
    if (!oneios_audio_rt) return;
    thread_time_constraint_policy_data_t policy;
    policy.period = uint32_t(absolute(PeriodFrames));
    policy.computation = uint32_t(absolute(PeriodFrames / 2));
    policy.constraint = uint32_t(absolute(PeriodFrames));
    policy.preemptible = TRUE;
    const kern_return_t kr = thread_policy_set(current_thread(), THREAD_TIME_CONSTRAINT_POLICY,
                                               reinterpret_cast<thread_policy_t>(&policy), THREAD_TIME_CONSTRAINT_POLICY_COUNT);
    if (kr == KERN_SUCCESS) { const uint32_t n = oneios_audio_rt_set + 1; oneios_audio_rt_set = n; }
    else { const uint32_t n = oneios_audio_rt_refused + 1; oneios_audio_rt_refused = n; }
    if (oneiosRealtimeSaid && kr == KERN_SUCCESS) return;
    oneiosRealtimeSaid = true;
    if (kr == KERN_SUCCESS)
        IOLog("DroidVMAudio: %s engine: realtime in the guest (period 5 ms, computation 2.5 ms, constraint 5 ms), its wait "
              "without timer slop (oneios-audio-rt=1)\n", uid);
    else
        IOLog("DroidVMAudio: %s engine: thread_policy_set refused the time constraint (0x%x): kernel priority, its wait "
              "without timer slop (oneios-audio-rt=1)\n", uid, kr);
}

// OneiOS (fix-audio-late): until the period's deadline. clock_delay_until waits with SYS_NORMAL urgency, which gives a
// kernel thread's timer the kernel tier's slop (an eighth of the wait, at most 1 ms, more at a user idle level);
// SYS_CRITICAL has none. oneios-audio-rt=0: clock_delay_until, as before.
void DroidVMAudioDevice::oneiosWait(uint64_t deadline) {
    if (!oneios_audio_rt) { clock_delay_until(deadline); return; }
    if (mach_absolute_time() >= deadline) return;
    assert_wait_deadline_with_leeway(reinterpret_cast<event_t>(&oneios_audio_rt), THREAD_UNINT, TIMEOUT_URGENCY_SYS_CRITICAL,
                                     deadline, 0);
    thread_block(THREAD_CONTINUE_NULL);
}

// OneiOS (fix-audio-latency): the speaker at the start of its period `done` (the deadline has passed): the zero time
// stamp of a wrap the last period crossed (in the past now, as a DMA wrap's), and the timing counters: how late the
// period was taken (us), how far ahead of it the HAL has written (its write end: iOS's I/O buffer and safety offset as
// used), and whether that came within a period of overwriting what is not yet taken (the ring too small for them).
void DroidVMAudioDevice::oneiosSpeakerPeriod(uint64_t deadline, uint64_t done) {
    EngineStatus *s = status();
    const uint64_t wrap = done / ringFrames * ringFrames;
    if (done && wrap + PeriodFrames > done) {
        s->hostTime = startTime + absolute(wrap);
        __asm__ volatile("dmb ish" ::: "memory");
        s->sampleTime = wrap;
        __asm__ volatile("dmb ish" ::: "memory");
    }
    const uint64_t now = mach_absolute_time();
    uint64_t late = 0;
    if (now > deadline) absolutetime_to_nanoseconds(now - deadline, &late);
    late /= 1000;
    oneios_speaker_periods = oneios_speaker_periods + 1;
    oneios_speaker_late_sum = oneios_speaker_late_sum + late;
    if (late > oneios_speaker_late_max) oneios_speaker_late_max = late;
    // OneiOS (fix-audio-late): the late ones by how late.
    if (late > 1000) oneios_speaker_late_1ms = oneios_speaker_late_1ms + 1;
    if (late > 5000) oneios_speaker_late_5ms = oneios_speaker_late_5ms + 1;
    if (late > 20000) oneios_speaker_late_20ms = oneios_speaker_late_20ms + 1;
    const uint64_t written = s->writeEnd;
    oneios_speaker_lead_last = written;
    // OneiOS (fix-audio-late): the HAL had written this period only in part (its I/O thread late, not the engine).
    if (written > done && written < done + PeriodFrames) oneios_speaker_short = oneios_speaker_short + 1;
    if (written <= done) return;
    const uint64_t lead = written - done;
    oneios_speaker_leads = oneios_speaker_leads + 1;
    oneios_speaker_lead_sum = oneios_speaker_lead_sum + lead;
    if (lead < oneios_speaker_lead_min) oneios_speaker_lead_min = lead;
    if (lead > oneios_speaker_lead_max) oneios_speaker_lead_max = lead;
    if (lead + PeriodFrames > ringFrames) oneios_speaker_tight = oneios_speaker_tight + 1;
}

// OneiOS (fix-audio-volume): VirtualAudio's volume through the HAL's SetControlValue: the step (clamped to 0..128), its
// gain for the engine, and the description again (on the device and the client: the HAL reads it through both). The
// first 16 changes are logged, then every 64th.
uint32_t DroidVMAudioDevice::oneiosSetVolume(uint64_t value, IORegistryEntry *client) {
    const int32_t asked = int32_t(uint32_t(value));
    const uint32_t v = asked < 0 ? 0 : asked > int32_t(OneiosVolumeSteps) ? OneiosVolumeSteps : uint32_t(asked);
    const bool changed = v != oneios_speaker_volume;
    oneios_speaker_gain = oneiosGain(v);   // OneiOS (fix-audio-curve): the curve's gain and dB
    oneios_speaker_db10 = oneiosDb10(v);
    oneios_speaker_volume = v;
    if (OSArray *a = oneiosControls(true)) {
        setProperty("controls", a);
        if (client) client->setProperty("controls", a);
        a->release();
    }
    if (changed) {
        const uint32_t n = oneios_speaker_volume_sets + 1;   // no read of a volatile assignment (C++20)
        oneios_speaker_volume_sets = n;
        const uint32_t down = oneios_speaker_db10;   // OneiOS (fix-audio-curve): tenths of a dB below 0 dB
        if (n <= 16 || n % 64 == 0)
            IOLog("DroidVMAudio: speaker volume %u of %u (%s%u.%u dB, gain %u of 65536), change %u: iOS's volume, applied here "
                  "(the host plays at full scale; curve %s)\n", v, (unsigned)OneiosVolumeSteps, v == 0 ? "silent, -" : down ? "-" : "",
                  down / 10, down % 10, oneios_speaker_gain, n,
                  oneios_audio_curve ? "sheng: -36 dB x (1 - v/128)^2, oneios-audio-curve=1" : "linear -64..0 dB, oneios-audio-curve=0");
    }
    return v;
}
