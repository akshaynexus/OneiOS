uint32_t oneiosGain(uint32_t v) { return oneios_audio_curve ? oneios_volume_gain_sheng[v] : oneios_volume_gain[v]; }
uint32_t oneiosDb10(uint32_t v) { return oneios_audio_curve ? oneios_volume_db10_sheng[v] : (OneiosVolumeSteps - v) * 5; }
OSArray *oneiosControls(bool volume) {
    OSArray *list = OSArray::withCapacity(1);
    if (!list || !volume) return list;
    OSDictionary *c = OSDictionary::withCapacity(12), *range = OSDictionary::withCapacity(4);
    OSArray *map = OSArray::withCapacity(1);
    if (c && range && map) {
        setNumber(c, "control ID", OneiosVolumeID);
        setNumber(c, "base class", 0x6c65766c);   // 'levl'
        setNumber(c, "class", 0x766c6d65);        // 'vlme'
        setNumber(c, "scope", 0x6f757470);        // 'outp'
        setNumber(c, "element", 0);
        c->setObject("read only", kOSBooleanFalse);
        setNumber(c, "value", oneios_speaker_volume);
        setNumber(c, "minimum value", 0);
        setNumber(c, "maximum value", OneiosVolumeSteps);
        setNumber(range, "start int value", 0);
        // OneiOS (fix-audio-curve): -36..0 dB in 0.28125 dB steps (the curve's ends), or -64..0 in 0.5 dB steps.
        setNumber(range, "start db value", uint64_t(int64_t(oneios_audio_curve ? -36 : -64) * (int64_t(1) << 32)), 64);
        setNumber(range, "integer steps", OneiosVolumeSteps);
        setNumber(range, "db per step", oneios_audio_curve ? uint64_t(0x48000000) : uint64_t(1) << 31, 64);
        map->setObject(range);
        c->setObject("range map", map);
        list->setObject(c);
    }
    OSSafeReleaseNULL(c); OSSafeReleaseNULL(range); OSSafeReleaseNULL(map);
    return list;
}
