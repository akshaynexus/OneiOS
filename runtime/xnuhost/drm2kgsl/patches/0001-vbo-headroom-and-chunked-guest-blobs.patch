+/* ONEIOS: drm2kgsl_renderer_set_guest_blob_fd() for a blob whose pages come as `n` dma-bufs, in
+ * the blob's order, `sizes[i]` bytes each (whole pages). Takes the fds, also when it fails. With
+ * n == 1 it is set_guest_blob_fd(). Called by xnuhost (runtime/xnuhost/src/gpu3d_kgsl.c). */
+int drm2kgsl_renderer_set_guest_blob_chunks(struct virgl_context *vctx, uint64_t blob_id,
+                                            const int *fds, const uint64_t *sizes, unsigned n);
+int
+drm2kgsl_renderer_set_guest_blob_chunks(struct virgl_context *vctx, uint64_t blob_id,
+                                        const int *fds, const uint64_t *sizes, unsigned n)
+{
+   struct kgsl_context *kctx = to_kgsl_context(to_drm_context(vctx));
+
+   if (!n)
+      return -EINVAL;
+   if (kctx->pending_chunks) {
+      drm_err("guest blob chunks already pending (blob_id=%" PRIu64 "); dropping the stale ones",
+              blob_id);
+      kgsl_chunks_drop(kctx->base.fd, kctx->pending_chunks, kctx->pending_nr_chunks);
+      kctx->pending_chunks = NULL;
+      kctx->pending_nr_chunks = 0;
+   }
+   if (n == 1)
+      return drm2kgsl_renderer_set_guest_blob_fd(vctx, blob_id, fds[0]);
+
+   uint64_t total;
+   struct kgsl_chunk *chunks = kgsl_chunks_new(fds, sizes, n, false, &total);
+   if (!chunks)
+      return -ENOMEM;
+   kctx->pending_chunks = chunks;
+   kctx->pending_nr_chunks = n;
+   return 0;
+}
