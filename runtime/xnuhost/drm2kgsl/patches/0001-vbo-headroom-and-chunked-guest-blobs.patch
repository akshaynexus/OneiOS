+/* ONEIOS: chunk helpers. Imports every chunk's dma-buf; on failure nothing stays imported and the
+ * fds are closed. `chunks` is owned by the caller until it is put in an object. */
+static void
+kgsl_chunks_drop(int fd, struct kgsl_chunk *chunks, uint32_t n)
+{
+   for (uint32_t i = 0; i < n; i++) {
+      if (chunks[i].mem_id)
+         kgsl_free_gpuobj(fd, chunks[i].mem_id);
+      if (chunks[i].fd >= 0)
+         close(chunks[i].fd);
+   }
+   free(chunks);
+}
+
+static int
+kgsl_chunks_import(int fd, struct kgsl_chunk *chunks, uint32_t n, uint32_t kgsl_flags)
+{
+   for (uint32_t i = 0; i < n; i++) {
+      chunks[i].mem_id = kgsl_import_dmabuf(fd, chunks[i].fd, kgsl_flags);
+      if (!chunks[i].mem_id)
+         return -ENOMEM;
+   }
+   return 0;
+}
+
+static struct kgsl_chunk *
+kgsl_chunks_new(const int *fds, const uint64_t *sizes, unsigned n, bool dup_fds, uint64_t *total)
+{
+   struct kgsl_chunk *chunks = calloc(n, sizeof(*chunks));
+   bool bad = !chunks;
+   *total = 0;
+   for (unsigned i = 0; i < n && chunks; i++) {
+      chunks[i].fd = dup_fds ? os_dupfd_cloexec(fds[i]) : fds[i];
+      chunks[i].size = sizes[i];
+      if (chunks[i].fd < 0 || !sizes[i] || (sizes[i] & 0xfff))
+         bad = true;
+      *total += sizes[i];
+   }
+   if (!bad)
+      return chunks;
+   for (unsigned i = 0; i < n; i++) {      /* fds given to us are closed here too */
+      int fd = chunks ? chunks[i].fd : dup_fds ? -1 : fds[i];
+      if (fd >= 0)
+         close(fd);
+   }
+   free(chunks);
+   return NULL;
+}
