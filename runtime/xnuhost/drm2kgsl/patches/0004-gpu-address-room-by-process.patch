--- a/src/drm/drm2kgsl/drm2kgsl_renderer.c	2026-11-12 10:43:32
+++ b/src/drm/drm2kgsl/drm2kgsl_renderer.c	2026-11-12 10:43:32
@@ -338,6 +338,65 @@
 static uint64_t g_va_slices_used; /* bitmask; bit i = slice i in use */
 static uint64_t g_va_slice_size;  /* per-context slice size (set at init) */
 static unsigned g_va_nslices;     /* number of slices carved (<= KGSL_VA_MAX_SLICES) */
+/* ONEIOS: slices of two sizes, cut from the VBO in 1 GiB units as contexts come (the equal slices above are not used).
+ * Every process that draws with Metal on an iOS guest holds two contexts, so 32 equal slices of 6 GiB were 16 processes,
+ * too few once every process may use the GPU. The render server maps every client's surfaces into its own address space
+ * (an iPadOS one held 1.8 GB of a 2 GB slice at an idle home screen), a client only its own work. A context whose name
+ * (the guest's "xnu:<process>") is in DRM2KGSL_VA_RENDER_NAMES (default "xnu:backboardd", comma-separated) gets
+ * DRM2KGSL_VA_RENDER_GB (default 12); any other DRM2KGSL_VA_CLIENT_GB (default 2, KGSL_VA_SLICE_MIN: turnip takes va_size
+ * as the context's whole budget). On a 192 GiB VBO: 2 x 12 for the render server and 84 contexts of 2 GiB, 42 processes.
+ * A context that finds no room fails to be made (an error the guest's Metal plug-in reports as no device, and the process
+ * draws without the GPU), and the log says so with the room left. */
+#define ONEIOS_VA_UNIT_SHIFT 30
+#define ONEIOS_VA_MAX_UNITS 512
+static uint64_t g_va_units_used[ONEIOS_VA_MAX_UNITS / 64];
+static unsigned g_va_units;       /* the VBO's size in units (set at init) */
+static unsigned g_va_units_live;  /* units held by live contexts */
+static unsigned g_va_contexts_live;
+
+static bool
+oneios_va_unit_used(unsigned i)
+{
+   return g_va_units_used[i / 64] & (1ull << (i % 64));
+}
+
+static void
+oneios_va_unit_set(unsigned i, bool used)
+{
+   if (used)
+      g_va_units_used[i / 64] |= 1ull << (i % 64);
+   else
+      g_va_units_used[i / 64] &= ~(1ull << (i % 64));
+}
+
+/* How many units a context of this name gets. */
+static unsigned
+oneios_va_units_for(size_t debug_len, const char *debug_name)
+{
+   static uint64_t render_gb = 12, client_gb = KGSL_VA_SLICE_MIN >> ONEIOS_VA_UNIT_SHIFT;
+   static const char *names;
+   static bool read;
+   if (!read) {
+      kgsl_parse_u64_env("DRM2KGSL_VA_RENDER_GB", &render_gb);
+      kgsl_parse_u64_env("DRM2KGSL_VA_CLIENT_GB", &client_gb);
+      names = getenv("DRM2KGSL_VA_RENDER_NAMES");
+      if (!names)
+         names = "xnu:backboardd";
+      if (client_gb < (KGSL_VA_SLICE_MIN >> ONEIOS_VA_UNIT_SHIFT))
+         client_gb = KGSL_VA_SLICE_MIN >> ONEIOS_VA_UNIT_SHIFT;
+      if (render_gb < client_gb)
+         render_gb = client_gb;
+      read = true;
+   }
+   size_t length = debug_name ? strnlen(debug_name, debug_len) : 0;
+   for (const char *at = names; *at;) {
+      size_t n = strcspn(at, ",");
+      if (n && n == length && !strncmp(at, debug_name, n))
+         return (unsigned)MIN2(render_gb, (uint64_t)ONEIOS_VA_MAX_UNITS);
+      at += n + (at[n] == ',');
+   }
+   return (unsigned)MIN2(client_gb, (uint64_t)ONEIOS_VA_MAX_UNITS);
+}
 
 static const char dma_heap_path[] = "/dev/dma_heap/system";
 
