#!/usr/bin/env python3
"""The image build's userland hook (docs/image-format.md section 6, hook API 1): runs roottweak on the Data seed.

image-build's `scripts/image/build.sh` runs this once with ONEIOS_* in the environment. The OS, SystemOS and App
images are never edited (the sealed layout), so everything here is a change to the Data seed (ONEIOS_DATA),
a file for the image set's overlay/ (ONEIOS_OVERLAY) or a line of the boot contract.

Leaves in ONEIOS_OVERLAY/userland/: bin/oneios-seed (the first-start unpacker of the Data seed, when the helpers
are built), boot-contract.json (for the booter and the kernel), owner-trust.json (for the
trust cache), xnuhost.conf (the UI scale, for xnuhost), tweaks.manifest.json, report.txt, report.json. Owners go to ONEIOS_OWNERS, a summary to ONEIOS_INFO.

Optional inputs, each used when it is there:
  ONEIOS_HELPERS        signed guest helpers (default out/userland/helpers, from userland/helpers/build.sh)
  ONEIOS_METAL_PLUGIN   a built Metal plugin bundle (default out/userland/NativeAdrenoMetal.bundle, from
                        userland/metal/build.sh); its build record NativeAdrenoMetal.build.json beside it is checked
  ONEIOS_SCALE          the UI scale, 3 (default) or 2: the device tree's, MobileGestalt's and xnuhost's (xnuhost.conf)
  ONEIOS_ROOTTWEAK_ARGS more `roottweak apply` arguments, split like a shell line (--group fewest, --disable LABEL)
"""
import json
import os
import shlex
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
from roottweak import cli, macho  # noqa: E402


def main():
    env = os.environ
    if env.get('ONEIOS_HOOK_API') != '1':
        sys.exit(f'image-hook: hook API {env.get("ONEIOS_HOOK_API")!r}, this hook speaks 1')
    try:
        os_root, data, overlay = env['ONEIOS_OS_ROOT'], env['ONEIOS_DATA'], env['ONEIOS_OVERLAY']
    except KeyError as e:
        sys.exit(f'image-hook: {e.args[0]} is not set')
    out = os.path.join(overlay, 'userland')
    repo = os.path.dirname(HERE)
    args = ['apply', '--layout', 'sealed', '--root', os_root, '--data', data, '--out', out]
    if env.get('ONEIOS_BUILD'):
        args += ['--build', env['ONEIOS_BUILD']]
    helpers = env.get('ONEIOS_HELPERS') or os.path.join(repo, 'out/userland/helpers')
    if os.path.isdir(helpers):
        args += ['--helpers', helpers]
    plugin = env.get('ONEIOS_METAL_PLUGIN') or os.path.join(repo, 'out/userland/NativeAdrenoMetal.bundle')
    if os.path.isdir(plugin):
        args += ['--metal-plugin', plugin]
    if env.get('ONEIOS_SCALE'):
        args += ['--scale', env['ONEIOS_SCALE']]
    args += shlex.split(env.get('ONEIOS_ROOTTWEAK_ARGS', ''))
    status = cli.main(args)
    if status:
        return status

    # The first-start unpacker runs before the Data volume exists, so it cannot be in the seed: it goes into the
    # overlay for xnuhost to hand to the guest, and its CDHash into the owner trust list.
    seed_tool = os.path.join(helpers, 'oneios-seed')
    first_start = None
    if os.path.isfile(seed_tool):
        with open(seed_tool, 'rb') as f:
            binary = f.read()
        try:
            slices = macho.describe(binary)
        except macho.MachOError as e:
            sys.exit(f'image-hook: {seed_tool}: {e}; the guest runs only signed code')
        os.makedirs(os.path.join(out, 'bin'), exist_ok=True)
        with open(os.path.join(out, 'bin', 'oneios-seed'), 'wb') as f:
            f.write(binary)
        os.chmod(os.path.join(out, 'bin', 'oneios-seed'), 0o755)
        with open(os.path.join(out, 'owner-trust.json')) as f:
            trust = json.load(f)
        for s in slices:
            trust['files'].append({'path': 'overlay/userland/bin/oneios-seed', 'cdhash': s['cdhash'], 'hash': s['hash'],
                                   'identifier': s['identifier'], 'arch': s['arch'], 'page_size': s['page_size'],
                                   'adhoc': s['adhoc'], 'warnings': []})
        trust['cdhashes'] = sorted({t['cdhash'] for t in trust['files']})
        with open(os.path.join(out, 'owner-trust.json'), 'w') as f:
            json.dump(trust, f, indent=2, sort_keys=True)
            f.write('\n')
        first_start = 'overlay/userland/bin/oneios-seed'

    # The plug-in's build record (userland/metal/build.sh writes NativeAdrenoMetal.build.json beside the bundle, with the
    # CDHash of each binary as the build signed it): when the bundle was placed, the trust list must hold exactly those.
    # A bundle changed after its build (re-signed, a file swapped) stops the image build here, not at the guest's AMFI.
    metal = None
    record = plugin.rstrip('/')[:-len('.bundle')] + '.build.json' if plugin.rstrip('/').endswith('.bundle') else None
    if record and os.path.isfile(record):
        with open(record) as f:
            built = json.load(f)
        with open(os.path.join(out, 'owner-trust.json')) as f:
            trust = json.load(f)
        with open(os.path.join(out, 'boot-contract.json')) as f:
            placed = 'metal' in json.load(f)
        if placed:
            missing = sorted(set(built['cdhashes']) - set(trust['cdhashes']))
            if missing:
                sys.exit(f'image-hook: {record} lists CDHashes the placed bundle does not have ({", ".join(missing)}): '
                         'the bundle changed after it was built; run userland/metal/build.sh again')
        metal = {'placed': placed, 'target': built.get('target'), 'cdhashes': built['cdhashes'],
                 'sdk': (built.get('sdk') or {}).get('version'), 'record': os.path.basename(record)}

    with open(os.path.join(out, 'tweaks.manifest.json')) as f:
        manifest = json.load(f)
    owners = env.get('ONEIOS_OWNERS')
    if owners:
        with open(owners, 'a') as f:
            for e in manifest['entries']:
                if e['volume'] == 'data' and 'uid' in e:
                    f.write(f'{e["path"]}\t{e["uid"]}\t{e["gid"]}\t{e.get("mode", "-")}\n')
    info = env.get('ONEIOS_INFO')
    if info:
        with open(os.path.join(out, 'report.json')) as f:
            report = json.load(f)
        with open(os.path.join(out, 'boot-contract.json')) as f:
            contract = json.load(f)
        with open(os.path.join(out, 'owner-trust.json')) as f:
            trust = json.load(f)
        with open(info, 'w') as f:
            json.dump({
                'tool': 'userland/roottweak', 'schema': manifest['schema'], 'layout': 'sealed', 'build': report['build'],
                'contract': 'overlay/userland/boot-contract.json', 'owner_trust': 'overlay/userland/owner-trust.json',
                'first_start_unpacker': first_start,
                'disabled_jobs': len(contract['launch_policy']['disable_jobs']),
                'owner_cdhashes': len(trust['cdhashes']),
                'metal_plugin': metal,
                'off': [f'{r["item"]}: {r["note"]}' for r in report['results'] if r['state'] == 'off'],
                'not_found': [r['item'] for r in report['results'] if r['state'] == 'not-found'],
            }, f, indent=2)
    return 0


if __name__ == '__main__':
    sys.exit(main())
