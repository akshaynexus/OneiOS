+/* OneiOS: the cached BOs that sat in the cache for `age_ms` or longer, no allocation having taken them, go back to the host: the
+ * bytes released. The Metal plug-in's GPU memory row calls it every 60 s with 30000 (userland/metal/CommandPoolRow.inc; boot
+ * argument oneios-bo-cache-idle=0: never called). The cache went back only past its budgets or at a memory pressure rise, so a
+ * process that went still kept it full: the render server's 78 MiB at a still screen (oneios-gpu-text "tuc 78M", 2026-11-23), every
+ * BO wired guest memory. A BO asked for again within the age is a hit as before; one asked later is a new BO, as past the budget. */
+extern "C" __attribute__((visibility("default"))) uint64_t tu_darwin_bo_cache_trim_idle(uint64_t age_ms);
+extern "C" __attribute__((visibility("default"))) uint64_t
+tu_darwin_bo_cache_trim_idle(uint64_t age_ms)
+{
+   struct darwin_retire_state *retire = darwin_stats_state;
+   struct tu_device *dev = darwin_stats_dev;
+   if (!retire || !dev)
+      return 0;
+   const uint64_t age = age_ms * 1000000ull;
+   uint64_t released = 0;
+   pthread_mutex_lock(&retire->lock);
+   const uint64_t now = os_time_get_nano();
+   /* From the end: an eviction moves the last entry into the slot, one already looked at. */
+   for (unsigned i = retire->cache_count; i-- > 0;) {
+      const struct darwin_cached_bo *e = &retire->cache[i];
+      if (now - e->cached_ns < age)
+         continue;
+      const uint64_t size = e->size;
+      const VkResult result = darwin_cache_evict(dev, retire, i);
+      if (result == VK_SUCCESS)
+         released += size;
+      else if (result != VK_NOT_READY)
+         break;   /* the device is lost (darwin_release_native said so) */
+   }
+   pthread_mutex_unlock(&retire->lock);
+   return released;
+}
