diff --git a/crates/metal2vulkan-runtime/src/tests/idle_spares.rs b/crates/metal2vulkan-runtime/src/tests/idle_spares.rs
new file mode 100644
index 000000000..60ddd0bde
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/tests/idle_spares.rs
@@ -0,0 +1,78 @@
+//! OneiOS: the idle trim (`Device::trim_kept_memory` with an idle span, the Metal plug-in's two
+//! seconds) frees the images the recycler parked past its second (`recycle.rs`) and the spare
+//! dedicated image blocks past `SPARE_FOR` (`memory.rs`), which went only as another object was
+//! parked, taken or returned; and `m2v_memory_census` counts the spares apart from the kept empty
+//! pooled blocks.
+//!
+//! Device tests: compiled only under the validation crate's GPU safety cfgs (`m2v_gpu`,
+//! `m2v_cpu_icd`), on the kind of device the cfg selects.
+
+use super::blit_holds::{device, Scratch};
+use crate::device::lock;
+use crate::memory::{m2v_memory_census, SPARE_FOR};
+use crate::{ResourceOptions, TextureDescriptor};
+use metal2vulkan::metal::{PixelFormat, TextureUsage};
+use std::time::{Duration, Instant};
+
+/// The census words of `m2v_memory_census`.
+fn census() -> [u64; 16] {
+    let mut words = [0; 16];
+    assert_eq!(m2v_memory_census(words.as_mut_ptr(), words.len()), 16);
+    words
+}
+
+const DEDICATED: usize = 5;
+const SPARES: usize = 7;
+const SPARE_BYTES: usize = 8;
+const IDLE_FREED: usize = 11;
+
+/// The plug-in's idle span.
+const IDLE: Duration = Duration::from_millis(2000);
+
+#[test]
+fn the_idle_trim_frees_parked_images_and_spares_past_their_spans() {
+    let scratch = Scratch::new("idle-spares");
+    let device = device(&scratch.0);
+    let shared = device.shared();
+    let spares = || lock(&shared.memory).spare_count();
+    let dedicated = || lock(&shared.memory).census().dedicated;
+    // A private render target past half a pooled block (64 MiB): a dedicated block of its own.
+    let mut descriptor = TextureDescriptor::texture_2d(PixelFormat::RGBA8Unorm, 4096, 4096, false);
+    descriptor.usage = TextureUsage::RENDER_TARGET | TextureUsage::SHADER_READ;
+    descriptor.resource_options = ResourceOptions::private();
+    let before = dedicated();
+    let texture = device.new_texture(&descriptor).unwrap();
+    assert_eq!(dedicated(), before + 1, "the texture has a dedicated block");
+    // Gone, its image is parked for the next of its making, its block with it.
+    drop(texture);
+    assert_eq!(dedicated(), before + 1, "the parked image keeps its block");
+    let start = Instant::now();
+    let freed_before = census()[IDLE_FREED];
+    // The trim within the recycler's second: the parked image stays.
+    device.trim_kept_memory_at(IDLE, start);
+    assert_eq!(dedicated(), before + 1, "an image parked under a second stays");
+    // Past its second, with nothing parked or taken in between: it goes, its block a spare (where
+    // the device's image memory is plain) or freed.
+    device.trim_kept_memory_at(IDLE, start + Duration::from_millis(1500));
+    assert_eq!(dedicated(), before, "the parked image went with the idle trim");
+    let words = census();
+    let spare = spares();
+    assert_eq!(words[SPARES], spare as u64, "the census counts the spares apart");
+    assert_eq!(words[DEDICATED], before, "the census's dedicated blocks leave the spares out");
+    if spare == 0 {
+        eprintln!("IDLE-SPARES: this device keeps no spare of the image's block (not plain); its block was freed");
+        assert_eq!(words[IDLE_FREED], freed_before + 1);
+        return;
+    }
+    assert_eq!(spare, 1, "the image's dedicated block is kept as a spare");
+    assert!(words[SPARE_BYTES] >= 64 << 20, "the spare's bytes: {}", words[SPARE_BYTES]);
+    // The trim within the spare's span: it stays.
+    device.trim_kept_memory_at(IDLE, start + Duration::from_secs(2));
+    assert_eq!(spares(), 1, "a spare younger than SPARE_FOR stays");
+    // Past the span, with no placement returned and no image made in between: it goes.
+    device.trim_kept_memory_at(IDLE, Instant::now() + SPARE_FOR + Duration::from_secs(1));
+    assert_eq!(spares(), 0, "the idle trim freed the spare past its span");
+    let words = census();
+    assert_eq!((words[SPARES], words[SPARE_BYTES]), (0, 0));
+    assert_eq!(words[IDLE_FREED], freed_before + 2, "the parked image and the spare");
+}
