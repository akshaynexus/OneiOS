     pub(crate) fn draw_resident_textures_looked_at(&self) {}
 }
+
+impl Counters {
+    /// OneiOS: the render encoders ended, the render pass instances of their passes begun, the
+    /// splits of their passes, and of those the splits at a memory barrier of the program's, read
+    /// with no lowering of deferred calls (`memory.rs`'s `m2v_memory_census`).
+    pub(crate) fn pass_census(&self) -> [u64; 4] {
+        let sum = |words: &[AtomicU64]| words.iter().map(|word| word.load(Ordering::Relaxed)).sum();
+        [
+            self.render_encoders_ended.load(Ordering::Relaxed),
+            sum(&self.render_passes_begun_by),
+            sum(&self.instance_splits_by),
+            self.instance_splits_by[Split::Barrier as usize].load(Ordering::Relaxed),
+        ]
+    }
+}
