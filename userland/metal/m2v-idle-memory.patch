+/// OneiOS: the spare blocks and the parked images and buffers the idle trim freed so far
+/// ([`m2v_memory_census`]'s twelfth word).
+static IDLE_FREED: AtomicU64 = AtomicU64::new(0);
+
+/// OneiOS: the last device's blocks by kind as its last trim found them ([`Memory::publish_census`]).
+static MEMORY_CENSUS: [AtomicU64; 11] = [const { AtomicU64::new(0) }; 11];
+
+/// OneiOS: the last device's render passes as its last trim found them (`Counters::pass_census`).
+static PASS_CENSUS: [AtomicU64; 4] = [const { AtomicU64::new(0) }; 4];
+
+/// OneiOS: the process's device memory as its last trim (every idle trim, the plug-in's two
+/// seconds) found it, into `out` (`count` words, at most 16): pooled blocks with a placement and
+/// their bytes, the bytes placed in them; kept empty pooled blocks and their bytes; dedicated
+/// blocks and their bytes; spare dedicated image blocks and their bytes; host memory imports and
+/// their bytes; the spare blocks and parked images and buffers the idle trim freed so far; then its render passes: the render
+/// encoders ended, the render pass instances of their passes begun, the splits of their passes,
+/// and of those the splits at a memory barrier of the program's. The words written.
+#[unsafe(no_mangle)]
+pub extern "C" fn m2v_memory_census(out: *mut u64, count: usize) -> usize {
+    if out.is_null() {
+        return 0;
+    }
+    let words = MEMORY_CENSUS
+        .iter()
+        .map(|word| word.load(Ordering::Relaxed))
+        .chain([IDLE_FREED.load(Ordering::Relaxed)])
+        .chain(PASS_CENSUS.iter().map(|word| word.load(Ordering::Relaxed)));
+    let mut written = 0;
+    for (at, value) in words.take(count).enumerate() {
+        // SAFETY: the caller's `count` words at `out`.
+        unsafe { *out.add(at) = value };
+        written += 1;
+    }
+    written
 }
 
