new file mode 100644
index 0000000..52000ed
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/xr_convert.comp
@@ -0,0 +1,135 @@
+// Apple's extended-range texels over a buffer <-> a texture's float image (`crate::xr`).
+//
+// Compiled to `xr_spv.rs` with:
+//   glslc --target-env=vulkan1.3 -O -mfmt=num -o - xr_convert.comp
+//   spirv-val --target-env vulkan1.3
+// The arithmetic is `crate::xr`'s reference (`decode`, `encode`), which the unit tests check over
+// every code; keep the two the same.
+//
+// One invocation converts four texels of a row, x = 4 * gid.x .. +3, so that a write of the
+// two-plane form's alpha plane is one whole word an invocation owns (its rows are words apart).
+#version 460
+#extension GL_EXT_buffer_reference : require
+#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
+#extension GL_EXT_nonuniform_qualifier : require
+
+layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
+
+layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words {
+    uint w[];
+};
+
+// Set 1's storage-texture array (`crate::arrays`); the texture's element is a view of its
+// `R16G16B16A16_SFLOAT` image.
+layout(set = 1, binding = 1, rgba16f) uniform image2D images[];
+
+layout(push_constant) uniform Push {
+    uint64_t color;     // the colour plane's first texel, 4-byte aligned
+    uint64_t alpha;     // the two-plane form's alpha plane, 4-byte aligned (0 for the others)
+    uint color_row;     // bytes, a multiple of 4
+    uint alpha_row;     // bytes, a multiple of 4
+    uint width;
+    uint height;
+    uint image;         // the storage element's index
+    uint flags;         // bit 0: encode (image -> buffer); bits 1-2: form (0 BGR10_XR, 1 BGRA10_XR,
+                        // 2 RGB10A8_2P_XR10); bit 3: sRGB colour
+} p;
+
+const float LOW = -384.0 / 510.0;
+const float HIGH = 639.0 / 510.0;
+
+float srgb_to_linear(float s) {
+    float a = abs(s);
+    float l = a <= 0.04045 ? a / 12.92 : pow((a + 0.055) / 1.055, 2.4);
+    return s < 0.0 ? -l : l;
+}
+
+float linear_to_srgb(float l) {
+    float a = abs(l);
+    float s = a <= 0.0031308 ? a * 12.92 : 1.055 * pow(a, 1.0 / 2.4) - 0.055;
+    return l < 0.0 ? -s : s;
+}
+
+float colour_of(uint code, bool srgb) {
+    float v = float(int(code) - 384) / 510.0;
+    return srgb ? srgb_to_linear(v) : v;
+}
+
+float alpha_of(uint code) {
+    return float(int(clamp(code, 384u, 894u)) - 384) / 510.0;
+}
+
+uint colour_code(float v, bool srgb) {
+    v = isnan(v) ? 0.0 : v;
+    v = srgb ? linear_to_srgb(v) : v;
+    v = clamp(v, LOW, HIGH);
+    return uint(clamp(int(roundEven(v * 510.0)) + 384, 0, 1023));
+}
+
+uint alpha_code(float v) {
+    v = isnan(v) ? 0.0 : clamp(v, 0.0, 1.0);
+    return uint(clamp(int(roundEven(v * 510.0)) + 384, 384, 894));
+}
+
+uint byte_code(float v) {
+    v = isnan(v) ? 0.0 : clamp(v, 0.0, 1.0);
+    return uint(roundEven(v * 255.0));
+}
+
+void main() {
+    uint y = gl_GlobalInvocationID.y;
+    uint x0 = gl_GlobalInvocationID.x * 4u;
+    if (y >= p.height || x0 >= p.width) {
+        return;
+    }
+    bool encode = (p.flags & 1u) != 0u;
+    uint form = (p.flags >> 1u) & 3u;
+    bool srgb = (p.flags & 8u) != 0u;
+    Words colour = Words(p.color + uint64_t(y) * uint64_t(p.color_row));
+    Words alphas = Words(p.alpha + uint64_t(y) * uint64_t(p.alpha_row));
+    uint n = min(4u, p.width - x0);
+    if (!encode) {
+        uint aw = form == 2u ? alphas.w[x0 / 4u] : 0u;
+        for (uint i = 0u; i < n; i++) {
+            uint x = x0 + i;
+            vec4 t;
+            if (form == 1u) {
+                uint lo = colour.w[2u * x];
+                uint hi = colour.w[2u * x + 1u];
+                t.b = colour_of((lo >> 6u) & 1023u, srgb);
+                t.g = colour_of((lo >> 22u) & 1023u, srgb);
+                t.r = colour_of((hi >> 6u) & 1023u, srgb);
+                t.a = alpha_of((hi >> 22u) & 1023u);
+            } else {
+                uint word = colour.w[x];
+                t.b = colour_of(word & 1023u, srgb);
+                t.g = colour_of((word >> 10u) & 1023u, srgb);
+                t.r = colour_of((word >> 20u) & 1023u, srgb);
+                t.a = form == 2u ? float((aw >> (8u * i)) & 255u) / 255.0 : 1.0;
+            }
+            imageStore(images[p.image], ivec2(x, y), t);
+        }
+        return;
+    }
+    uint aw = 0u;
+    for (uint i = 0u; i < n; i++) {
+        uint x = x0 + i;
+        vec4 t = imageLoad(images[p.image], ivec2(x, y));
+        uint r = colour_code(t.r, srgb);
+        uint g = colour_code(t.g, srgb);
+        uint b = colour_code(t.b, srgb);
+        if (form == 1u) {
+            colour.w[2u * x] = (b << 6u) | (g << 22u);
+            colour.w[2u * x + 1u] = (r << 6u) | (alpha_code(t.a) << 22u);
+        } else {
+            // BGR10_XR's two top bits are written as ones, as Metal writes them.
+            colour.w[x] = b | (g << 10u) | (r << 20u) | 0xC0000000u;
+            aw |= byte_code(t.a) << (8u * i);
+        }
+    }
+    if (form == 2u) {
+        // The bytes of the word past the row's last texel are the row's padding: kept.
+        uint keep = n == 4u ? 0u : (0xFFFFFFFFu << (8u * n));
+        alphas.w[x0 / 4u] = (alphas.w[x0 / 4u] & keep) | aw;
+    }
+}
