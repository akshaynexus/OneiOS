+pub enum XrForm {
+    /// `BGR10_XR`: a 32-bit word a texel.
+    Bgr10,
+    /// `BGRA10_XR`: four 16-bit fields a texel.
+    Bgra10,
+    /// `RGB10A8_2P_XR10`: plane 0 of `BGR10_XR` words, plane 1 of alpha bytes ([`XrPlanes`]).
+    Planes,
+}
+
+/// One of Apple's extended-range pixel formats, as a texture over a buffer holds it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct XrEncoding {
+    /// Its layout.
+    pub form: XrForm,
+    /// The `_sRGB` twin: its colour values are in extended sRGB.
+    pub srgb: bool,
+}
+
+/// Where a two-plane `RGB10A8_2P_XR10` texture's alpha plane lies in its buffer.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+pub struct XrPlanes {
+    /// The alpha plane's first byte, from the buffer's start; a multiple of 4.
+    pub alpha_offset: u64,
+    /// The alpha plane's rows' pitch in bytes; a multiple of 4.
+    pub alpha_bytes_per_row: u64,
+}
+
+impl XrEncoding {
+    /// The extended-range form `pf` is, if it is one this path converts.
+    pub fn of(pf: PixelFormat) -> Option<XrEncoding> {
+        let (form, srgb) = match pf {
+            PixelFormat::BGR10XR => (XrForm::Bgr10, false),
+            PixelFormat::BGR10XRSRGB => (XrForm::Bgr10, true),
+            PixelFormat::BGRA10XR => (XrForm::Bgra10, false),
+            PixelFormat::BGRA10XRSRGB => (XrForm::Bgra10, true),
+            PixelFormat::RGB10A82PXR10 => (XrForm::Planes, false),
+            PixelFormat::RGB10A82PXR10SRGB => (XrForm::Planes, true),
+            _ => return None,
+        };
+        Some(XrEncoding { form, srgb })
+    }
+
+    /// The bytes of a texel of its colour plane (plane 0).
+    pub fn texel_bytes(self) -> u32 {
+        match self.form {
+            XrForm::Bgr10 | XrForm::Planes => 4,
+            XrForm::Bgra10 => 8,
+        }
+    }
+
+    /// The format the texture's image holds its values in.
+    pub fn held(self) -> PixelFormat {
+        PixelFormat::RGBA16Float
+    }
+
+    /// The shader's flags word: bit 0 encode, bits 1-2 the form, bit 3 sRGB.
+    pub(crate) fn flags(self, encode: bool) -> u32 {
+        let form = match self.form {
+            XrForm::Bgr10 => 0,
+            XrForm::Bgra10 => 1,
+            XrForm::Planes => 2,
+        };
+        u32::from(encode) | (form << 1) | (u32::from(self.srgb) << 3)
+    }
+
+    /// The RGBA values of a texel, red first, from its colour-plane bytes (`texel_bytes` of them,
+    /// little-endian) and, for the two-plane form, its alpha byte: as the shader decodes it.
+    pub fn decode_texel(self, bytes: &[u8], alpha_byte: u8) -> [f32; 4] {
+        let word = |at: usize| u32::from_le_bytes([bytes[at], bytes[at + 1], bytes[at + 2], bytes[at + 3]]);
+        let c = |code: u32| decode_colour(code as u16, self.srgb);
+        match self.form {
+            XrForm::Bgra10 => {
+                let (lo, hi) = (word(0), word(4));
+                [
+                    c((hi >> 6) & 1023),
+                    c((lo >> 22) & 1023),
+                    c((lo >> 6) & 1023),
+                    decode_alpha(((hi >> 22) & 1023) as u16),
+                ]
+            }
+            XrForm::Bgr10 | XrForm::Planes => {
+                let w = word(0);
+                let alpha = match self.form {
+                    XrForm::Planes => f32::from(alpha_byte) / 255.0,
+                    _ => 1.0,
+                };
+                [c((w >> 20) & 1023), c((w >> 10) & 1023), c(w & 1023), alpha]
+            }
+        }
+    }
+
+    /// The colour-plane bytes (`texel_bytes` of them, into `out`) and, for the two-plane form, the
+    /// alpha byte of the RGBA values `v`, red first: as the shader encodes them.
+    pub fn encode_texel(self, v: [f32; 4], out: &mut [u8]) -> u8 {
+        let [r, g, b] = [v[0], v[1], v[2]].map(|v| u32::from(encode_colour(v, self.srgb)));
+        match self.form {
+            XrForm::Bgra10 => {
+                let lo = (b << 6) | (g << 22);
+                let hi = (r << 6) | (u32::from(encode_alpha(v[3])) << 22);
+                out[0..4].copy_from_slice(&lo.to_le_bytes());
+                out[4..8].copy_from_slice(&hi.to_le_bytes());
+                0
+            }
+            XrForm::Bgr10 | XrForm::Planes => {
+                let w = b | (g << 10) | (r << 20) | 0xC000_0000;
+                out[0..4].copy_from_slice(&w.to_le_bytes());
+                match self.form {
+                    XrForm::Planes => encode_byte(v[3]),
+                    _ => 0,
+                }
+            }
+        }
+    }
+}
+
+/// The lowest and highest colour values: codes 0 and 1023.
+pub const XR_LOW: f32 = -384.0 / 510.0;
+pub const XR_HIGH: f32 = 639.0 / 510.0;
+
+fn srgb_to_linear(s: f32) -> f32 {
+    let a = s.abs();
+    let l = if a <= 0.04045 { a / 12.92 } else { ((a + 0.055) / 1.055).powf(2.4) };
+    if s < 0.0 { -l } else { l }
+}
+
+fn linear_to_srgb(l: f32) -> f32 {
+    let a = l.abs();
+    let s = if a <= 0.003_130_8 { a * 12.92 } else { 1.055 * a.powf(1.0 / 2.4) - 0.055 };
+    if l < 0.0 { -s } else { s }
+}
+
+/// A colour code's value (the module docs), linear for an `_sRGB` twin.
+pub fn decode_colour(code: u16, srgb: bool) -> f32 {
+    let v = (f32::from(code & 1023) - 384.0) / 510.0;
+    if srgb { srgb_to_linear(v) } else { v }
+}
+
+/// A `BGRA10_XR` alpha code's value: clamped to the codes of `[0, 1]`.
+pub fn decode_alpha(code: u16) -> f32 {
+    (f32::from(code.clamp(384, 894)) - 384.0) / 510.0
+}
+
+/// The colour code of value `v`, linear for an `_sRGB` twin (the module docs).
+pub fn encode_colour(v: f32, srgb: bool) -> u16 {
+    let v = if v.is_nan() { 0.0 } else { v };
+    let v = if srgb { linear_to_srgb(v) } else { v };
+    let v = v.clamp(XR_LOW, XR_HIGH);
+    ((v * 510.0).round_ties_even() as i32 + 384).clamp(0, 1023) as u16
+}
+
+/// The `BGRA10_XR` alpha code of value `v`.
+pub fn encode_alpha(v: f32) -> u16 {
+    let v = if v.is_nan() { 0.0 } else { v.clamp(0.0, 1.0) };
+    ((v * 510.0).round_ties_even() as i32 + 384).clamp(384, 894) as u16
+}
+
+/// The two-plane form's alpha byte of value `v`.
+pub fn encode_byte(v: f32) -> u8 {
+    let v = if v.is_nan() { 0.0 } else { v.clamp(0.0, 1.0) };
+    (v * 255.0).round_ties_even() as u8
+}
+
+/// The `half` bits of `v`, rounded to nearest even, as the image stores a value.
+pub fn half_bits(v: f32) -> u16 {
+    let bits = v.to_bits();
+    let sign = ((bits >> 16) & 0x8000) as u16;
+    let exp = ((bits >> 23) & 0xff) as i32;
+    let mant = bits & 0x7f_ffff;
+    if exp == 0xff {
+        return sign | 0x7c00 | if mant != 0 { 0x200 } else { 0 };
+    }
+    let e = exp - 127 + 15;
+    if e >= 31 {
+        return sign | 0x7c00;
+    }
+    if e <= 0 {
+        // A subnormal half, or zero: the significand with its implicit bit, shifted down.
+        if e < -10 {
+            return sign;
+        }
+        let m = mant | 0x80_0000;
+        let shift = (14 - e) as u32;
+        let half = m >> shift;
+        let rest = m & ((1 << shift) - 1);
+        let mid = 1 << (shift - 1);
+        let up = rest > mid || (rest == mid && half & 1 == 1);
+        return sign | (half + u32::from(up)) as u16;
+    }
+    let half = ((e as u32) << 10) | (mant >> 13);
+    let rest = mant & 0x1fff;
+    let up = rest > 0x1000 || (rest == 0x1000 && half & 1 == 1);
+    sign | (half + u32::from(up)) as u16
+}
+
+/// The value of `half` bits `h`.
+pub fn half_value(h: u16) -> f32 {
+    let sign = if h & 0x8000 != 0 { -1.0 } else { 1.0 };
+    let exp = i32::from((h >> 10) & 0x1f);
+    let mant = f32::from(h & 0x3ff);
+    sign * match exp {
+        0 => mant * (2.0f32).powi(-24),
+        31 if mant == 0.0 => f32::INFINITY,
+        31 => f32::NAN,
+        _ => (1.0 + mant / 1024.0) * (2.0f32).powi(exp - 15),
+    }
+}
+
+/// What a texture over a buffer of an extended-range form converts ([`Buffer::new_xr_texture`](crate::Buffer::new_xr_texture)):
+/// its form and, for the two-plane form, where its alpha plane lies. Its colour plane is the
+/// texture's one byte place.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct XrPlace {
+    pub(crate) encoding: XrEncoding,
+    pub(crate) planes: Option<XrPlanes>,
+}
+
+impl XrPlace {
+    /// The bytes of the buffer the conversion of a `width` x `height` texture with its colour
+    /// plane at `place` reads or writes: `(start, end, bytes)`, `start..end` from the buffer's
+    /// start covering both planes, `bytes` the texels' own.
+    pub(crate) fn span(&self, place: crate::BytesPlace, width: u32, height: u32) -> (u64, u64, u64) {
+        let (w, h) = (u64::from(width), u64::from(height));
+        let row = w * u64::from(self.encoding.texel_bytes());
+        let mut start = place.offset;
+        let mut end = place.offset + (h - 1) * place.bytes_per_row + row;
+        let mut bytes = row * h;
+        if let Some(p) = self.planes {
+            // The alpha plane is written a word at a time (`xr_convert.comp`).
+            let alpha_row = w.next_multiple_of(4);
+            start = start.min(p.alpha_offset);
+            end = end.max(p.alpha_offset + (h - 1) * p.alpha_bytes_per_row + alpha_row);
+            bytes += w * h;
+        }
+        (start, end, bytes)
+    }
+}
+
+/// One conversion between a texture's buffer and its image, recorded in `crate::over::record_side`.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct XrCopy {
+    /// The colour plane's first texel's device address, and its rows' pitch.
+    pub(crate) colour: u64,
+    pub(crate) colour_row: u32,
+    /// The alpha plane's (the two-plane form), 0 for the others.
+    pub(crate) alpha: u64,
+    pub(crate) alpha_row: u32,
+    pub(crate) width: u32,
+    pub(crate) height: u32,
+    /// The texture's storage element, where the shader reads and writes its image.
+    pub(crate) storage: u32,
+    pub(crate) encoding: XrEncoding,
+}
+
+impl XrCopy {
+    /// The 40-byte push constants of `xr_convert.comp`.
+    fn push(&self, encode: bool) -> [u8; 40] {
+        let mut out = [0u8; 40];
+        out[0..8].copy_from_slice(&self.colour.to_ne_bytes());
+        out[8..16].copy_from_slice(&self.alpha.to_ne_bytes());
+        out[16..20].copy_from_slice(&self.colour_row.to_ne_bytes());
+        out[20..24].copy_from_slice(&self.alpha_row.to_ne_bytes());
+        out[24..28].copy_from_slice(&self.width.to_ne_bytes());
+        out[28..32].copy_from_slice(&self.height.to_ne_bytes());
+        out[32..36].copy_from_slice(&self.storage.to_ne_bytes());
+        out[36..40].copy_from_slice(&self.encoding.flags(encode).to_ne_bytes());
+        out
+    }
+}
+
+/// The device's conversion pipeline, made at its first use.
+#[derive(Default)]
+pub(crate) struct XrPipeline {
+    made: Mutex<Option<(vk::ShaderModule, vk::Pipeline)>>,
+}
+
+impl XrPipeline {
+    fn pipeline(&self, core: &Core) -> Result<vk::Pipeline, Error> {
+        let mut made = lock(&self.made);
+        if let Some((_, pipeline)) = *made {
+            return Ok(pipeline);
+        }
+        let info = vk::ShaderModuleCreateInfo::default().code(XR_SPV);
+        // SAFETY: `XR_SPV` is SPIR-V 1.6 that `spirv-val --target-env vulkan1.3` passes, of the
+        // floor's features (buffer device addresses, update-after-bind storage images).
+        let module = unsafe { core.device.create_shader_module(&info, None) }
+            .map_err(|result| Error::Vulkan { call: "vkCreateShaderModule", result })?;
+        let stage = vk::PipelineShaderStageCreateInfo::default()
+            .stage(vk::ShaderStageFlags::COMPUTE)
+            .module(module)
+            .name(c"main");
+        let create = vk::ComputePipelineCreateInfo::default().stage(stage).layout(core.layout);
+        let pipeline = made_through_cache(core, "vkCreateComputePipelines", |cache| {
+            // SAFETY: the module, layout and cache are the device's.
+            unsafe { core.device.create_compute_pipelines(cache, &[create], None) }
+        });
+        match pipeline {
+            Ok(pipeline) => {
+                *made = Some((module, pipeline));
+                Ok(pipeline)
+            }
+            Err(error) => {
+                // SAFETY: no pipeline was made of the module.
+                unsafe { core.device.destroy_shader_module(module, None) };
+                Err(error)
+            }
+        }
+    }
+
+    /// Records the conversion of each of `copies`: Apple's bytes into the image (`encode` false)
+    /// or the image into Apple's bytes. False where none was recorded (no copies, or the pipeline
+    /// could not be made, which a texture's making checked first, [`XrPipeline::ready`]).
+    ///
+    /// # Safety
+    ///
+    /// `command` records outside any render pass; each image is in the general layout, its
+    /// storage element at `copy.storage` of set 1; each address is live until the command
+    /// buffer retires.
+    pub(crate) unsafe fn dispatch(
+        &self,
+        core: &Core,
+        command: vk::CommandBuffer,
+        copies: &[XrCopy],
+        encode: bool,
+    ) -> bool {
+        if copies.is_empty() {
+            return false;
+        }
+        let Ok(pipeline) = self.pipeline(core) else {
+            return false;
+        };
+        let device = &core.device;
+        // SAFETY: the caller's contract; the layout and set 1 are the device's.
+        unsafe {
+            device.cmd_bind_pipeline(command, vk::PipelineBindPoint::COMPUTE, pipeline);
+            device.cmd_bind_descriptor_sets(
+                command,
+                vk::PipelineBindPoint::COMPUTE,
+                core.layout,
+                1,
+                &[core.arrays.set()],
+                &[],
+            );
+            for copy in copies {
+                device.cmd_push_constants(command, core.layout, PUSH_STAGES, 0, &copy.push(encode));
+                let groups = copy.width.div_ceil(4).div_ceil(8);
+                device.cmd_dispatch(command, groups, copy.height.div_ceil(8), 1);
+            }
+        }
+        true
+    }
+
+    /// Makes the pipeline where it is not made yet: a texture's making calls it, so that no
+    /// conversion is dropped later.
+    pub(crate) fn ready(&self, core: &Core) -> Result<(), Error> {
+        self.pipeline(core).map(|_| ())
+    }
+
+    /// Destroys the pipeline and its module where made.
+    ///
+    /// # Safety
+    ///
+    /// The device is idle.
+    pub(crate) unsafe fn destroy(&self, core: &Core) {
+        if let Some((module, pipeline)) = lock(&self.made).take() {
+            // SAFETY: the caller's contract.
+            unsafe {
+                core.device.destroy_pipeline(pipeline, None);
+                core.device.destroy_shader_module(module, None);
+            }
+            core.counters.fall(Gauge::Pipelines);
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// The value a code's decode leaves in the image: through `half`.
+    fn held(v: f32) -> f32 {
+        half_value(half_bits(v))
+    }
+
+    #[test]
+    fn known_codes() {
+        assert_eq!(decode_colour(384, false), 0.0);
+        assert_eq!(decode_colour(894, false), 1.0);
+        assert!((decode_colour(0, false) - -0.752_941).abs() < 1e-6);
+        assert!((decode_colour(1023, false) - 1.252_941).abs() < 1e-6);
+        assert!((decode_colour(1022, false) - 1.250_98).abs() < 1e-5, "Apple's quoted top");
+        assert_eq!(decode_alpha(0), 0.0);
+        assert_eq!(decode_alpha(1023), 1.0);
+        assert_eq!(encode_colour(0.0, false), 384);
+        assert_eq!(encode_colour(1.0, false), 894);
+        assert_eq!(encode_colour(-0.752_941, false), 0);
+        assert_eq!(encode_colour(1.252_941, false), 1023);
+        assert_eq!(encode_colour(5.0, false), 1023);
+        assert_eq!(encode_colour(-5.0, false), 0);
+        assert_eq!(encode_colour(f32::NAN, false), 384);
+        assert_eq!(encode_colour(f32::INFINITY, true), 1023);
+        assert_eq!(encode_alpha(1.5), 894);
+        assert_eq!(encode_alpha(-0.2), 384);
+        assert_eq!(encode_alpha(f32::NAN), 384);
+        assert_eq!(encode_byte(0.5), 128);
+        // sRGB: 0 and 1 are fixed points of the transfer; it is odd.
+        assert_eq!(decode_colour(384, true), 0.0);
+        assert!((decode_colour(894, true) - 1.0).abs() < 1e-6);
+        assert_eq!(decode_colour(0, true), -decode_colour(768, true));
+    }
+
+    #[test]
+    fn every_code_round_trips_through_the_image() {
+        for code in 0..1024u16 {
+            for srgb in [false, true] {
+                let v = held(decode_colour(code, srgb));
+                assert_eq!(encode_colour(v, srgb), code, "colour {code} srgb {srgb}: {v}");
+            }
+            let a = held(decode_alpha(code));
+            assert_eq!(encode_alpha(a), code.clamp(384, 894), "alpha {code}");
+        }
+        for byte in 0..=255u8 {
+            assert_eq!(encode_byte(held(f32::from(byte) / 255.0)), byte, "byte {byte}");
+        }
+    }
+
+    #[test]
+    fn texels_lie_in_apple_bytes() {
+        let e = XrEncoding::of(PixelFormat::BGR10XR).unwrap();
+        let mut out = [0u8; 8];
+        // Red 1.0 (894), green 0.0 (384), blue -0.752941 (0).
+        e.encode_texel([1.0, 0.0, XR_LOW, 0.25], &mut out);
+        assert_eq!(u32::from_le_bytes(out[0..4].try_into().unwrap()), (894 << 20) | (384 << 10) | 0xC000_0000);
+        assert_eq!(e.decode_texel(&out, 0), [1.0, 0.0, decode_colour(0, false), 1.0]);
+        let e = XrEncoding::of(PixelFormat::BGRA10XR).unwrap();
+        e.encode_texel([1.0, 0.0, XR_HIGH, 0.5], &mut out);
+        let fields: Vec<u16> = out.chunks(2).map(|f| u16::from_le_bytes([f[0], f[1]])).collect();
+        assert_eq!(fields, [1023 << 6, 384 << 6, 894 << 6, 639 << 6]);
+        assert_eq!(e.decode_texel(&out, 0), [1.0, 0.0, decode_colour(1023, false), decode_alpha(639)]);
+        let e = XrEncoding::of(PixelFormat::RGB10A82PXR10SRGB).unwrap();
+        assert_eq!(e.encode_texel([0.0, 0.0, 0.0, 1.0], &mut out), 255);
+        assert_eq!(e.decode_texel(&out, 51), [0.0, 0.0, 0.0, 0.2]);
+        assert_eq!(e.texel_bytes(), 4);
+        assert_eq!(XrEncoding::of(PixelFormat::BGRA8Unorm), None);
+    }
+
+    #[test]
+    fn halves_round_to_nearest_even() {
+        assert_eq!(half_bits(1.0), 0x3c00);
+        assert_eq!(half_bits(-2.0), 0xc000);
+        assert_eq!(half_bits(65504.0), 0x7bff);
+        assert_eq!(half_bits(1e6), 0x7c00);
+        assert_eq!(half_bits(2.0f32.powi(-24)), 0x0001);
+        assert_eq!(half_bits(1.0 + 2.0f32.powi(-11)), 0x3c00, "a tie to even");
+        assert_eq!(half_bits(1.0 + 3.0 * 2.0f32.powi(-11)), 0x3c02, "a tie up to even");
+        for h in (0..0x7c00u16).step_by(7) {
+            assert_eq!(half_bits(half_value(h)), h, "{h:#x}");
+        }
+    }
+
+    #[test]
+    fn the_shader_is_spirv() {
+        assert_eq!(XR_SPV[0], 0x0723_0203);
+        assert!(XR_SPV.len() > 100);
+    }
+}
