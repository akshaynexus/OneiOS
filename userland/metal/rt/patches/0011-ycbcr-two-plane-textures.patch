+//! Two-plane YCbCr and RGB IOSurface textures over a buffer: an optimal `R16G16B16A16_SFLOAT`
+//! image whose texels a compute shader converts from the buffer's luma and chroma planes on
+//! submission (`crate::over::record_side`).
+//!
+//! Matches Metal's exact chroma filtering (4:2:0 9/3/3/1, 4:2:2 3/1, 4:4:4 1/1) and Apple Silicon
+//! fixed-point YCbCr-to-RGB / sRGB / raw-code rules (`metal2vulkan::bind::ycbcr_convert`).
+
+use crate::counters::Gauge;
+use crate::device::{lock, Core};
+use crate::error::Error;
+use crate::pipeline::{made_through_cache, PUSH_STAGES};
+use crate::ycbcr_spv::YCBCR_SPV;
+use ash::vk;
+use metal2vulkan::bind::{YCbCrCodes, YCbCrOutput};
+use metal2vulkan::metal::format::ChromaSubsampling;
+use std::sync::Mutex;
+
+/// Where a two-plane YCbCr or RGB texture's luma and chroma planes lie in its buffer, and the
+/// surface's 4CC pixel format OSType (e.g. `'420v'`, `'420f'`, `'x420'`, `'xf20'`, `'p420'`, `'pf20'`).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct YcbcrSpec {
+    /// Luma (plane 0) byte offset from the buffer's start.
+    pub luma_offset: u64,
+    /// Luma (plane 0) bytes per row.
+    pub luma_bytes_per_row: u64,
+    /// Chroma (plane 1) byte offset from the buffer's start.
+    pub chroma_offset: u64,
+    /// Chroma (plane 1) bytes per row.
+    pub chroma_bytes_per_row: u64,
+    /// IOSurface OSType fourcc (big-endian ASCII, e.g. `0x34323076` for `'420v'`).
+    pub fourcc: u32,
+}
+
+/// Parameters for one YCbCr compute conversion recorded inside `over::record_side`.
+#[derive(Clone, Copy)]
+pub(crate) struct YcbcrCopy {
+    pub(crate) luma_addr: u64,
+    pub(crate) chroma_addr: u64,
+    pub(crate) luma_row: u32,
+    pub(crate) chroma_row: u32,
+    pub(crate) width: u32,
+    pub(crate) height: u32,
+    pub(crate) storage_idx: u32,
+    pub(crate) flags: u32,
+}
+
+/// Encodes the 48-byte push constants block matching `ycbcr_convert.comp`.
+fn encode_push(c: &YcbcrCopy) -> [u8; 48] {
+    let mut out = [0u8; 48];
+    out[0..8].copy_from_slice(&(c.luma_addr & !3u64).to_ne_bytes());
+    out[8..16].copy_from_slice(&(c.chroma_addr & !3u64).to_ne_bytes());
+    out[16..20].copy_from_slice(&((c.luma_addr & 3u64) as u32).to_ne_bytes());
+    out[20..24].copy_from_slice(&((c.chroma_addr & 3u64) as u32).to_ne_bytes());
+    out[24..28].copy_from_slice(&c.luma_row.to_ne_bytes());
+    out[28..32].copy_from_slice(&c.chroma_row.to_ne_bytes());
+    out[32..36].copy_from_slice(&c.width.to_ne_bytes());
+    out[36..40].copy_from_slice(&c.height.to_ne_bytes());
+    out[40..44].copy_from_slice(&c.storage_idx.to_ne_bytes());
+    out[44..48].copy_from_slice(&c.flags.to_ne_bytes());
+    out
+}
+
+/// Encodes `codes`, `fourcc`, and dimensions into the compute shader's `flags` word.
+pub(crate) fn encode_flags(codes: YCbCrCodes, fourcc: u32) -> u32 {
+    let sub: u32 = match codes.subsampling {
+        ChromaSubsampling::Chroma420 => 0,
+        ChromaSubsampling::Chroma422 => 1,
+        ChromaSubsampling::Chroma444 => 2,
+        _ => 0,
+    };
+    let is10: u32 = u32::from(codes.bits == 10);
+    let packed: u32 = u32::from(codes.packed);
+    let out_mode: u32 = match codes.output {
+        YCbCrOutput::Converted => 0,
+        YCbCrOutput::Srgb => 1,
+        YCbCrOutput::Codes => 2,
+        _ => 0,
+    };
+    // CoreVideo full-range fourccs: '420f', '422f', '444f', 'xf20', 'xf22', 'xf44', 'pf20', 'pf22', 'pf44'.
+    let full_range: u32 = u32::from(matches!(
+        fourcc,
+        0x3432_3066
+            | 0x3432_3266
+            | 0x3434_3466
+            | 0x7866_3230
+            | 0x7866_3232
+            | 0x7866_3434
+            | 0x7066_3230
+            | 0x7066_3232
+            | 0x7066_3434
+    ));
+    // BT.709 is standard for HD/web video on iOS (H.264/HEVC).
+    let matrix: u32 = 1;
+    sub | (is10 << 2) | (packed << 3) | (out_mode << 4) | (full_range << 6) | (matrix << 7)
+}
+
+/// Lazily created compute pipeline for two-plane YCbCr conversion on a device.
+#[derive(Default)]
+pub(crate) struct YcbcrPipeline {
+    made: Mutex<Option<(vk::ShaderModule, vk::Pipeline)>>,
+}
+
+impl YcbcrPipeline {
+    /// Returns (creating on first use) the YCbCr conversion compute pipeline on `core`.
+    pub(crate) fn pipeline(&self, core: &Core) -> Result<vk::Pipeline, Error> {
+        let mut guard = lock(&self.made);
+        if let Some((_, pipeline)) = *guard {
+            return Ok(pipeline);
+        }
+        let info = vk::ShaderModuleCreateInfo::default().code(YCBCR_SPV);
+        // SAFETY: `YCBCR_SPV` is validated SPIR-V 1.6 (Vulkan 1.3) using only floor features.
+        let module = unsafe { core.device.create_shader_module(&info, None) }.map_err(|result| {
+            Error::Vulkan {
+                call: "vkCreateShaderModule",
+                result,
+            }
+        })?;
+        let stage = vk::PipelineShaderStageCreateInfo::default()
+            .stage(vk::ShaderStageFlags::COMPUTE)
+            .module(module)
+            .name(c"main");
+        let ci = vk::ComputePipelineCreateInfo::default()
+            .stage(stage)
+            .layout(core.layout);
+        let pipeline = made_through_cache(core, "vkCreateComputePipelines", |cache| {
+            // SAFETY: module, layout, and cache belong to `core.device`.
+            unsafe { core.device.create_compute_pipelines(cache, &[ci], None) }
+        });
+        match pipeline {
+            Ok(pipeline) => {
+                *guard = Some((module, pipeline));
+                Ok(pipeline)
+            }
+            Err(error) => {
+                // SAFETY: no pipeline was created from `module`.
+                unsafe { core.device.destroy_shader_module(module, None) };
+                Err(error)
+            }
+        }
+    }
+
+    /// Dispatches YCbCr compute conversions for every `YcbcrCopy` in `copies`.
+    ///
+    /// # Safety
+    /// `command` is recording outside any render pass, every destination image is in
+    /// `VK_IMAGE_LAYOUT_GENERAL` and bound at `copy.storage_idx` in Set 1 binding 1, and every
+    /// source buffer address is valid for the command buffer's lifetime.
+    pub(crate) unsafe fn dispatch(
+        &self,
+        core: &Core,
+        command: vk::CommandBuffer,
+        copies: &[YcbcrCopy],
+    ) -> bool {
+        if copies.is_empty() {
+            return false;
+        }
+        let Ok(pipeline) = self.pipeline(core) else {
+            return false;
+        };
+        let device = &core.device;
+        // SAFETY: caller's contract; `core.layout` and Set 1 belong to `core.device`.
+        unsafe {
+            device.cmd_bind_pipeline(command, vk::PipelineBindPoint::COMPUTE, pipeline);
+            device.cmd_bind_descriptor_sets(
+                command,
+                vk::PipelineBindPoint::COMPUTE,
+                core.layout,
+                1,
+                &[core.arrays.set()],
+                &[],
+            );
+            for c in copies {
+                let bytes = encode_push(c);
+                device.cmd_push_constants(command, core.layout, PUSH_STAGES, 0, &bytes);
+                device.cmd_dispatch(command, c.width.div_ceil(8), c.height.div_ceil(8), 1);
+            }
+        }
+        true
+    }
+
+    /// Destroys the pipeline and shader module if created.
+    ///
+    /// # Safety
+    /// Device is idle and no command buffer referencing the pipeline is pending.
+    pub(crate) unsafe fn destroy(&self, core: &Core) {
+        if let Some((module, pipeline)) = lock(&self.made).take() {
+            // SAFETY: caller's contract.
+            unsafe {
+                core.device.destroy_pipeline(pipeline, None);
+                core.device.destroy_shader_module(module, None);
+            }
+            core.counters.fall(Gauge::Pipelines);
+        }
+    }
+}
