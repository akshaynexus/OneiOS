 use std::ffi::OsString;
 
@@ -60,6 +61,16 @@ pub const REGISTRY: &[EnvVar] = &[
                  its memory class (placed), bytes, offset and block, to show what makes and \
                  frees blocks; set to anything but empty or 0",
     },
+    EnvVar {
+        name: "METAL2VULKAN_SHADER_FIX",
+        default: "unset (off: the translations of the pin)",
+        effect:
+            "OneiOS: the Adreno shader fixes of patches 0101 and 0102 (a constant table indexed at \
+                 run time and past 4 KiB read from the constant blob, not copied per thread; \
+                 pointer constants that are casts or constant GEPs of a blob global lowered); \
+                 changes what the library compiles, so the device profile's fingerprint takes it; \
+                 read once per process; set to 1",
+    },
 ];
 
 /// Multi-line `--help` block listing every registry var.
@@ -113,3 +124,15 @@ pub fn tool_path_override(cmd: &str) -> Option<OsString> {
         cmd.replace('-', "_").to_ascii_uppercase()
     ))
 }
+
+/// OneiOS: whether the Adreno shader fixes of patches 0101 and 0102 translate (`REGISTRY`):
+/// `METAL2VULKAN_SHADER_FIX` is `1`. Read once per process, so every translation and the device
+/// profile's fingerprint (`device::profile`) agree; the Metal plug-in clears it with the boot
+/// argument `oneios-m2v-shader-fix=0` before its first device, else sets it (userland/metal/ShaderFix.inc).
+/// Off, the library compiles what the pin compiles, and the fingerprint is the pin's.
+pub fn shader_fix() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        std::env::var_os("METAL2VULKAN_SHADER_FIX").is_some_and(|value| value == "1")
+    })
+}
